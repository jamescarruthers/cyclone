 $9031 DEFB $00,$00,$00                     ; Unused

; Map positions, cyclone movement and wind-force/danger gauges
;
; Called every main-loop iteration in the normal view (5B89) and on calls 1-3
; and 7 of the map blink cycle. (1) Converts the helicopter's world position to
; a map cell. (2) Every 25 calls moves the cyclone one map cell in a random
; direction chosen from the current 'regime', picking a new regime every 9
; moves or when the cyclone hits the map edge. (3) Sets 7550 = Chebyshev
; distance helicopter-cyclone (max 15) and draws the WIND FORCE bar and DANGER
; warning.
;
; I:(7500) helicopter X (16-bit world units), (7502) helicopter Y (Y grows
; .        southwards)
; O:(7540) map column = X/32 clamped to 0..22; (7541) map row = Y/32 clamped to
; .        0..21
; O:(754D) number of axes on which the helicopter is off the map (0-2)
; O:(754B),(754C) cyclone map column 1..21 / row 1..20
; O:(7550) distance to cyclone 0..15
;
; Off-map test: if X/32 >= 256 (only possible for 'negative' X >= $2000) the
; column is 0; if 23 <= X/32 < 256 it is 22; rows likewise use 21. (The checks
; of H against $80 at 9054/9087 can never succeed, as H <= 7 after the shifts;
; dead code.)
; .
; Cyclone timing (OBSERVED, helicopter idling at base: 5.16 frames per
; main-loop iteration): one step every 25 iterations = about 129 frames (2.6
; s); a regime lasts 9 steps (about 23 s) unless cut short at an edge.
c$9034 XOR A         ; {754D = 0
 $9035 LD ($754D),A  ; }
 $9038 LD HL,($7500) ; {HL = X >> 5
 $903B SRL H         ;
 $903D RR L          ;
 $903F SRL H         ;
 $9041 RR L          ;
 $9043 SRL H         ;
 $9045 RR L          ;
 $9047 SRL H         ;
 $9049 RR L          ;
 $904B SRL H         ;
 $904D RR L          ; }
 $904F LD A,H        ; {X/32 < 256?
 $9050 CP $00        ;
 $9052 JR Z,$9063    ;
 $9054 CP $80        ;
 $9056 JR NC,$905B   ;
 $9058 XOR A         ;
 $9059 JR $905D      ;
*$905B LD A,$16      ;
*$905D LD HL,$754D   ;
 $9060 INC (HL)      ;
 $9061 JR $9068      ; }
*$9063 LD A,L        ; {X/32 >= 23: column 22 and flag off-map
 $9064 CP $17        ;
 $9066 JR NC,$905B   ; }
*$9068 LD ($7540),A  ; 7540 = column
 $906B LD HL,($7502) ; {HL = Y >> 5
 $906E SRL H         ;
 $9070 RR L          ;
 $9072 SRL H         ;
 $9074 RR L          ;
 $9076 SRL H         ;
 $9078 RR L          ;
 $907A SRL H         ;
 $907C RR L          ;
 $907E SRL H         ;
 $9080 RR L          ;
 $9082 LD A,H        ;
 $9083 CP $00        ;
 $9085 JR Z,$9096    ;
 $9087 CP $80        ;
 $9089 JR NC,$9090   ;
 $908B XOR A         ;
 $908C JR $9090      ;
*$908E LD A,$15      ;
*$9090 LD HL,$754D   ;
 $9093 INC (HL)      ;
 $9094 JR $909B      ; }
*$9096 LD A,L        ; {Y/32 >= 22: row 21 and flag off-map
 $9097 CP $16        ;
 $9099 JR NC,$908E   ; }
*$909B LD ($7541),A  ; 7541 = row
 $909E LD HL,$754E   ; {754E counts calls 0..24; the cyclone moves when it
 $90A1 INC (HL)      ; reaches 25
 $90A2 LD A,$18      ;
 $90A4 CP (HL)       ;
 $90A5 JR NC,$9111   ; }
 $90A7 LD (HL),$00   ; {754F counts moves 0..8
 $90A9 LD HL,$754F   ;
 $90AC INC (HL)      ;
 $90AD LD A,$08      ;
 $90AF CP (HL)       ;
 $90B0 JR NC,$90CB   ; }
 $90B2 LD (HL),$00   ; {9th move: new regime = random entry of 9178 (L AND 15),
 $90B4 CALL $8B74    ; stored into the AND/OR operands at 90D0/90D2
 $90B7 LD A,L        ;
 $90B8 AND $0F       ;
 $90BA LD HL,$9178   ;
 $90BD LD D,$00      ;
 $90BF ADD A,A       ;
 $90C0 LD E,A        ;
 $90C1 ADD HL,DE     ;
 $90C2 LD A,(HL)     ;
 $90C3 LD ($90D0),A  ;
 $90C6 INC HL        ;
 $90C7 LD A,(HL)     ;
 $90C8 LD ($90D2),A  ; }
*$90CB CALL $8B74    ; {Direction index = (H of a new random number AND mask)
 $90CE LD A,H        ; OR bits (operands at 90D0, 90D2): an even offset into
 $90CF AND $0E       ; 9198
 $90D1 OR $06        ;
 $90D3 LD HL,$9198   ;
 $90D6 ADD A,L       ;
 $90D7 LD L,A        ; }
 $90D8 LD A,($754B)  ; {New column must be 1..21...
 $90DB LD B,(HL)     ;
 $90DC ADD A,B       ;
 $90DD CP $01        ;
 $90DF JR C,$90EA    ;
 $90E1 CP $16        ;
 $90E3 JR NC,$90EA   ;
 $90E5 LD ($754B),A  ;
 $90E8 JR $90F4      ; }
*$90EA LD A,$08      ; {...else stay and force a new regime next call (754F=8,
 $90EC LD ($754F),A  ; 754E=24)
 $90EF LD A,$18      ;
 $90F1 LD ($754E),A  ; }
*$90F4 INC HL        ; {New row must be 1..20, else likewise force a new regime
 $90F5 LD A,($754C)  ;
 $90F8 LD B,(HL)     ;
 $90F9 ADD A,B       ;
 $90FA CP $01        ;
 $90FC JR C,$9107    ;
 $90FE CP $15        ;
 $9100 JR NC,$9107   ;
 $9102 LD ($754C),A  ;
 $9105 JR $9111      ;
*$9107 LD A,$08      ;
 $9109 LD ($754F),A  ;
 $910C LD A,$18      ;
 $910E LD ($754E),A  ; }
*$9111 LD A,($7540)  ; {C = |cyclone column - helicopter column|
 $9114 LD B,A        ;
 $9115 LD A,($754B)  ;
 $9118 SUB B         ;
 $9119 CP $80        ;
 $911B JR C,$911F    ;
 $911D NEG           ;
*$911F LD C,A        ; }
 $9120 LD A,($7541)  ; {A = |cyclone row - helicopter row|
 $9123 LD B,A        ;
 $9124 LD A,($754C)  ;
 $9127 SUB B         ;
 $9128 CP $80        ;
 $912A JR C,$912E    ;
 $912C NEG           ; }
*$912E CP C          ; {7550 = min(15, max of the two)
 $912F JR NC,$9132   ;
 $9131 LD A,C        ;
*$9132 CP $10        ;
 $9134 JR C,$9138    ;
 $9136 LD A,$0F      ;
*$9138 LD ($7550),A  ; }
 $913B LD E,A        ; {WIND FORCE bar at row 23, columns 16-31: (16-distance)
 $913C LD A,$10      ; cells of $52 (red) then distance cells of $7F (white);
 $913E SUB E         ; one fewer red cell if the helicopter is off the map
 $913F LD B,A        ;
 $9140 LD A,($754D)  ;
 $9143 CP $00        ;
 $9145 JR Z,$9149    ;
 $9147 DEC B         ;
 $9148 INC E         ; }
*$9149 LD HL,$5AF0   ; {Note the bar is drawn at 5AF0 = row 23 column 16
 $914C INC B         ;
 $914D JR $9152      ;
*$914F LD (HL),$52   ;
 $9151 INC L         ;
*$9152 DJNZ $914F    ;
 $9154 LD B,E        ;
 $9155 INC B         ;
 $9156 JR $915B      ;
*$9158 LD (HL),$7F   ;
 $915A INC L         ;
*$915B DJNZ $9158    ; }
 $915D NOP           ; {DANGER label (row 22, columns 26-31): $FA (flashing red
 $915E LD A,($7550)  ; on white) if distance < 6, else $38 (black on white)
 $9161 CP $06        ;
 $9163 JR C,$9169    ;
 $9165 LD A,$38      ;
 $9167 JR $916B      ;
*$9169 LD A,$FA      ; }
*$916B LD B,(HL)     ; {Already that colour? Then return without rewriting
 $916C CP B          ;
 $916D RET Z         ;
 $916E LD B,$06      ;
 $9170 LD HL,$5ADA   ;
*$9173 LD (HL),A     ;
 $9174 INC HL        ;
 $9175 DJNZ $9173    ;
 $9177 RET           ; }

; Cyclone direction regimes
;
; 16 (mask, bits) pairs, one chosen at random (L AND 15) every 9 cyclone moves;
; each step's direction offset is (random H AND mask) OR bits, indexing the
; (dx,dy) pairs at 9198, so each regime allows 2 or 4 equally likely
; directions: 0 W/NW; 1 SW/S; 2 NE/E; 3 SE/E; 4 W/SW; 5 W/NW/N/NE; 6 W/NW/SW/S;
; 7 N/NE/SE/E; 8 SW/S/SE/E; 9 N/NE; 10 W/NW; 11 SW/S; 12 SE/E; 13 W/NW/N/NE; 14
; SW/S/SE/E; 15 N/NE. The current regime lives in the operands at 90D0/90D2
; (never reset; $0E/$06 = NE/E in the loaded image).
b$9178 DEFB $02,$00
 $917A DEFB $0A,$08
 $917C DEFB $0E,$06
 $917E DEFB $0E,$0C
 $9180 DEFB $08,$00
 $9182 DEFB $06,$00
 $9184 DEFB $0A,$00
 $9186 DEFB $0E,$04
 $9188 DEFB $0E,$08
 $918A DEFB $06,$04
 $918C DEFB $02,$00
 $918E DEFB $0A,$08
 $9190 DEFB $0E,$0C
 $9192 DEFB $06,$00
 $9194 DEFB $0E,$08
 $9196 DEFB $06,$04

; Cyclone step directions
;
; (dx,dy) map-cell steps at even offsets 0-14: 0 W(-1,0), 2 NW(-1,-1), 4
; N(0,-1), 6 NE(+1,-1), 8 SW(-1,+1), 10 S(0,+1), 12 SE(+1,+1), 14 E(+1,0). The
; bytes from 91A8 are never indexed.
b$9198 DEFB $FF,$00
 $919A DEFB $FF,$FF
 $919C DEFB $00,$FF
 $919E DEFB $01,$FF
 $91A0 DEFB $FF,$01
 $91A2 DEFB $00,$01
 $91A4 DEFB $01,$01
 $91A6 DEFB $01,$00
 $91A8 DEFB $00,$FF,$01,$00,$01,$01,$01,$01,$00,$00,$00,$00 ; Unused

; HUD: compass, speed bar, aircraft warning
;
; Called every main-loop iteration (5B42) and by the info screen (E3E4).
; Redraws the compass direction dot, the S (speed) bar and the BEWARE AIRCRAFT
; warning colours.
;
; I:(7527) speed 0..6
; I:(7506) heading (used while hovering), (753B) direction of travel (used
; .        while moving); both 0,2,..14
; I:(7530) aircraft warning state (3 = flash)
c$91B4 LD HL,$591C   ; {Clear the 8 compass ring cells around the centre at
 $91B7 XOR A         ; 593D (row 9, column 29) to attribute 0
 $91B8 LD (HL),A     ;
 $91B9 INC HL        ;
 $91BA LD (HL),A     ;
 $91BB INC HL        ;
 $91BC LD (HL),A     ;
 $91BD LD HL,$595C   ;
 $91C0 LD (HL),A     ;
 $91C1 INC HL        ;
 $91C2 LD (HL),A     ;
 $91C3 INC HL        ;
 $91C4 LD (HL),A     ;
 $91C5 LD HL,$593C   ;
 $91C8 LD (HL),A     ;
 $91C9 INC HL        ;
 $91CA INC HL        ;
 $91CB LD (HL),A     ;
 $91CC DEC HL        ;
 $91CD EX DE,HL      ; }
 $91CE LD A,($7527)  ; {Direction = heading 7506 if hovering, else travel
 $91D1 CP $00        ; direction 753B
 $91D3 JR NZ,$91DA   ;
 $91D5 LD A,($7506)  ;
 $91D8 JR $91DD      ;
*$91DA LD A,($753B)  ;
*$91DD LD C,A        ;
 $91DE LD B,$00      ; }
 $91E0 LD HL,$9232   ; {Offset of the ring cell for this direction from the
 $91E3 ADD HL,BC     ; table at 9232
 $91E4 LD C,(HL)     ;
 $91E5 INC HL        ;
 $91E6 LD B,(HL)     ;
 $91E7 EX DE,HL      ;
 $91E8 ADD HL,BC     ; }
 $91E9 LD (HL),$47   ; Light it: $47 (bright white on black)
 $91EB LD HL,$58BA   ; {Speed bar: column 26 from row 5 upwards, 5 cells:
 $91EE LD A,($7527)  ; min(speed,5) cells of $52 (red) then the rest $7F
 $91F1 INC A         ; (white)
 $91F2 CP $07        ;
 $91F4 JR C,$91F8    ;
 $91F6 LD A,$06      ;
*$91F8 LD B,A        ;
 $91F9 LD A,$06      ;
 $91FB SUB B         ;
 $91FC LD DE,$FFE0   ;
 $91FF JR $9204      ;
*$9201 LD (HL),$52   ;
 $9203 ADD HL,DE     ;
*$9204 DJNZ $9201    ;
 $9206 LD B,A        ;
 $9207 INC B         ;
 $9208 JR $920D      ;
*$920A LD (HL),$7F   ;
 $920C ADD HL,DE     ;
*$920D DJNZ $920A    ; }
 $920F LD HL,$5A18   ; {BEWARE AIRCRAFT panel (rows 16-17, columns 24-31): $FA
 $9212 LD A,($7530)  ; (flashing) if 7530 = 3, else $3F
 $9215 CP $03        ;
 $9217 JR Z,$921D    ;
 $9219 LD A,$3F      ;
 $921B JR $921F      ;
*$921D LD A,$FA      ; }
*$921F LD B,(HL)     ; {Already that colour? Return
 $9220 CP B          ;
 $9221 RET Z         ;
 $9222 LD B,$08      ;
*$9224 LD (HL),A     ;
 $9225 INC HL        ;
 $9226 DJNZ $9224    ;
 $9228 LD HL,$5A38   ;
 $922B LD B,$08      ;
*$922D LD (HL),A     ;
 $922E INC HL        ;
 $922F DJNZ $922D    ;
 $9231 RET           ; }

; Compass ring offsets and death-sequence variables
;
; Attribute offsets from the compass centre (593D) for directions
; 0=N,2=NE,4=E,6=SE,8=S,10=SW,12=W,14=NW.
b$9232 DEFW $FFE0
 $9234 DEFW $FFE1
 $9236 DEFW $0001
 $9238 DEFW $0021
 $923A DEFW $0020
 $923C DEFW $001F
 $923E DEFW $FFFF
 $9240 DEFW $FFDF
 $9242 DEFB $00      ; Unused
 $9243 DEFW $0000    ; Death sequence: pointer to the next 72-byte explosion
                     ; overlay (F550, F598, ...)
 $9245 DEFB $00      ; Lives lost this round (0-3; reset to 0 by 8321 at the
                     ; start of each round)

; Death sequence (helicopter destroyed)
;
; Entered from the main loop when 7505=1. Plays a 24-step explosion animation
; in the view, marks a life as lost (helicopter icon turned red), and either
; returns to the menu (3 lives lost) or resets the per-life variables and
; resumes the main loop at 5B36. OBSERVED: the 24 steps take about 132 frames
; (2.6 s).
;
; .
;
; Per step (counter n = 24 down to 1): 76D2 rebuild view buffer, 8B91 waves;
; 6950 = 72 zero bytes (copied from 9300); n >= 22: 8CA0 rebuilds the normal
; helicopter sprite; n = 18: 752D+1 (explosion sound request for the interrupt
; handler); n >= 20: XOR the next explosion overlay (F550+72*k, k=0..4) onto
; 6950; then 7E10 (tile stacks), 86AF (draw sprite), 762C (render view). So the
; explosion overlays are shown over the helicopter for steps 24-22, alone for
; steps 21-20, and the sprite is blank from step 19.
; .
; Life lost: attributes (row 10+2*k, columns 24-25), k = lives lost so far, are
; set to $02 (red ink); lives lost +1; 3 = game over (JP E280). Otherwise 82A7
; (fuel-gauge tick) is called until 7516=1 (fuel gauge emptied), then every
; byte of the reset table 75C8-762B that is not $FF is copied over 7500-7563
; (position $0139,$0170 on the base pad, landed, altitude 8, speed 0 ...; $FF
; entries such as the time bar pointer 751C/751D, 7543-754C markers/cyclone,
; 754E/754F, 7554 crates are kept) and play resumes at 5B36.
c$9246 CALL $762C    ; Render the view once
 $9249 LD HL,$F550   ; {First explosion overlay at F550
 $924C LD ($9243),HL ; }
 $924F LD HL,$750D   ; {Altitude +2 for the animation
 $9252 INC (HL)      ;
 $9253 INC (HL)      ; }
 $9254 LD B,$18      ; {24 steps
*$9256 PUSH BC       ;
 $9257 CALL $76D2    ;
 $925A CALL $8B91    ; }
 $925D LD DE,$6950   ; {Blank sprite: copy 72 zero bytes from 9300 to 6950
 $9260 LD HL,$9300   ;
 $9263 LD BC,$0048   ;
 $9266 LDIR          ; }
 $9268 POP AF        ; {Steps 24-22: normal helicopter sprite
 $9269 PUSH AF       ;
 $926A CP $16        ;
 $926C CALL NC,$8CA0 ;
 $926F POP AF        ;
 $9270 PUSH AF       ; }
 $9271 CP $12        ; {Step 18: explosion sound
 $9273 JR NZ,$9279   ;
 $9275 LD HL,$752D   ;
 $9278 INC (HL)      ; }
*$9279 CP $14        ; {Steps 24-20: XOR an explosion overlay
 $927B CALL NC,$92ED ;
 $927E CALL $7E10    ;
 $9281 CALL $86AF    ;
 $9284 CALL $762C    ;
 $9287 POP BC        ;
 $9288 DJNZ $9256    ; }
*$928A LD A,($9245)  ; {Turn the next helicopter (life) icon red: 5958 +
 $928D ADD A,A       ; 64*lives lost
 $928E ADD A,A       ;
 $928F ADD A,A       ;
 $9290 ADD A,A       ;
 $9291 ADD A,A       ;
 $9292 ADD A,A       ;
 $9293 LD HL,$5958   ;
 $9296 ADD A,L       ;
 $9297 LD L,A        ;
 $9298 LD (HL),$02   ;
 $929A INC HL        ;
 $929B LD (HL),$02   ; }
 $929D LD A,($9245)  ; {Lives lost +1; 3 = game over, back to the menu
 $92A0 INC A         ;
 $92A1 LD ($9245),A  ;
 $92A4 CP $03        ;
 $92A6 JP Z,$E280    ; }
*$92A9 CALL $82A7    ; {Empty the fuel gauge
 $92AC LD A,($7516)  ;
 $92AF CP $01        ;
 $92B1 JR NZ,$92A9   ; }
 $92B3 LD HL,$7500   ; {Copy the reset table 75C8 to 7500 (100 bytes), skipping
 $92B6 LD DE,$75C8   ; $FF bytes
 $92B9 LD B,$64      ;
*$92BB LD A,(DE)     ;
 $92BC CP $FF        ;
 $92BE JR Z,$92C1    ;
 $92C0 LD (HL),A     ;
*$92C1 INC HL        ;
 $92C2 INC DE        ;
 $92C3 DJNZ $92BB    ; }
 $92C5 JP $5B36      ; Resume the main loop
; This entry point is used by the routine at #R$5B00.
*$92C8 LD A,$02      ; {Time ran out (from 5BD1, 751C=$DE): set 2 lives lost so
 $92CA LD ($9245),A  ; that the next one ends the game, message " NO TIME "
 $92CD LD HL,$8A6E   ; }
; This entry point is used by the routine at #R$5B00.
*$92D0 LD DE,$4067   ; {Entry from 5BEF with HL=5BF2 (" NO FUEL ", landed off
 $92D3 LD C,$09      ; the helipad with an empty tank: costs one life). Print
 $92D5 CALL $859A    ; the 9-character message at row 3, column 7, attributes
 $92D8 LD HL,$5867   ; $47
 $92DB LD B,$09      ;
*$92DD LD (HL),$47   ;
 $92DF INC HL        ;
 $92E0 DJNZ $92DD    ; }
 $92E2 LD HL,$0466   ; {Beep: ROM BEEPER, DE=$0300 cycles, HL=$0466 pitch
 $92E5 LD DE,$0300   ;
 $92E8 CALL $03B5    ; }
 $92EB JR $928A      ; Join the life-lost code

; XOR the next explosion overlay onto the sprite
;
; XORs 72 bytes from (9243) onto the sprite buffer 6950 and advances 9243 by
; 72.
;
; I:(9243) overlay pointer
c$92ED LD HL,($9243) ;
 $92F0 LD DE,$6950   ;
 $92F3 LD B,$48      ;
*$92F5 LD A,(DE)     ;
 $92F6 XOR (HL)      ;
 $92F7 LD (DE),A     ;
 $92F8 INC HL        ;
 $92F9 INC DE        ;
 $92FA DJNZ $92F5    ;
 $92FC LD ($9243),HL ;
 $92FF RET           ;

; Island tile store
;
; The terrain of all 14 islands, one byte (tile ID) per map cell, stored as 150
; rows of 128 bytes (stride 128). Each island is a rectangular block somewhere
; in this store, located by the island table at #R$F230 (record bytes 10-11 =
; address of the block's top-left cell, block width = rec[3]-rec[6]+1, height =
; rec[5]-rec[8]+1); blocks are packed side by side and may share sea rows. The
; window builder #R$76D2 copies a 23x29 part of the active island into the
; window buffer F74E (row stride 128 -> 23), the renderer #R$7E10 turns every
; tile into a column of character codes via the tables at 6300+level*256+tile,
; and #R$762C draws it.
; .
; Tile IDs: 00 sea; 01-03 wave sparkles (only placed at run time by #R$8B91);
; 04-0E sea-level beach/rocks; 10-2C height 1; 30-54 height 2; 58-88 height 3;
; 8C-A4 height 4; B2-C1 height 5; D0-D8 height 6; E4-EB height 7 (class = count
; of #R$7AC2 entries <= tile, height = class/2). Odd classes are objects on
; that height: crates 0F/2F/57/8B (placed by #R$5EEC), survivors
; 2D-2E/55-56/89-8A (placed by #R$6072), houses and trees (A5-B1, C2-CF, D9-E3,
; EC-EF), aircraft F6-FE (written into the window only). See re/notes/data.md
; and re/assets/terrain/tiles.json.
; .
; Row 0 (9300-937F) is all zeros; #R$9246 also uses its first 72 bytes as a
; blank sprite to clear the helicopter buffer 6950.
;
; .
;
; Island blocks (index: name, block address, width x height, world position of
; the block's top-left cell):
; .
; 0: BANANA ISLAND at #R$9300 (store row 0, col 0), 55x29, world (626,412) =
; sector (2,1) local (114,156).
; .
; 1: ORTE ROCKS at #R$9D00 (store row 20, col 0), 54x30, world (414,540) =
; sector (1,2) local (158,28).
; .
; 2: KOKOLA ISLAND at #R$A900 (store row 44, col 0), 53x29, world (365,176) =
; sector (1,0) local (109,176).
; .
; 3: LAGOON ISLAND at #R$B600 (store row 70, col 0), 66x29, world (138,212) =
; sector (0,0) local (138,212).
; .
; 4: PEAK ISLAND at #R$C300 (store row 96, col 0), 40x29, world (574,116) =
; sector (2,0) local (62,116).
; .
; 5: BASE ISLAND at #R$CF80 (store row 121, col 0), 81x29, world (306,364) =
; sector (1,1) local (50,108).
; .
; 6: GILLIGANS ISLAND at $9354 (store row 0, col 84), 45x30, world (306,116) =
; sector (1,0) local (50,116).
; .
; 7: RED ISLAND at #R$9FD8 (store row 25, col 88), 41x29, world (398,604) =
; sector (1,2) local (142,92).
; .
; 8: SKEG ISLAND at #R$ADD8 (store row 53, col 88), 40x29, world (134,540) =
; sector (0,2) local (134,28).
; .
; 9: BONE ISLAND at $B843 (store row 74, col 67), 62x29, world (450,152) =
; sector (1,0) local (194,152).
; .
; 10: GIANTS GATEWAY at $9337 (store row 0, col 55), 30x41, world (430,296) =
; sector (1,1) local (174,40).
; .
; 11: CLAW ISLAND at $A735 (store row 40, col 53), 36x35, world (474,476) =
; sector (1,1) local (218,220).
; .
; 12: LUKELAND ISLES at #R$C628 (store row 102, col 40), 40x33, world (70,588)
; = sector (0,2) local (70,76).
; .
; 13: ENTERPRISE ISLAND at $C64F (store row 102, col 79), 50x48, world (90,460)
