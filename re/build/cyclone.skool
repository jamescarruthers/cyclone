 $7F8F EX DE,HL      ;
 $7F90 DEC A         ;
 $7F91 JR NZ,$7F85   ;
 $7F93 POP HL        ;
 $7F94 POP BC        ; }
 $7F95 JP $7E3D      ; Continue with row 16

; Sprite tile codes
;
; Codes written into buffer columns 10-12, rows 5-15 (3 per row). Tile
; $5F+r+11*c is column 10+c, row 5+r, so each column's graphics form a
; contiguous 88-line strip ($FCF8, $FD50, $FDA8) into which the shadow
; (#R$7BB8) and the helicopter body (86AF) are drawn at pixel precision.
b$7F98 DEFB $5F,$6A,$75
 $7F9B DEFB $60,$6B,$76
 $7F9E DEFB $61,$6C,$77
 $7FA1 DEFB $62,$6D,$78
 $7FA4 DEFB $63,$6E,$79
 $7FA7 DEFB $64,$6F,$7A
 $7FAA DEFB $65,$70,$7B
 $7FAD DEFB $66,$71,$7C
 $7FB0 DEFB $67,$72,$7D
 $7FB3 DEFB $68,$73,$7E
 $7FB6 DEFB $69,$74,$7F
 $7FB9 DEFB $FF                             ; End marker (not used)
 $7FBA DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Unused
 $7FC2 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $7FCA DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $7FD2 DEFB $00,$00,$00                     ; }

; Control method
;
; Set by the menu (E2BA: key - '2'): 0 = keyboard, 1 = Interface 2 (port $EFFE,
; keys 6-0), 2 = Kempston (port $1F), 3 = Protek/AGF (cursor keys 5-8 and 0).
; Read by 7FD6 to choose the input routine and by E299.
b$7FD5 DEFB $00

; Read the selected control device into the input bitmap 7522
;
; Called once per main-loop iteration (5B8C). Reads the device chosen on the
; main menu (7FD5 = menu key - "2": 0 keyboard, 1 Sinclair Interface 2, 2
; Kempston, 3 Protek/AGF cursor) and stores a 5-bit control word in 7522: bit 0
; = forward thrust, bit 1 = descend, bit 2 = climb, bit 3 = turn right
; (clockwise), bit 4 = turn left. The cyclone code at 7378 may later OR random
; bits into 7522 (wind buffeting).
;
; I:(7FD5) control method 0-3
; O:(7522) control bits (0 fwd, 1 down, 2 up, 3 right, 4 left)
;
; Keyboard (7FD5=0). Any key in a half-row counts, so the documented keys X / 1
; / Q are really whole half-rows.
c$7FD6 LD A,($7FD5)  ; {Dispatch on the control method
 $7FD9 CP $01        ;
 $7FDB JP Z,$8023    ;
 $7FDE CP $02        ;
 $7FE0 JP Z,$8052    ;
 $7FE3 CP $03        ;
 $7FE5 JP Z,$8079    ; }
 $7FE8 LD B,$00      ; B accumulates the control bits
 $7FEA LD A,$FE      ; {Half-row SHIFT/Z/X/C/V: any key = forward (bit 0)
 $7FEC IN A,($FE)    ;
 $7FEE OR $E0        ;
 $7FF0 CP $FF        ;
 $7FF2 JR Z,$7FF6    ;
 $7FF4 SET 0,B       ; }
*$7FF6 LD A,$F7      ; {Half-row 1-5: any key = climb (bit 2)
 $7FF8 IN A,($FE)    ;
 $7FFA OR $E0        ;
 $7FFC CP $FF        ;
 $7FFE JR Z,$8002    ;
 $8000 SET 2,B       ; }
*$8002 LD A,$FB      ; {Half-row Q-T: any key = descend (bit 1)
 $8004 IN A,($FE)    ;
 $8006 OR $E0        ;
 $8008 CP $FF        ;
 $800A JR Z,$800E    ;
 $800C SET 1,B       ; }
*$800E LD A,$DF      ; {Half-row P/O/I/U/Y: P = turn right (bit 3), O = turn
 $8010 IN A,($FE)    ; left (bit 4)
 $8012 BIT 0,A       ;
 $8014 JR NZ,$8018   ;
 $8016 SET 3,B       ;
*$8018 BIT 1,A       ;
 $801A JR NZ,$801E   ;
 $801C SET 4,B       ; }
*$801E LD A,B        ; {Store the control word
 $801F LD ($7522),A  ;
 $8022 RET           ; }
; Sinclair Interface 2 (7FD5=1): both joystick ports are read and merged.
*$8023 LD A,$EF      ; {Keys 0,9,8,7,6 (port 2: fire, up, down, right, left)
 $8025 IN A,($FE)    ; map directly onto bits 0-4
 $8027 OR $E0        ;
 $8029 CPL           ;
 $802A LD B,A        ; }
 $802B LD A,$F7      ; {Keys 1-5 (port 1): 5 fire -> bit 0
 $802D IN A,($FE)    ;
 $802F BIT 4,A       ;
 $8031 JR NZ,$8035   ;
 $8033 SET 0,B       ; }
*$8035 BIT 3,A       ; {4 (up) -> bit 1 (descend)
 $8037 JR NZ,$803B   ;
 $8039 SET 1,B       ; }
*$803B BIT 2,A       ; {3 (down) -> bit 2 (climb)
 $803D JR NZ,$8041   ;
 $803F SET 2,B       ; }
*$8041 BIT 1,A       ; {2 (right) -> bit 3
 $8043 JR NZ,$8047   ;
 $8045 SET 3,B       ; }
*$8047 BIT 0,A       ; {1 (left) -> bit 4
 $8049 JR NZ,$804D   ;
 $804B SET 4,B       ;
*$804D LD A,B        ;
 $804E LD ($7522),A  ;
 $8051 RET           ; }
; Kempston (7FD5=2): port 31, active-high bits 0 right, 1 left, 2 down, 3 up, 4
; fire. Joystick forward (up) descends, pulling back climbs, like an aircraft
; stick.
*$8052 LD B,$00      ;
 $8054 IN A,($1F)    ; {Fire -> forward (bit 0)
 $8056 BIT 4,A       ;
 $8058 JR Z,$805C    ;
 $805A SET 0,B       ; }
*$805C BIT 3,A       ; {Up -> descend (bit 1)
 $805E JR Z,$8062    ;
 $8060 SET 1,B       ; }
*$8062 BIT 2,A       ; {Down -> climb (bit 2)
 $8064 JR Z,$8068    ;
 $8066 SET 2,B       ; }
*$8068 BIT 0,A       ; {Right -> bit 3
 $806A JR Z,$806E    ;
 $806C SET 3,B       ; }
*$806E BIT 1,A       ; {Left -> bit 4
 $8070 JR Z,$8074    ;
 $8072 SET 4,B       ;
*$8074 LD A,B        ;
 $8075 LD ($7522),A  ;
 $8078 RET           ; }
; Protek/AGF cursor joystick (7FD5=3): 5 left, 6 down, 7 up, 8 right, 0 fire.
*$8079 LD B,$00      ;
 $807B LD A,$F7      ; {Key 5 -> left (bit 4)
 $807D IN A,($FE)    ;
 $807F BIT 4,A       ;
 $8081 JR NZ,$8085   ;
 $8083 SET 4,B       ; }
*$8085 LD A,$EF      ; {Half-row 0-6: 6 -> climb (bit 2)
 $8087 IN A,($FE)    ;
 $8089 BIT 4,A       ;
 $808B JR NZ,$808F   ;
 $808D SET 2,B       ; }
*$808F BIT 3,A       ; {7 -> descend (bit 1)
 $8091 JR NZ,$8095   ;
 $8093 SET 1,B       ; }
*$8095 BIT 2,A       ; {8 -> right (bit 3)
 $8097 JR NZ,$809B   ;
 $8099 SET 3,B       ; }
*$809B BIT 0,A       ; {0 -> forward (bit 0)
 $809D JR NZ,$80A1   ;
 $809F SET 0,B       ;
*$80A1 LD A,B        ;
 $80A2 LD ($7522),A  ;
 $80A5 RET           ; }

; Unused
u$80A6 DEFB $00,$00,$00,$00

; Check the M (map) and N (view) keys, then process the flight controls
;
; Called once per main-loop iteration (5BAC) except when the helicopter is
; landed away from the base with an empty tank. Reads half-row SPACE/SYM/M/N/B
; once. M toggles between the island view and the map; N toggles the view
; direction NORTH/SOUTH. Both are edge-triggered through latch bits in 7526 and
; each press beeps. Execution then falls through into the flight-control code
; at 8135.
;
; I:(7526) key latches / mode flags: bit0 M held, bit1 map mode, bit2 N held,
; .        bit3 map just left, bit4 map just entered
; I:(7504) view direction 0=north 1=south
;
; 7526 bit 4 is consumed by the main loop (5B6F: redraw the map); bit 3 is set
; on leaving the map but nothing ever clears or tests it.
c$80AA LD HL,$7526   ; HL = mode flags
 $80AD LD A,$7F      ; {Read half-row SPACE/SYM/M/N/B
 $80AF IN A,($FE)    ; }
 $80B1 BIT 2,A       ; {M (bit 2) not pressed: clear the M latch
 $80B3 JR NZ,$80D8   ; }
 $80B5 BIT 0,(HL)    ; {M still held from the previous iteration: ignore
 $80B7 JR NZ,$80DA   ; }
 $80B9 PUSH AF       ; {Beep: BEEPER HL=$0361, DE=30 (about 489 Hz for 61 ms)
 $80BA PUSH HL       ;
 $80BB LD HL,$0361   ;
 $80BE LD DE,$001E   ;
 $80C1 CALL $03B5    ;
 $80C4 POP HL        ;
 $80C5 POP AF        ; }
 $80C6 SET 0,(HL)    ; Set the M latch
 $80C8 BIT 1,(HL)    ; {In map mode?
 $80CA JR Z,$80D2    ; }
 $80CC RES 1,(HL)    ; {Yes: leave map mode, set bit 3 ("map just left")
 $80CE SET 3,(HL)    ;
 $80D0 JR $80DA      ; }
*$80D2 SET 1,(HL)    ; {No: enter map mode, set bit 4 ("map just entered": main
 $80D4 SET 4,(HL)    ; loop draws the map)
 $80D6 JR $80DA      ; }
*$80D8 RES 0,(HL)    ; M released: clear the latch
*$80DA BIT 3,A       ; {N (bit 3) not pressed: clear the N latch
 $80DC JR NZ,$8133   ; }
 $80DE BIT 2,(HL)    ; {N still held: ignore
 $80E0 JR NZ,$8135   ; }
 $80E2 SET 2,(HL)    ; Set the N latch
 $80E4 LD A,$7F      ; {Blank the VIEW box (attribute $7F white on white) while
 $80E6 CALL $8582    ; beeping}
 $80E9 LD HL,$0300   ; {Beep: BEEPER HL=$0300, DE=40 (about 548 Hz for 73 ms)
 $80EC LD DE,$0028   ;
 $80EF CALL $03B5    ; }
 $80F2 LD A,($7504)  ; {Currently facing south? Then switch to north (80F9),
 $80F5 CP $00        ; else to south (8104)
 $80F7 JR Z,$8104    ; }

; Set the view direction to NORTH
;
; Also called directly at game start / after a death (5B36), so it then falls
; through into the flight controls once. Sets 7504=0, prints NORTH (attr $38),
; and patches the tile-page high bytes used by the renderer (7B18, 7E35, 7E41,
; 7E6D, 7E93, 7EB9, 7EDF, 7F05) to the north set
; $63,$63,$63,$66,$67,$68,$69,$6A. Entry 8104 does the same for SOUTH: 7504=1,
; attr $78, text SOUTH (827F), pages $6C,$6C,$6C,$6F,$70,$71,$72,$73. Each tile
; code has one byte per height level in page base+0, +1, +2...; the two sets
; hold the tile stacks as seen from the north and from the south.
c$80F9 XOR A         ; {7504 = 0 (north)
 $80FA LD ($7504),A  ; }
 $80FD CALL $8580    ; Print NORTH with attribute $38
 $8100 LD A,$63      ; {North page base = $63
 $8102 JR $8113      ; }
; This entry point is used by the routine at #R$80AA.
*$8104 LD A,$01      ; {7504 = 1 (south)
 $8106 LD ($7504),A  ; }
 $8109 LD A,$78      ; {Print SOUTH (827F) with attribute $78 (bright)
 $810B LD HL,$827F   ;
 $810E CALL $8585    ; }
 $8111 LD A,$6C      ; South page base = $6C
*$8113 LD ($7B18),A  ; {Patch the page bases into the renderer: base...
 $8116 LD ($7E35),A  ;
 $8119 LD ($7E41),A  ; }
 $811C ADD A,$03     ; {...base+3...
 $811E LD ($7E6D),A  ; }
 $8121 INC A         ; {...base+4 ... base+7
 $8122 LD ($7E93),A  ;
 $8125 INC A         ;
 $8126 LD ($7EB9),A  ;
 $8129 INC A         ;
 $812A LD ($7EDF),A  ;
 $812D INC A         ;
 $812E LD ($7F05),A  ;
 $8131 JR $8135      ; }
; This entry point is used by the routine at #R$80AA.
*$8133 RES 2,(HL)    ; N released: clear the N latch

; Flight controls: turning, thrust/coasting, climbing, descending
;
; Reached by fall-through from 80AA/80F9 once per main-loop iteration. Applies
; the control word 7522 to the helicopter: (1) turning in steps of 2 (=45
; degrees) of the 16-step heading with a 3-iteration turn timer, (2) thrust:
; speed 7527 rises by 1 per iteration up to 7 while forward is held and decays
; by 1 when not, the helicopter moving one map unit along X and/or Y per
; iteration while speed>0 (direction 753B is latched while thrusting, so the
; craft coasts in the old direction after releasing), (3) climb/descent with an
; acceleration of 1,2,3 pixels per iteration, altitude 750D limited to 0..60.
;
; I:(7522) control bits
; I:(7515) 1 = landed (no turning or movement; climb = take off)
; I:(7516) 1 = fuel exhausted (no thrust, no climb, forced descent)
; O:(7500),(7502) map X and Y (16-bit)
; O:(7506) heading 0-15 (always even: 0 N, 2 NE, 4 E, 6 SE, 8 S, 10 SW, 12 W,
; .        14 NW)
; O:(7507) heading shown by the sprite (odd during a turn)
; O:(750D) altitude 0-60 pixels
; O:(7514) set to 1 when trying to descend below altitude 0
c$8135 LD A,($7522)  ; {C = control bits for the rest of the routine
 $8138 LD C,A        ; }
 $8139 LD HL,$7521   ; {Turn timer 7521 running?
 $813C XOR A         ;
 $813D CP (HL)       ;
 $813E JR Z,$8152    ; }
 $8140 DEC (HL)      ; {Count it down; when it reaches 1 the turn completes:
 $8141 INC A         ; heading = 7507 = target 7508
 $8142 CP (HL)       ;
 $8143 JP NZ,$81AB   ;
 $8146 LD A,($7508)  ;
 $8149 LD ($7506),A  ;
 $814C LD ($7507),A  ;
 $814F JP $81AB      ; }
*$8152 LD A,($7515)  ; {Landed: skip turning and movement, only the climb key
 $8155 CP $01        ; matters
 $8157 JP Z,$81FA    ; }
 $815A BIT 4,C       ; {Turn left (bit 4)?
 $815C JR Z,$817A    ; }
 $815E LD A,($7506)  ; {7507 = heading-1 (mod 16), the in-between sprite frame
 $8161 DEC A         ;
 $8162 CP $FF        ;
 $8164 JR NZ,$8168   ;
 $8166 LD A,$0F      ;
*$8168 LD ($7507),A  ; }
 $816B DEC A         ; {7508 = heading-2 (mod 16), the target heading
 $816C CP $FF        ;
 $816E JR NZ,$8172   ;
 $8170 LD A,$0F      ;
*$8172 LD ($7508),A  ; }
 $8175 LD A,$03      ; {Start the turn timer (3 iterations: the turn completes
 $8177 LD ($7521),A  ; 2 iterations later, the next turn can start after 3)}
*$817A BIT 3,C       ; {Turn right (bit 3)?
 $817C JR Z,$81AB    ; }
 $817E LD A,($7506)  ; {7507 = heading+1, 7508 = heading+2 (mod 16)
 $8181 INC A         ;
 $8182 CP $10        ;
 $8184 JR NZ,$8187   ;
 $8186 XOR A         ;
*$8187 LD ($7507),A  ;
 $818A INC A         ;
 $818B CP $10        ;
 $818D JR NZ,$8190   ;
 $818F XOR A         ;
*$8190 LD ($7508),A  ; }
 $8193 LD A,($7521)  ; {Left pressed as well (timer already started)? Then
 $8196 CP $00        ; cancel: no turn, timer 0
 $8198 JR Z,$81A6    ;
 $819A LD A,($7506)  ;
 $819D LD ($7507),A  ;
 $81A0 LD ($7508),A  ;
 $81A3 XOR A         ;
 $81A4 JR $81A8      ; }
*$81A6 LD A,$03      ; {Start the turn timer
*$81A8 LD ($7521),A  ; }
*$81AB LD A,($7516)  ; {Out of fuel: no thrust
 $81AE CP $01        ;
 $81B0 JR Z,$81B6    ; }
 $81B2 BIT 0,C       ; {Forward (bit 0) held: accelerate
 $81B4 JR NZ,$81CB   ; }
*$81B6 LD A,($7527)  ; {Not thrusting: speed = max(speed-1, 0)
 $81B9 DEC A         ;
 $81BA CP $FF        ;
 $81BC JR NZ,$81BF   ;
 $81BE XOR A         ;
*$81BF LD ($7527),A  ;
 $81C2 CP $00        ; }
 $81C4 JR Z,$81FA    ; Stopped: no movement this iteration
 $81C6 LD A,($753B)  ; {Coasting: keep moving in the latched direction
 $81C9 JR $81DC      ; }
*$81CB LD A,($7527)  ; {Thrusting: speed = min(speed+1, 7)
 $81CE CP $07        ;
 $81D0 JR Z,$81D6    ;
 $81D2 INC A         ;
 $81D3 LD ($7527),A  ; }
*$81D6 LD A,($7506)  ; {Latch the direction of travel = current heading
 $81D9 LD ($753B),A  ; }
*$81DC LD HL,$826F   ; {Fetch the two movement opcodes for direction A from the
 $81DF LD D,$00      ; table at 826F (bytes A and A+1)
 $81E1 LD E,A        ;
 $81E2 ADD HL,DE     ;
 $81E3 LD A,(HL)     ; }
 $81E4 LD ($81EF),A  ; {Patch the X opcode at 81EF...
 $81E7 INC HL        ;
 $81E8 LD A,(HL)     ; }
 $81E9 LD ($81F6),A  ; ...and the Y opcode at 81F6
 $81EC LD HL,($7500) ; {X = X + dx (self-modified: NOP / DEC HL / INC HL)
 $81EF NOP           ;
 $81F0 LD ($7500),HL ; }
 $81F3 LD HL,($7502) ; {Y = Y + dy (self-modified)
 $81F6 NOP           ;
 $81F7 LD ($7502),HL ; }
*$81FA BIT 2,C       ; {Climb key (bit 2)?
 $81FC JR Z,$8232    ; }
 $81FE LD A,($7516)  ; {Out of fuel: cannot climb
 $8201 CP $01        ;
 $8203 JR Z,$8232    ; }
 $8205 LD A,($7515)  ; {Landed? Then this press is the take-off:
 $8208 CP $00        ;
 $820A JR Z,$8214    ; }
 $820C XOR A         ; {clear 7515 (landed) and 752E (on base pad) and return
 $820D LD ($7515),A  ;
 $8210 LD ($752E),A  ;
 $8213 RET           ; }
*$8214 LD A,($751A)  ; {Climb rate 751A = min(rate+1, 3)
 $8217 CP $03        ;
 $8219 JR Z,$821F    ;
 $821B INC A         ;
 $821C LD ($751A),A  ; }
*$821F LD B,A        ; {Raise the altitude by the climb rate, one pixel at a
 $8220 LD A,($750D)  ; time, stopping at 60
*$8223 CP $3C        ;
 $8225 JR NC,$8236   ; }
 $8227 INC A         ; {Raise the altimeter bar by one pixel
 $8228 CALL $82D4    ;
 $822B LD ($750D),A  ;
 $822E DJNZ $8223    ;
 $8230 JR $8236      ; }
*$8232 XOR A         ; {Climb key released: climb rate 0
 $8233 LD ($751A),A  ; }
*$8236 LD A,($7515)  ; {Landed: no descent
 $8239 CP $01        ;
 $823B RET Z         ; }
 $823C LD A,($7516)  ; {Out of fuel: forced descent
 $823F CP $01        ;
 $8241 JR Z,$824C    ; }
 $8243 BIT 1,C       ; {Descend key (bit 1)?
 $8245 JR NZ,$824C   ; }
 $8247 XOR A         ; {No: descent rate 0
 $8248 LD ($751B),A  ;
 $824B RET           ; }
*$824C LD A,($751B)  ; {Descent rate 751B = min(rate+1, 3)
 $824F CP $03        ;
 $8251 JR Z,$8257    ;
 $8253 INC A         ;
 $8254 LD ($751B),A  ; }
*$8257 LD B,A        ; {Lower the altitude by the descent rate, one pixel at a
 $8258 LD A,($750D)  ; time
*$825B DEC A         ; }
 $825C BIT 7,A       ; {Would go below 0: stop
 $825E JR NZ,$8269   ; }
 $8260 CALL $82FB    ; {Lower the altimeter bar by one pixel
 $8263 LD ($750D),A  ;
 $8266 DJNZ $825B    ;
 $8268 RET           ; }
*$8269 LD A,$01      ; {7514 = 1: tried to descend at altitude 0 (8A7A then
 $826B LD ($7514),A  ; decides between landing and crashing)
 $826E RET           ; }

; Movement opcode table
;
; Indexed by the direction of travel d (0-15): byte d is the opcode applied to
; X, byte d+1 the opcode applied to Y ($00 NOP, $23 INC HL, $2B DEC HL). Only
; even d are used (headings are always even), giving N (0,-1), NE (+1,-1), E
; (+1,0), SE (+1,+1), S (0,+1), SW (-1,+1), W (-1,0), NW (-1,-1). For d=15 the
; Y opcode would be the 'S' at 827F (LD D,E, harmless).
b$826F DEFB $00,$2B
 $8271 DEFB $23,$2B
 $8273 DEFB $23,$00
 $8275 DEFB $23,$23
 $8277 DEFB $00,$23
 $8279 DEFB $2B,$23
 $827B DEFB $2B,$00
 $827D DEFB $2B,$2B

; View direction text
t$827F DEFM "SOUTH"  ; "SOUTH" (printed by 8104)

; Count down the time-left bar (T)
;
; Called once per main-loop iteration (5BD7). Every (828C) iterations ($FF=255
; in round 1, 15 fewer each round) erases one pixel line from the top of the T
; bar (column 30, rows 1-5, 40 lines). When the pointer passes the bottom of
; the bar it becomes $40DE and the main loop (5BCC) jumps to 92C8: "NO TIME",
; game over.
;
; I:(7528) iteration counter
; I:(751C) screen address of the last erased line of the T bar, i.e. the line
; .        just above the top lit one ($471E = full)
;
; The comparison operand at 828C is patched by 8372 (reset to $FF on a new
; game) and 83AD (minus 15 on each completed round).
c$8284 LD A,($7528)  ; {Increment the time sub-counter
 $8287 INC A         ;
 $8288 LD ($7528),A  ; }
 $828B CP $FF        ; {Not yet (828C) iterations: return (operand
 $828D RET C         ; self-modified)}
 $828E XOR A         ; {Reset the sub-counter
 $828F LD ($7528),A  ; }
 $8292 LD HL,($751C) ; {Move the pointer one pixel line down (next row of cells
 $8295 INC H         ; when leaving a cell)
 $8296 LD A,H        ;
 $8297 CP $48        ;
 $8299 JR NZ,$82A1   ;
 $829B LD H,$40      ;
 $829D LD A,$20      ;
 $829F ADD A,L       ;
 $82A0 LD L,A        ; }
*$82A1 LD (HL),$00   ; {Erase that line of the bar
 $82A3 LD ($751C),HL ;
 $82A6 RET           ; }

; Burn fuel (F bar)
;
; Jumped to from 8470 when not on the base pad (and called by 92A9 to drain the
; tank during the death sequence). Every 49 iterations erases one pixel line
; from the top of the F bar (column 28, rows 1-5, 40 lines). After the last
; line, 7516 is set to 1 (tank empty).
;
; I:(7517) fuel sub-counter
; I:(7518) screen address of the last erased line of the F bar, i.e. just above
; .        the top lit one ($471C = full, $47BC = empty)
; O:(7516) 1 when the tank runs dry
c$82A7 LD HL,$7517   ; {Sub-counter 0..48
 $82AA INC (HL)      ;
 $82AB LD A,$30      ;
 $82AD CP (HL)       ;
 $82AE RET NC        ;
 $82AF LD (HL),$00   ; }
 $82B1 LD HL,($7518) ; {Move the pointer down one pixel line
 $82B4 INC H         ;
 $82B5 LD A,H        ;
 $82B6 CP $48        ;
 $82B8 JR NZ,$82CB   ; }
 $82BA LD A,L        ; {Off the bottom of the bar (row 5)? Then the tank is
 $82BB CP $BC        ; empty
 $82BD JR NZ,$82C5   ;
 $82BF LD A,$01      ;
 $82C1 LD ($7516),A  ;
 $82C4 RET           ; }
*$82C5 LD H,$40      ; {Next character row
 $82C7 LD A,$20      ;
 $82C9 ADD A,L       ;
 $82CA LD L,A        ; }
*$82CB LD (HL),$00   ; {Erase the line
 $82CD LD ($7518),HL ;
 $82D0 RET           ; }

; Unused
u$82D1 DEFB $00,$00,$00

; Raise the altimeter bar by one pixel
;
; Moves the altimeter pointer 751E up one pixel line in column 24 and lights it
; ($FF). The bar runs from row 8 upwards (row 8 is lit at altitude 8; altitude
; 60 reaches row 1, line 4). Called by the climb code (8228) and by the landing
; code (8B16) when the altitude is rounded up.
;
; I:(751E) screen address of the top lit line of the A bar
c$82D4 PUSH AF       ;
 $82D5 PUSH HL       ;
 $82D6 LD HL,($751E) ; {Up one pixel line
 $82D9 DEC H         ;
 $82DA LD A,H        ; }
 $82DB CP $47        ; {Crossing from the top line of row 8 into row 7 (screen
 $82DD JR Z,$82E7    ; third boundary)?}
 $82DF CP $3F        ; {Crossing a character row inside the top third?
 $82E1 JR NZ,$82F3   ; }
 $82E3 LD H,$47      ; {Previous character row: H=$47, L=L-32
 $82E5 JR $82E9      ; }
*$82E7 LD H,$4F      ; {Third boundary: row 7 line 7 is $47F8
*$82E9 LD A,$E0      ;
 $82EB ADD A,L       ;
 $82EC LD L,A        ;
 $82ED CP $F8        ;
 $82EF JR NZ,$82F3   ;
 $82F1 LD H,$47      ; }
*$82F3 LD (HL),$FF   ; {Light the line
 $82F5 LD ($751E),HL ;
 $82F8 POP HL        ;
 $82F9 POP AF        ;
 $82FA RET           ; }

; Lower the altimeter bar by one pixel
;
; Clears the top lit line of the altimeter bar and moves the pointer 751E down
; one line. Quirk: the test at 8307 uses $4F instead of $50, so below altitude
; 2 the pointer skips line 7 of row 8 and continues in row 9 (a stray line can
; then be drawn at $4838 when climbing back from altitude 0).
;
; I:(751E) screen address of the top lit line of the A bar
c$82FB PUSH AF       ;
 $82FC LD HL,($751E) ; {Erase the current top line
 $82FF LD (HL),$00   ; }
 $8301 INC H         ; {Down one pixel line
 $8302 LD A,H        ; }
 $8303 CP $48        ; {Leaving the bottom of the top third?
 $8305 JR Z,$830F    ; }
 $8307 CP $4F        ; {Quirk: should be $50
 $8309 JR NZ,$831B   ;
 $830B LD H,$48      ;
 $830D JR $8311      ; }
*$830F LD H,$40      ; {Next character row in the top third: H=$40, L=L+32
*$8311 LD A,$20      ;
 $8313 ADD A,L       ;
 $8314 LD L,A        ; }
 $8315 CP $18        ; {Row 7 -> row 8: H=$48
 $8317 JR NZ,$831B   ;
 $8319 LD H,$48      ;
*$831B LD ($751E),HL ;
 $831E POP AF        ;
 $831F RET           ;
 $8320 NOP           ; }

; Start a round: crate boxes, round bonus, difficulty
;
; Called at 5B26 at the start of every round (new game, or after the 5th crate
; has been delivered to the base). Blanks the five crate boxes (attributes of
; rows 22-23, columns 0-9) and lights them one by one with a beep and a 0.19 s
; pause. On a new game (7554<>5) it resets the time-bar period to 255, sets the
; wind threshold 5B93 to 5 and picks a random cyclone starting corner
; (754B/754C). After a completed round (7554=5) it awards the round bonus,
; resets the crate counter, sets the wind threshold to 6 and shortens the
; time-bar period by 15. Finally clears the lives-lost counter 9245 and redraws
; the HUD.
;
; I:(7554) crates delivered (5 = round complete)
; I:(9245) lives lost this round (0-2)
; O:(5B93) wind threshold (operand of CP at 5B92: 7378 runs while 7550 < it)
; O:(828C) time-bar period in iterations
; O:(754B),(754C) cyclone start position (new game only)
c$8321 LD IX,$5AC0   ; {Attributes of the five 2x2 crate boxes (rows 22-23,
 $8325 XOR A         ; columns 0-9) = 0: invisible
 $8326 LD B,$0A      ;
*$8328 LD (IX+$00),A ;
 $832B LD (IX+$20),A ;
 $832E INC IX        ;
 $8330 DJNZ $8328    ; }
 $8332 LD IX,$5AC0   ; {Light the boxes one by one (ink 6 yellow)
 $8336 LD B,$05      ;
*$8338 LD A,$06      ;
 $833A LD (IX+$00),A ;
 $833D LD (IX+$01),A ;
 $8340 LD (IX+$20),A ;
 $8343 LD (IX+$21),A ;
 $8346 INC IX        ;
 $8348 INC IX        ;
 $834A PUSH BC       ;
 $834B PUSH IX       ; }
 $834D LD HL,$03E8   ; {Beep: BEEPER HL=$03E8, DE=44 (about 425 Hz for 104 ms)
 $8350 LD DE,$002C   ;
 $8353 CALL $03B5    ;
 $8356 POP IX        ; }
 $8358 LD C,$C8      ; {Delay: 200 x 255 DJNZ loops (about 666,000 T-states,
*$835A LD B,$FF      ; 0.19 s)
*$835C DJNZ $835C    ;
 $835E DEC C         ;
 $835F JR NZ,$835A   ;
 $8361 POP BC        ;
 $8362 DJNZ $8338    ; }
 $8364 LD A,($7554)  ; {Round complete (5 crates delivered)?
 $8367 CP $05        ;
 $8369 JR Z,$8390    ; }
 $836B LD A,$05      ; {New game: wind threshold 5
 $836D LD ($5B93),A  ; }
 $8370 LD A,$FF      ; {Time-bar period 255 iterations
 $8372 LD ($828C),A  ; }
 $8375 CALL $8B74    ; {Random cyclone corner: 754B = 2 or 20 (bit 0 of L),
 $8378 LD A,$02      ; 754C = 2 or 19 (bit 1 of L)
 $837A BIT 0,L       ;
 $837C JR Z,$8380    ;
 $837E LD A,$14      ;
*$8380 LD ($754B),A  ;
 $8383 LD A,$02      ;
 $8385 BIT 1,L       ;
 $8387 JR Z,$838B    ;
 $8389 LD A,$13      ;
*$838B LD ($754C),A  ;
 $838E JR $83B6      ; }
*$8390 XOR A         ; {Round complete: crates delivered = 0
 $8391 LD ($7554),A  ; }
 $8394 LD A,($9245)  ; {B = 250 - 64 * lives lost (mod 256): 250, 186 or 122
 $8397 ADD A,A       ;
 $8398 ADD A,A       ;
 $8399 ADD A,A       ;
 $839A ADD A,A       ;
 $839B ADD A,A       ;
 $839C ADD A,A       ;
 $839D LD B,A        ;
 $839E LD A,$FA      ;
 $83A0 SUB B         ;
 $83A1 LD B,A        ; }
 $83A2 CALL $6602    ; {Add B points; the second call adds whatever B the score
 $83A5 CALL $6602    ; printer 6F00 leaves, which is always $66 (102)}
 $83A8 LD A,$06      ; {Wind threshold 6 for every later round
 $83AA LD ($5B93),A  ; }
 $83AD LD A,($828C)  ; {Time-bar period 15 iterations shorter
 $83B0 LD B,$0F      ;
 $83B2 SUB B         ;
 $83B3 LD ($828C),A  ; }
*$83B6 XOR A         ; {Lives lost this round = 0 (all three helicopters
 $83B7 LD ($9245),A  ; restored)}
 $83BA CALL $84F4    ; {Redraw the HUD
 $83BD RET           ; }

; Unused
u$83BE DEFB $00,$00,$44,$00

; Interrupt handler: rotor and winch sounds, crash noise
;
; Reached 50 times a second through the IM2 vector (FFFF->F3F3: JP 83C2).
; Silent when 752D=1 (menu, or after the crash sequence starts). When 7505=1
; (helicopter destroyed) jumps to the explosion noise at 5FDC, which returns
; through 842D. Otherwise, unless landed (7515) or out of fuel (7516), plays
; one rotor 'chop': a 4-interrupt cycle of one short high burst (10 cycles,
; half-periods 18 DJNZ loops) and three lower bursts (6 cycles, half-periods
; 36), both half-periods shortened by 2*speed. While 7555 is non-zero (winch
; line moving) a short BEEPER tone (HL=50, DE=8) precedes the chop.
;
; I:(752D) 1 = sound off
; I:(7505) 1 = helicopter destroyed
; I:(7515),(7516) landed / out of fuel: no rotor sound
; I:(7555) winch counter (non-zero = winch sound)
; I:(755D) rotor phase 0-3
; I:(7527) speed 0-7
c$83C2 DI            ; {Save registers (IX too: the ROM BEEPER uses it)
 $83C3 PUSH AF       ;
 $83C4 PUSH IX       ;
 $83C6 PUSH BC       ;
 $83C7 PUSH DE       ;
 $83C8 PUSH HL       ; }
 $83C9 LD A,($752D)  ; {Sound disabled?
 $83CC CP $01        ;
 $83CE JP Z,$842D    ; }
 $83D1 LD A,($7505)  ; {Helicopter destroyed: explosion noise (5FDC, ends with
 $83D4 CP $01        ; JP 842D)
 $83D6 JP Z,$5FDC    ; }
 $83D9 LD A,($7516)  ; {Landed or tank empty: silence
 $83DC LD HL,$7515   ;
 $83DF OR (HL)       ;
 $83E0 CP $00        ;
 $83E2 JR NZ,$842D   ; }
 $83E4 LD A,($7555)  ; {Winch running?
 $83E7 CP $00        ;
 $83E9 JR Z,$83F4    ; }
 $83EB LD DE,$0008   ; {Winch beep: BEEPER HL=$0032, DE=8 (about 5.5 kHz for
 $83EE LD HL,$0032   ; 1.5 ms)
 $83F1 CALL $03B5    ; }
*$83F4 LD A,($755D)  ; {Advance the rotor phase
 $83F7 INC A         ;
 $83F8 CP $02        ;
 $83FA JR NC,$8404   ; }
 $83FC LD C,$0A      ; {Phase 0->1: high burst, C=10 cycles, half-periods 18/18
 $83FE LD E,$12      ;
 $8400 LD D,$12      ;
 $8402 JR $840F      ; }
*$8404 CP $04        ; {Phases 1->2, 2->3, 3->0: low burst, C=6 cycles,
 $8406 JR C,$8409    ; half-periods 36/36
 $8408 XOR A         ;
*$8409 LD C,$06      ;
 $840B LD D,$24      ;
 $840D LD E,$24      ;
*$840F LD ($755D),A  ; }
 $8412 LD A,($7527)  ; {Both half-periods -= 2 * speed
 $8415 ADD A,A       ;
 $8416 LD B,A        ;
 $8417 LD A,D        ;
 $8418 SUB B         ;
 $8419 LD D,A        ;
 $841A LD A,E        ;
 $841B SUB B         ;
 $841C LD E,A        ; }
*$841D LD A,$10      ; {Speaker on (border black)
 $841F OUT ($FE),A   ;
 $8421 LD B,E        ;
*$8422 DJNZ $8422    ; }
 $8424 XOR A         ; {Speaker off
 $8425 OUT ($FE),A   ;
 $8427 LD B,D        ;
*$8428 DJNZ $8428    ;
 $842A DEC C         ;
 $842B JR NZ,$841D   ; }
; This entry point is used by the routine at #R$5FDC.
*$842D POP HL        ; {Restore registers and return
 $842E POP DE        ;
 $842F POP BC        ;
 $8430 POP IX        ;
 $8432 POP AF        ;
 $8433 EI            ;
 $8434 RET           ; }

; Unused
u$8435 DEFB $00,$00,$00,$00,$00

; Fill the time-left bar, paying 40 points per line still lit
;
; Called at the start of every round (5B29). Walks the T bar (column 30) from
; row 5 line 7 up to row 1 line 0 (40 pixel lines). A line that is still lit
; from the previous round earns 40 points (6600) and a $FF-pitch beep; an unlit
; line is lit with a $D0-pitch beep. Leaves 751C = $471E (full bar) and resets
; the time sub-counter.
;
; O:(751C) $471E
; O:(7528) 0
c$843A XOR A         ; {Time sub-counter = 0
 $843B LD ($7528),A  ; }
 $843E LD HL,$47BE   ; Start at the bottom line of row 5, column 30
*$8441 LD A,(HL)     ; {Line already lit?
 $8442 CP $FF        ;
 $8444 JR Z,$844E    ; }
 $8446 LD (HL),$FF   ; {No: light it and beep with HL=$00D0 (about 1.84 kHz)
 $8448 PUSH HL       ;
 $8449 LD HL,$00D0   ;
 $844C JR $8455      ; }
*$844E PUSH HL       ; {Yes: add 40 points, beep with HL=$00FF (about 1.53 kHz)
 $844F CALL $6600    ;
 $8452 LD HL,$00FF   ; }
*$8455 LD DE,$0010   ; {DE=16 cycles (about 9-10 ms)
 $8458 CALL $03B5    ;
 $845B POP HL        ; }
 $845C DEC H         ; {Up one pixel line; previous character row when leaving
 $845D LD A,H        ; a cell
 $845E CP $3F        ;
 $8460 JR NZ,$8441   ;
 $8462 LD H,$47      ;
 $8464 LD A,$E0      ;
 $8466 ADD A,L       ;
 $8467 LD L,A        ; }
 $8468 CP $1E        ; {Stop after row 1
 $846A JR NZ,$8441   ;
 $846C LD ($751C),HL ;
 $846F RET           ; }

; Fuel: refuel on the base pad, otherwise burn
;
; Called once per main-loop iteration (5BD4). When not on the base helipad
; (752E=0) jumps to 82A7 to burn fuel. On the pad, adds one pixel line to the F
; bar per iteration (with a $D0-pitch beep) until the bar is full (pointer
; reaches row 0, $471C), and clears the empty-tank flag 7516. A full refuel
; from empty takes 40 iterations (about 4 seconds).
;
; I:(752E) 1 = landed on the base helipad
; I:(7518) F-bar pointer
; O:(7516) 0
c$8470 LD A,($752E)  ; {Not on the pad: burn fuel
 $8473 CP $00        ;
 $8475 JP Z,$82A7    ; }
 $8478 LD A,($7517)  ; {Sub-counter (always passes)
 $847B INC A         ;
 $847C LD ($7517),A  ;
 $847F CP $01        ;
 $8481 RET C         ;
 $8482 XOR A         ;
 $8483 LD ($7517),A  ; }
 $8486 LD HL,($7518) ; {Bar full (pointer in row 0)?
 $8489 LD A,L        ;
 $848A CP $1C        ;
 $848C RET Z         ; }
 $848D PUSH HL       ; {Beep: BEEPER HL=$00D0, DE=16
 $848E LD HL,$00D0   ;
 $8491 LD DE,$0010   ;
 $8494 CALL $03B5    ;
 $8497 POP HL        ; }
 $8498 LD (HL),$FF   ; {Light one line and move the pointer up
 $849A DEC H         ;
 $849B LD A,H        ;
 $849C CP $3F        ;
 $849E JR NZ,$84A6   ;
 $84A0 LD H,$47      ;
 $84A2 LD A,$E0      ;
 $84A4 ADD A,L       ;
 $84A5 LD L,A        ;
*$84A6 LD ($7518),HL ; }
 $84A9 XOR A         ; {Tank not empty any more
 $84AA LD ($7516),A  ;
 $84AD RET           ; }

; Initialise the altimeter bar
;
; Called at the start of a life (5B39). Clears column 24 in rows 1-7, lights
; all eight lines of row 8, and sets the altitude 750D to 8 with the pointer
; 751E = $4818 (top line of row 8).
;
; O:(750D) 8
; O:(751E) $4818
c$84AE LD HL,$4038   ; {Clear rows 1-7 of column 24
*$84B1 LD (HL),$00   ;
 $84B3 INC H         ;
 $84B4 LD A,H        ;
 $84B5 CP $48        ;
 $84B7 JR NZ,$84B1   ;
 $84B9 LD H,$40      ;
 $84BB LD A,$20      ;
 $84BD ADD A,L       ;
 $84BE LD L,A        ;
 $84BF CP $18        ;
 $84C1 JR NZ,$84B1   ; }
 $84C3 LD HL,$5018   ; {Light row 8 of column 24
 $84C6 LD B,$08      ;
*$84C8 DEC H         ;
 $84C9 LD (HL),$FF   ;
 $84CB DJNZ $84C8    ;
 $84CD LD ($751E),HL ;
 $84D0 LD A,$08      ;
 $84D2 LD ($750D),A  ;
 $84D5 RET           ; }

