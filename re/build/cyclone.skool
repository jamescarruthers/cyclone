; Island records
;
; 14 records of 20 bytes, terminated by $FF, in the order of the names at
; #R$6A4F: BANANA, ORTE ROCKS, KOKOLA, LAGOON, PEAK, BASE (#R$F294, the home
; island: level complete needs $7552=$F294), GILLIGANS, RED, SKEG, BONE, GIANTS
; GATEWAY, CLAW, LUKELAND ISLES, ENTERPRISE. +0/+1: world X and Y high bytes;
; +2/+3: X low range [min,max); +4/+5: Y low range [min,max) (bounding box
; tested by $76D2 to set $7552); +6..+9: X/Y origin bytes used to convert world
; coordinates to map cells (cell = base + (Y+$0E-[+8])*128 + (X+$0B-[+6]),
; #R$F444); +$0A/+$0B: address of the island's origin in the 128-byte-wide
; world map; +$0C/+$0D: screen address of the island bitmap on the map screen;
; +$0E/+$0F: its width/height; +$10/+$11: label screen address; +$12: label
; attribute page; +$13: 0.
b$F230 DEFB $02,$01,$5C,$A8,$80,$B8,$72,$92,$9C,$9C,$00,$93,$94,$48,$0D,$06,$6F,$48,$59,$00
 $F244 DEFB $01,$02,$88,$D3,$00,$39,$9E,$BD,$1C,$1D,$00,$9D,$0D,$53,$0C,$07,$2E,$50,$5A,$00
 $F258 DEFB $01,$00,$57,$A1,$94,$CC,$6D,$8B,$B0,$AF,$00,$A9,$AB,$40,$0C,$07,$C8,$40,$58,$00
 $F26C DEFB $00,$00,$74,$CB,$B8,$F0,$8A,$B5,$D4,$D4,$00,$B6,$C4,$40,$10,$07,$E2,$40,$58,$00
 $F280 DEFB $02,$00,$28,$65,$58,$90,$3E,$4F,$74,$74,$00,$C3,$72,$40,$0A,$07,$50,$40,$58,$00
 $F294 DEFB $01,$01,$1C,$82,$50,$88,$32,$6C,$6C,$6C,$80,$CF,$69,$48,$14,$07,$86,$48,$59,$00
 $F2A8 DEFB $01,$00,$1C,$5E,$58,$91,$32,$48,$74,$75,$54,$93,$69,$40,$0A,$07,$42,$40,$58,$00
 $F2BC DEFB $01,$02,$78,$B6,$40,$78,$8E,$A0,$5C,$5C,$D8,$9F,$4C,$53,$09,$07,$6D,$50,$5A,$00
 $F2D0 DEFB $00,$02,$70,$AD,$00,$38,$86,$97,$1C,$1C,$D8,$AD,$04,$55,$09,$07,$25,$50,$5A,$00
 $F2E4 DEFB $01,$00,$AC,$FF,$7C,$B4,$C2,$E9,$98,$98,$43,$B8,$8E,$40,$0F,$07,$AF,$40,$58,$00
 $F2F8 DEFB $01,$01,$98,$CB,$0C,$50,$AE,$B5,$28,$34,$37,$93,$2D,$48,$07,$0A,$2E,$48,$59,$00
 $F30C DEFB $01,$01,$C4,$FD,$C0,$FE,$DA,$E7,$DC,$E2,$35,$A7,$CF,$4B,$08,$08,$F0,$48,$59,$00
 $F320 DEFB $00,$02,$30,$6D,$30,$6C,$46,$57,$4C,$50,$28,$C6,$42,$50,$09,$08,$62,$50,$5A,$00
 $F334 DEFB $00,$01,$44,$8B,$B0,$FB,$5A,$75,$CC,$DF,$4F,$C6,$C2,$48,$0B,$0C,$C4,$48,$59,$00
 $F348 DEFB $FF                                                                             ; End of
                                                                                            ; records
 $F349 DEFB $00                                                                             ; Unused

; Animate the survivor glyphs
;
; Called every main-loop iteration. Character $31 (glyph $FB88, 7 lines)
; alternates between the frames at $7DEE and $7DF6 every 4 iterations (counter
; $755B, 0-7); character $32 (glyph $FB90, 8 lines) alternates between $7DFE
; and $7E06 every 3 iterations (counter $755C, 0-5).
@label=AnimateSurvivors
c$F34A LD DE,$FB88   ; {Glyph of character $31
 $F34D LD A,($755B)  ; }
 $F350 INC A         ; {Counter 1 reaches 4: frame 1
 $F351 CP $04        ;
 $F353 JR NZ,$F35A   ;
 $F355 LD HL,$7DEE   ;
 $F358 JR $F362      ; }
*$F35A CP $08        ; {Counter 1 reaches 8: frame 0, counter := 0
 $F35C JR NZ,$F367   ;
 $F35E XOR A         ;
 $F35F LD HL,$7DF6   ;
*$F362 LD BC,$0007   ;
 $F365 LDIR          ;
*$F367 LD ($755B),A  ; }
 $F36A LD DE,$FB90   ; {Glyph of character $32
 $F36D LD A,($755C)  ; }
 $F370 INC A         ; {Counter 2 reaches 3: frame 1
 $F371 CP $03        ;
 $F373 JR NZ,$F37A   ;
 $F375 LD HL,$7DFE   ;
 $F378 JR $F382      ; }
*$F37A CP $06        ; {Counter 2 reaches 6: frame 0, counter := 0
 $F37C JR NZ,$F387   ;
 $F37E XOR A         ;
 $F37F LD HL,$7E06   ;
*$F382 LD BC,$0008   ;
 $F385 LDIR          ;
*$F387 LD ($755C),A  ;
 $F38A RET           ; }

; Unused
s$F38B DEFS $0F

; Winch: pick up crates and survivors
;
; Called every main-loop iteration. $7A85 is the tile under the helicopter
; (centre of the 3x3 tiles saved by $7E10). If it is a crate (#R$F511) or
; survivor (#R$F515) tile, a rope is lowered: E = vertical gap in pixel lines
; between the helicopter and the object (from the view-buffer addresses; RET if
; negative or >255). If E>=17 the rope just dangles (12 lines, then 16 lines
; max) and nothing happens. If E<17 the rope takes two iterations to reach the
; object (winch state $7556: 0 -> 1 -> 2, the step is skipped if E>=13), then
; the object is hooked: the map cell is overwritten with the plain tile
; (#R$F51B) so the object disappears from the world, and a crate increments
; $7554 and turns its HUD box red (attribute 2, boxes from the right). $7555 is
; then set to max(E,2)-1 and the object is reeled in by 1+$751B lines per
; iteration (faster while descending); when $7555 reaches 0 the points are
; scored: crate 250, survivor 50. When the helicopter moves off the object the
; rope is drawn retracted once (12 lines) and $7556 reset. While $7555<>0 the
; interrupt handler plays a winch beep.
@label=Winch
c$F39A LD A,($7555)    ; {Object being reeled in ($7555=1-16)?
 $F39D DEC A           ;
 $F39E CP $10          ;
 $F3A0 JP C,$F4AB      ; }
 $F3A3 LD A,($7A85)    ; Tile under the helicopter
 $F3A6 LD DE,$F51B     ; {Crate tile?
 $F3A9 LD HL,$F511     ;
 $F3AC LD B,$04        ;
*$F3AE CP (HL)         ;
 $F3AF JR Z,$F3DC      ;
 $F3B1 INC HL          ;
 $F3B2 INC DE          ;
 $F3B3 DJNZ $F3AE      ; }
 $F3B5 LD DE,$F51B     ; {Survivor tile (either variant)?
 $F3B8 LD HL,$F515     ;
 $F3BB LD B,$03        ;
*$F3BD CP (HL)         ;
 $F3BE JR Z,$F3D6      ;
 $F3C0 INC HL          ;
 $F3C1 CP (HL)         ;
 $F3C2 JR Z,$F3D6      ;
 $F3C4 INC HL          ;
 $F3C5 INC DE          ;
 $F3C6 DJNZ $F3BD      ; }
 $F3C8 LD A,($7556)    ; {Nothing under the helicopter: retract a lowered rope
 $F3CB CP $00          ;
 $F3CD RET Z           ;
 $F3CE LD E,$0C        ;
 $F3D0 XOR A           ;
 $F3D1 LD ($7556),A    ;
 $F3D4 JR $F427        ; }
*$F3D6 INC B           ; {Survivor: B = 1-3 (pair index from the end); sprite
 $F3D7 LD HL,$F548     ; #R$F548
 $F3DA JR $F3DF        ; }
*$F3DC LD HL,$F52F     ; Crate: B = 1-4; sprite #R$F52F
*$F3DF LD ($7557),HL   ; $7557 = rope+object graphic
 $F3E2 LD A,(DE)       ; {$7551 = plain tile that replaces the object in the
 $F3E3 LD ($7551),A    ; map}
 $F3E6 LD HL,$FDA1     ; {Object position in the view buffer area
 $F3E9 LD A,B          ;
 $F3EA ADD A,A         ;
 $F3EB ADD A,A         ;
 $F3EC ADD A,A         ;
 $F3ED LD B,$00        ;
 $F3EF LD C,A          ;
 $F3F0 AND A           ;
 $F3F1 JR $F3F6        ; }
@label=IM2Vector
 $F3F3 JP $83C2        ; IM2 interrupt vector target (I=$FF, table at $FF00 is
                       ; all $F3): JP to the interrupt handler $83C2. Skipped
                       ; over by the JR above.
*$F3F6 SBC HL,BC       ; {DE = $FDA1-8*B
 $F3F8 EX DE,HL        ; }
 $F3F9 LD A,($750D)    ; {Helicopter altitude
 $F3FC LD C,A          ;
 $F3FD LD HL,$FD96     ;
 $F400 AND A           ;
 $F401 SBC HL,BC       ; }
 $F403 EX DE,HL        ; {DE = gap between helicopter and object
 $F404 AND A           ;
 $F405 SBC HL,DE       ;
 $F407 EX DE,HL        ; }
 $F408 LD A,D          ; {Not in reach (gap < 0 or > 255)
 $F409 CP $00          ;
 $F40B RET NZ          ;
 $F40C LD HL,$7556     ; }
 $F40F LD A,E          ; {Gap >= 17: rope cannot reach
 $F410 CP $11          ;
 $F412 JR C,$F42F      ; }
 $F414 LD E,$10        ; {Rope length 16...
*$F416 INC (HL)        ;
 $F417 LD A,$01        ;
 $F419 CP (HL)         ;
 $F41A JR NZ,$F425     ; }
 $F41C LD A,E          ; {...or 12 on the first iteration
 $F41D CP $0D          ;
 $F41F JR C,$F425      ;
 $F421 LD E,$0C        ;
 $F423 JR $F427        ; }
*$F425 LD (HL),$02     ; Winch state 2
*$F427 LD A,E          ; {Draw the rope only (#R$F51F)
 $F428 PUSH AF         ;
 $F429 LD DE,$F51F     ;
 $F42C JP $F4D8        ; }
*$F42F CP $0D          ; {Gap < 13: advance the winch state
 $F431 JR NC,$F434     ;
 $F433 INC (HL)        ; }
*$F434 LD A,$01        ; {Not yet extended twice: keep extending
 $F436 CP (HL)         ;
 $F437 JR NC,$F416     ; }
 $F439 LD A,E          ; {Hooked: rope length = max(gap,2)-1
 $F43A CP $02          ;
 $F43C JR NC,$F440     ;
 $F43E LD A,$02        ;
*$F440 DEC A           ;
 $F441 LD ($7555),A    ; }
 $F444 LD IX,($7552)   ; IX = island record under the helicopter
 $F448 LD B,(IX+$0B)   ; {Island's map origin
 $F44B LD C,(IX+$0A)   ; }
 $F44E LD A,($7502)    ; {Map row = Y + 14 - origin Y ...
 $F451 ADD A,$0E       ;
 $F453 LD L,(IX+$08)   ;
 $F456 SUB L           ;
 $F457 LD L,A          ;
 $F458 LD H,$00        ; }
 $F45A ADD HL,HL       ; {... * 128
 $F45B ADD HL,HL       ;
 $F45C ADD HL,HL       ;
 $F45D ADD HL,HL       ;
 $F45E ADD HL,HL       ;
 $F45F ADD HL,HL       ;
 $F460 ADD HL,HL       ;
 $F461 ADD HL,BC       ;
 $F462 LD B,$00        ; }
