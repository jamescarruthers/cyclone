 $5C80 DEFB $00,$5B,$21,$17,$C0,$40,$E0,$50,$21,$12,$21,$17,$03,$00,$00,$00
 $5C90 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
