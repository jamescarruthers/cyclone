; Ground-sampling and shadow work buffers
;
; Filled every loop by #R$7E10 and #R$7ADC. The 3x3 block of cells under/around
; the helicopter is buffer columns 10-12, rows 13-15 (centre = column 11, row
; 14 = the world tile under the helicopter). All 3x3 lists are column-major,
; bottom row first: index 3*c+k = column 10+c, row 15-k.
b$7A81 DEFB $00,$00,$00                                 ; {Raw map codes of the
 $7A84 DEFB $00,$00,$00                                 ; 3x3 block (before
 $7A87 DEFB $00,$00,$00                                 ; projection; include
                                                        ; aircraft tiles
                                                        ; $F6-$FE and sea
                                                        ; waves). $7A85 = tile
                                                        ; under the helicopter
                                                        ; (crate/survivor check
                                                        ; F3A3). Read by 8ACA
                                                        ; (landing check).}
 $7A8A DEFB $00                                         ; Unused
 $7A8B DEFB $00,$00,$00                                 ; {Terrain height level
 $7A8E DEFB $00,$00,$00                                 ; of each cell (0..17,
 $7A91 DEFB $00,$00,$00                                 ; units of 4 altitude
                                                        ; pixels; see #R$7AC1);
                                                        ; 0 for object tiles
