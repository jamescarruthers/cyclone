; Draw the HUD
;
; Draws the static instrument panel: attributes for columns 24-31 of rows 0-20
; (from 7200, 21 x 8 bytes) and for rows 22-23 (7148, 64 bytes); panel graphics
; for columns 24-31 of rows 0-14 from the tile map 7300 (15 x 8 codes, $FF =
; leave blank; tile n at 7400+8n): A S F T letters, bar scales, compass rose,
; three helicopter (lives) icons; the bottom two rows of text from 6848 (crate
; boxes, WIND FORCE, DANGER); BEWARE / AIRCRAFT (invisible until 91B4 colours
; them); the VIEW label; then falls into 8580 to print NORTH. Called at game
; start (5B06), every round start (83BA) and from E3C5.
c$84F4 LD DE,$5818   ; {Panel attributes, rows 0-20 (21 rows of 8)
 $84F7 LD HL,$7200   ;
 $84FA LD A,$15      ;
*$84FC LD BC,$0008   ;
 $84FF LDIR          ;
 $8501 EX DE,HL      ;
 $8502 LD BC,$0018   ;
 $8505 ADD HL,BC     ;
 $8506 EX DE,HL      ;
 $8507 DEC A         ;
 $8508 JR NZ,$84FC   ; }
 $850A LD DE,$5AC0   ; {Rows 22-23 attributes
 $850D LD HL,$7148   ;
 $8510 LD BC,$0040   ;
 $8513 LDIR          ; }
 $8515 LD DE,$4018   ; {Panel graphics: 15 rows x 8 cells of tile codes from
 $8518 LD HL,$7300   ; 7300
 $851B LD C,$0F      ;
*$851D LD B,$08      ;
*$851F LD A,(HL)     ;
 $8520 INC HL        ;
 $8521 CP $FF        ;
 $8523 JR Z,$8539    ;
 $8525 PUSH HL       ; }
 $8526 LD H,$74      ; {Tile bitmap at $7400 + 8 x code
 $8528 ADD A,A       ;
 $8529 ADD A,A       ;
 $852A ADD A,A       ;
 $852B LD L,A        ;
 $852C PUSH BC       ;
 $852D LD B,$08      ;
 $852F PUSH DE       ;
*$8530 LD A,(HL)     ;
 $8531 LD (DE),A     ;
 $8532 INC D         ;
 $8533 INC HL        ;
 $8534 DJNZ $8530    ;
 $8536 POP DE        ;
 $8537 POP BC        ;
 $8538 POP HL        ;
*$8539 INC DE        ;
 $853A DJNZ $851F    ; }
 $853C DEC DE        ; {Next character row (convert to a linear row address,
 $853D EX DE,HL      ; add 25 cells, convert back)
 $853E PUSH BC       ;
 $853F RR H          ;
 $8541 RR H          ;
 $8543 RR H          ;
 $8545 LD BC,$0019   ;
 $8548 ADD HL,BC     ;
 $8549 RL H          ;
 $854B RL H          ;
 $854D RL H          ;
 $854F POP BC        ;
 $8550 EX DE,HL      ;
 $8551 DEC C         ;
 $8552 JR NZ,$851D   ; }
 $8554 LD DE,$50C0   ; {Rows 22-23 text (64 characters from 6848)
 $8557 LD HL,$6848   ;
 $855A LD C,$40      ;
 $855C CALL $859A    ; }
 $855F LD DE,$5019   ; {"BEWARE" at row 16, column 25
 $8562 LD HL,$85B9   ;
 $8565 LD C,$06      ;
 $8567 CALL $859A    ; }
 $856A LD DE,$5038   ; {"AIRCRAFT" at row 17, column 24
 $856D LD HL,$85BF   ;
 $8570 LD C,$08      ;
 $8572 CALL $859A    ; }
 $8575 LD DE,$48BB   ; {VIEW label (glyphs $3C-$40) at row 13, column 27
 $8578 LD HL,$85C7   ;
 $857B LD C,$05      ;
 $857D CALL $859A    ; }

; Print the view direction box
;
; Entry 8580: NORTH with attribute $38. Entry 8582 (A preset): NORTH with
; attribute A. Entry 8585 (A, HL preset): the 5-character text at HL with
; attribute A. Sets the attributes of rows 13-14, columns 27-31 (the VIEW box)
; to A and prints the text at row 14, column 27, then falls into 859A.
;
; I:A attribute (entries 8582, 8585)
; I:HL text address (entry 8585)
c$8580 LD A,$38      ;
; This entry point is used by the routine at #R$80AA.
*$8582 LD HL,$85CC   ; Text NORTH
; This entry point is used by the routine at #R$80F9.
*$8585 LD DE,$48DB   ; {Row 14, column 27; 5 characters
 $8588 LD C,$05      ; }
 $858A LD IX,$59BB   ; {Colour rows 13 and 14, columns 27-31
 $858E LD B,$05      ;
*$8590 LD (IX+$00),A ;
 $8593 LD (IX+$20),A ;
 $8596 INC IX        ;
 $8598 DJNZ $8590    ; }

; Print a string in the main font
;
; Prints C characters from HL at screen address DE (left to right, character
; cells), using the 8x8 font at 6028 (character code n at 6028+8n). Used
; throughout the game, the map (8EC1...) and the menu/info screens.
;
; I:HL string
; I:DE screen address of the first cell
; I:C character count
; O:HL address after the string
c$859A LD A,(HL)     ;
 $859B INC HL        ;
 $859C PUSH HL       ;
 $859D PUSH BC       ;
 $859E LD L,A        ; {Glyph address = $6028 + 8 x code
 $859F LD H,$00      ;
 $85A1 ADD HL,HL     ;
 $85A2 ADD HL,HL     ;
 $85A3 ADD HL,HL     ;
 $85A4 LD BC,$6028   ;
 $85A7 ADD HL,BC     ; }
 $85A8 LD B,$08      ; {Copy 8 pixel lines
 $85AA PUSH DE       ;
*$85AB LD A,(HL)     ;
 $85AC LD (DE),A     ;
 $85AD INC D         ;
 $85AE INC HL        ;
 $85AF DJNZ $85AB    ;
 $85B1 POP DE        ;
 $85B2 POP BC        ;
 $85B3 POP HL        ;
 $85B4 INC DE        ;
 $85B5 DEC C         ;
 $85B6 JR NZ,$859A   ;
 $85B8 RET           ; }

; HUD texts
t$85B9 DEFM "BEWARE"            ; "BEWARE"
 $85BF DEFM "AIRCRAFT"          ; "AIRCRAFT"
 $85C7 DEFB $3C,$3D,$3E,$3F,$40 ; Glyph codes $3C-$40 of the main font, which
                                ; hold the VIEW label
 $85CC DEFM "NORTH"             ; "NORTH"

