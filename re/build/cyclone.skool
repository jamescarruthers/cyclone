; HUD panel character layout
;
; 15 rows x 8 bytes for columns 24-31 of rows 0-14, drawn by #R$84F4. Each byte
; is a HUD glyph number n (glyph at $7400+8*n: A/S/F/T bar headings, bar
; frames, compass rose, helicopter life icons...) or $FF = leave blank.
b$7300 DEFB $17,$FF,$18,$FF,$19,$FF,$1A,$FF
 $7308 DEFB $FF,$1B,$FF,$1B,$FF,$1B,$FF,$1B
 $7310 DEFB $FF,$1B,$FF,$1B,$FF,$1B,$FF,$1B
 $7318 DEFB $FF,$1B,$FF,$1B,$FF,$1B,$FF,$1B
 $7320 DEFB $FF,$1B,$FF,$1B,$FF,$1B,$FF,$1B
 $7328 DEFB $FF,$1B,$FF,$1B,$FF,$1B,$FF,$1B
 $7330 DEFB $FF,$1B,$FF,$FF,$FF,$FF,$FF,$FF
 $7338 DEFB $FF,$1B,$FF,$02,$03,$04,$03,$05
 $7340 DEFB $FF,$1B,$FF,$06,$07,$08,$09,$0A
 $7348 DEFB $FF,$FF,$FF,$0B,$0C,$0D,$0E,$0F
 $7350 DEFB $00,$01,$FF,$06,$10,$11,$12,$0A
 $7358 DEFB $FF,$FF,$FF,$13,$14,$15,$14,$16
 $7360 DEFB $00,$01,$FF,$FF,$FF,$FF,$FF,$FF
 $7368 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $7370 DEFB $00,$01,$FF,$FF,$FF,$FF,$FF,$FF

; Cyclone buffeting of the controls
;
; Called from the main loop (5B94) after the controls have been read (7FD6)
; when the heli-cyclone map distance #R$7550 is below 5 (level 1) or 6 (later
; levels; the CP operand at 5B93 is patched by 8321). Adds random control
; inputs to #R$7522 so the helicopter is thrown about; very close to the
; cyclone it forces DOWN+LEFT (a descending spin).
;
; A Cyclone distance (#R$7550), 0..5
;
; Random bits come from L of the RNG at $8B74 (each bit ~50%). dist 4..5: bits
; 1/3/4 (down, right, left) may be added; dist 2..3: bits 0/1/3/4 (also
; forward); dist 0..1: controls are replaced by $12 (down+left) and the turn
; timer is run down one extra step.
c$7378 LD B,A        ; Save the distance
 $7379 LD A,($7515)  ; {No effect while landed
 $737C CP $01        ;
 $737E RET Z         ; }
 $737F NOP           ; {Two NOPs (patched-out code)
 $7380 NOP           ;
 $7381 LD A,B        ; }
 $7382 CP $04        ; {Distance 4 or 5?
 $7384 JR C,$7392    ; }
 $7386 CALL $8B74    ; {RND
 $7389 LD A,L        ; }
 $738A AND $1A       ; Keep random down/right/left bits (mask $1A)
 $738C LD HL,$7522   ; {OR them into the control bits
 $738F OR (HL)       ;
 $7390 LD (HL),A     ;
 $7391 RET           ; }
*$7392 CP $02        ; {Distance 2 or 3?
 $7394 JR C,$73A2    ; }
 $7396 CALL $8B74    ; {RND
 $7399 LD A,L        ; }
 $739A AND $1B       ; {Random forward/down/right/left (mask $1B)
 $739C LD HL,$7522   ;
 $739F OR (HL)       ;
 $73A0 LD (HL),A     ;
 $73A1 RET           ; }
*$73A2 LD HL,$7521   ; {Distance 0 or 1: speed up a turn in progress
 $73A5 XOR A         ;
 $73A6 CP (HL)       ;
 $73A7 JR Z,$73AA    ; }
 $73A9 DEC (HL)      ; Decrement the turn timer if non-zero
*$73AA LD A,$12      ; {Force controls = down + turn left
 $73AC LD ($7522),A  ;
 $73AF RET           ; }

; Unused code fragment
;
; Never referenced (no caller found statically or during emulation). Bytes
; would be NOP / RET NZ / set the crash flag #R$7505 to 1 / RET.
u$73B0 NOP
 $73B1 RET NZ
 $73B2 LD A,$01
 $73B4 LD ($7505),A
 $73B7 RET

; South-view terrain pillar table, page $73 (8th pillar level), codes $B8-$FF
;
; Part of the south-view pillar tables $6C00-$73FF (see #R$7E10): byte
; $7300+code is the 8th (topmost) tile of the pillar drawn for map code 'code'
; in south view. Only codes $E4-$FF ever reach this level; $FF = end of pillar.
; (The bytes below $73B8 belong to the HUD layout table at $7300, outside this
; range.)
b$73B8 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ; {$FF: codes $B8-$E3 never have an
 $73C0 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ; 8th level
 $73C8 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ;
 $73D0 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ;
 $73D8 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ;
 $73E0 DEFB $FF,$FF,$FF,$FF                 ; }
 $73E4 DEFB $2D,$2E,$2D,$2E,$83,$83,$FF,$FF ; {8th-level pillar tiles for codes
 $73EC DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ; $E4-$FF ($FF = none)
 $73F4 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF ;
 $73FC DEFB $FF,$FF,$FF,$FF                 ; }

