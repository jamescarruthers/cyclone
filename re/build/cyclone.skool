                                    ; ISLAND ($7552) = $0000
 $761C DEFB $FF                     ; Per-life reset value ($FF = keep) of
                                    ; CRATES ($7554) = $FF
 $761D DEFB $00                     ; Per-life reset value ($FF = keep) of
                                    ; WINCH ($7555) = $00
