                                                        ; $30-$55:4, $56-$57:5,
                                                        ; $58-$88:6, $89-$8B:7,
                                                        ; $8C-$A4:8, $A5-$B1:9,
                                                        ; $B2-$C1:10,
                                                        ; $C2-$CF:11,
                                                        ; $D0-$D8:12,
                                                        ; $D9-$E3:13,
                                                        ; $E4-$EB:14,
                                                        ; $EC-$EF:15,
                                                        ; $F0-$F5:16,
                                                        ; $F6-$FE:17 (aircraft)
                                                        ; }
 $7AD4 DEFB $00,$00,$00,$00,$00,$00,$00,$00             ; Unused

; Sample the ground under the helicopter and draw its shadow
;
; Called from #R$7E10 (7F77) while the sprite tiles are being built, unless the
; helicopter has crashed. 1) Copies the already-projected codes of buffer
; columns 10-12, rows 15..5 to #R$7A9F. 2) Converts the 9 raw codes at #R$7A81
; into terrain levels (#R$7A8B, threshold table #R$7AC1) and shadow row offsets
; (#R$7A95). 3) Hides shadow cells that would be covered by nearer terrain. 4)
; Jumps to #R$7BB8 to draw the shadow.
;
; .
;
; Hiding rule (per column, offsets h15, h14, h13 without bit 7): the row-13
; cell is hidden if h13+2 < h15, or h13+1 < h14; the row-14 cell is hidden if
; h14+1 < h15. On equality the bit-7 flags (tile $18) decide.
c$7ADC LD HL,$F8B1     ; {Buffer column 10, row 15
 $7ADF LD DE,$7A9F     ;
 $7AE2 PUSH DE         ; }
 $7AE3 LD C,$03        ; 3 columns
*$7AE5 LD B,$0B        ; {11 rows each, bottom to top
*$7AE7 POP DE          ;
 $7AE8 LD A,(HL)       ;
 $7AE9 LD (DE),A       ;
 $7AEA INC DE          ;
 $7AEB PUSH DE         ; }
 $7AEC LD DE,$FFE9     ; {Up one buffer row (-23)
 $7AEF ADD HL,DE       ;
 $7AF0 DJNZ $7AE7      ; }
 $7AF2 LD DE,$00FE     ; {Next column, back to row 15 (+11*23+1)
 $7AF5 ADD HL,DE       ;
 $7AF6 DEC C           ;
 $7AF7 JR NZ,$7AE5     ;
 $7AF9 POP DE          ; }
 $7AFA LD IX,$7A8B     ; {IX = terrain levels, DE = raw codes
 $7AFE LD DE,$7A81     ;
 $7B01 LD B,$09        ; }
*$7B03 LD HL,$7AC1     ; {Level = number of thresholds <= code
 $7B06 LD A,(DE)       ;
 $7B07 LD C,$FF        ;
*$7B09 INC HL          ;
 $7B0A INC C           ;
 $7B0B CP (HL)         ;
 $7B0C JR NC,$7B09     ; }
 $7B0E LD (IX+$00),C   ; Store the level (0..17)
 $7B11 SRA C           ; {Shadow row offset = level/2
 $7B13 LD (IX+$0A),C   ; }
 $7B16 LD L,A          ; {First projected tile of this code (pillar page $63,
 $7B17 LD H,$63        ; or $6C in south view: operand at 7B18 patched by 80F9)
 $7B19 LD A,(HL)       ; }
 $7B1A CP $27          ; {Object tiles $17-$26 (trees, buildings, people...)?
 $7B1C JR NC,$7B2E     ;
 $7B1E CP $17          ;
 $7B20 JR C,$7B2E      ; }
 $7B22 CP $18          ; {Tile $18: flag it in the shadow offset
 $7B24 JR NZ,$7B2A     ;
 $7B26 SET 7,(IX+$0A)  ; }
*$7B2A LD (IX+$00),$00 ; {Objects have no collision height
*$7B2E INC IX          ;
 $7B30 INC DE          ;
 $7B31 DJNZ $7B03      ; }
 $7B33 LD IX,$7A95     ; {For each of the 3 columns: rows 15 (C), 14 (D), 13
 $7B37 LD B,$03        ; (A)
*$7B39 LD C,(IX+$00)   ;
 $7B3C RES 7,C         ;
 $7B3E LD D,(IX+$01)   ;
 $7B41 RES 7,D         ;
 $7B43 LD A,(IX+$02)   ;
 $7B46 RES 7,A         ; }
 $7B48 INC A           ; {Row 13 offset + 2 compared with row 15 offset
 $7B49 INC A           ;
 $7B4A CP C            ;
 $7B4B JR C,$7B73      ;
 $7B4D CP C            ;
 $7B4E JR NZ,$7B5E     ;
 $7B50 LD E,(IX+$00)   ;
 $7B53 BIT 7,E         ;
 $7B55 JR Z,$7B73      ;
 $7B57 LD E,(IX+$02)   ;
 $7B5A BIT 7,E         ;
 $7B5C JR NZ,$7B73     ; }
*$7B5E DEC A           ; {Row 13 offset + 1 compared with row 14 offset
 $7B5F CP D            ;
 $7B60 JR C,$7B73      ;
 $7B62 CP D            ;
 $7B63 JR NZ,$7B77     ;
 $7B65 LD E,(IX+$01)   ;
 $7B68 BIT 7,E         ;
 $7B6A JR Z,$7B73      ;
 $7B6C LD E,(IX+$02)   ;
 $7B6F BIT 7,E         ;
 $7B71 JR Z,$7B77      ; }
*$7B73 LD (IX+$02),$FF ; Hide the row-13 shadow cell
*$7B77 LD A,D          ; {Row 14 offset + 1 compared with row 15 offset
 $7B78 INC A           ;
 $7B79 CP C            ;
 $7B7A JR C,$7B8D      ;
 $7B7C CP C            ;
 $7B7D JR NZ,$7B91     ;
 $7B7F LD E,(IX+$00)   ;
 $7B82 BIT 7,E         ;
 $7B84 JR Z,$7B8D      ;
 $7B86 LD E,(IX+$01)   ;
 $7B89 BIT 7,E         ;
 $7B8B JR Z,$7B91      ; }
*$7B8D LD (IX+$01),$FF ; {Hide the row-14 shadow cell
*$7B91 INC IX          ;
 $7B93 INC IX          ;
 $7B95 INC IX          ;
 $7B97 DJNZ $7B39      ; }
 $7B99 JP $7BB8        ; Draw the shadow

; Unused
u$7B9C DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Zero bytes
 $7BA4 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $7BAC DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $7BB4 DEFB $00,$00,$00,$00                 ; }

; Draw the helicopter's shadow into the sprite tiles
;
; The shadow sprite (3x3 cells, frame #R$7507, +8 mod 16 in south view; data at
; $EDB0+72*frame, cell order column-major bottom-up, first byte $FF = empty
; cell) is drawn into the graphics of the sprite tiles $5F-$7F (built by
; #R$7E10 at $FCF8-$FDFF, attributes $FE5F-$FE7F). Each shadow cell (column
; 10+c, row 15-k) is raised by its ground offset h (#R$7A95), i.e. drawn into
; the sprite tile h rows higher, so the shadow lies on the terrain. The tile
; already displayed there (from #R$7A9F) decides how: < $17 flat ground: the
; cell is replaced by the shadow and its INK set to black; $17-$26 objects: the
; shadow is masked by mask tiles $23-$26 ($FB18-$FB37) and may continue into
; the tile below; $27-$2F: shadow ORed in, INK black; >= $30: not drawn
; (hidden). Offsets >= 8 (aircraft) draw at the base cell with attribute $68.
c$7BB8 LD HL,$7A9F   ; {Column list pointer
 $7BBB LD ($7510),HL ; }
 $7BBE LD HL,$FD48   ; {Graphic of sprite tile $69 (column 10, row 15)
 $7BC1 LD ($7509),HL ; }
 $7BC4 LD HL,$FE69   ; {Attribute of sprite tile $69
 $7BC7 LD ($750B),HL ; }
 $7BCA LD HL,$ED68   ; {Shadow frames base ($ED68 + 72*(frame+1))
 $7BCD LD A,($7507)  ;
 $7BD0 LD B,A        ;
 $7BD1 LD A,($7504)  ;
 $7BD4 CP $00        ;
 $7BD6 JR Z,$7BDE    ; }
 $7BD8 LD A,$08      ; {South view: frame + 8 (mod 16)
 $7BDA ADD A,B       ;
 $7BDB RES 4,A       ;
 $7BDD LD B,A        ;
*$7BDE INC B         ;
 $7BDF LD DE,$0048   ;
*$7BE2 ADD HL,DE     ;
 $7BE3 DJNZ $7BE2    ; }
 $7BE5 LD ($750E),HL ; Shadow cell pointer
 $7BE8 LD DE,$7A95   ; Shadow offsets of the 9 cells
 $7BEB LD C,$03      ; {3 columns of 3 cells
*$7BED LD B,$03      ;
*$7BEF PUSH BC       ;
 $7BF0 PUSH DE       ;
 $7BF1 LD HL,($750E) ; }
