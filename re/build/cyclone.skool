 $8C6A DEFB $FF,$00
 $8C6C DEFB $FF,$FF
 $8C6E DEFB $00,$FF
 $8C70 DEFB $01,$FF
 $8C72 DEFB $01,$00
 $8C74 DEFB $01,$01
 $8C76 DEFB $00

; Wave phase steps, view south
