; As 8C66 but negated (view rotated 180 degrees).
b$8C77 DEFB $00,$FF
 $8C79 DEFB $01,$FF
 $8C7B DEFB $01,$00
 $8C7D DEFB $01,$01
 $8C7F DEFB $00,$01
 $8C81 DEFB $FF,$01
 $8C83 DEFB $FF,$00
 $8C85 DEFB $FF,$FF

