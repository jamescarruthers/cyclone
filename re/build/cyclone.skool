; Terrain character attributes
;
; Attribute of character code c at $FE00+c (view blitter $762C: LD H,$FE / LD
; L,code). $FE5F-$FE7F hold the attributes of the dynamic glyphs (rebuilt at
; run time, 0 at load); $FE80-$FE91 the colours of the solid blocks $80-$91
; (e.g. $87 green, $89/$83 landing pad).
b$FE00 DEFB $6F,$6F,$6F,$6E,$6E,$6E,$6E,$74,$74,$74,$74,$7C,$7C,$7C,$7C,$66
 $FE10 DEFB $75,$75,$75,$75,$75,$75,$00,$24,$24,$6C,$6C,$60,$60,$68,$68,$60
 $FE20 DEFB $60,$60,$60,$60,$60,$60,$60,$60,$60,$60,$60,$60,$60,$50,$50,$50
 $FE30 DEFB $70,$60,$60,$68,$68,$68,$68,$68,$68,$68,$68,$68,$68,$68,$68,$68
 $FE40 DEFB $68,$68,$68,$68,$68,$20,$68,$20,$38,$68,$60,$60,$60,$60,$60,$60
 $FE50 DEFB $60,$60,$60,$30,$30,$62,$60,$38,$38,$38,$38,$60,$60,$60,$60
 $FE5F DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Dynamic
 $FE6F DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; glyph
 $FE7F DEFB $00                                                             ; attributes
                                                                            ; }
 $FE80 DEFB $6D,$64,$76,$7F,$52,$5B,$6D,$24,$36,$3F,$12,$1B,$49,$09,$40,$00 ; {Solid
 $FE90 DEFB $00,$00                                                         ; block
                                                                            ; colours
                                                                            ; ($80-$91)}

; Jump to the crate shuffle
;
; Written by #R$F74E over the loader's LD DE,$9EB6. Called by #R$5B2C and the
; menu loop #R$E29E.
@label=ShuffleVector
c$FE92 JP $5EEC      ;

; Unused remnant of the tape loader
;
; Part of the original turbo loader (#R$FE98 is the old continuation). Never
; executed.
c$FE95 CALL $FE9F    ;

; Program entry point (RANDOMIZE USR 65176)
;
; The BASIC loader loads the screen ("Cyclone2"), this 512-byte block at $FE00
; ("Cyclone4") and the main block at $5FDC-$FE91 ("Cyclone3", which overwrites
; $FE00-$FE91) with the ROM, then calls here. In the original loader block
; $FE00 decrypted $FE80-$FFFF (XOR with R) and $FE80 loaded the screen and the
; main block with its own LD-BYTES at $FE9F before falling into this code; that
; path is not used by this version.
@label=Entry
c$FE98 LD SP,$FEFF   ;
 $FE9B EI            ;
 $FE9C JP $F74E      ;

; Unused remnant of the tape loader's LD-BYTES routine
;
; A copy of the ROM's LD-BYTES ($0556) used by the original turbo loader; its
; second half ($FF00+) has been overwritten by the IM2 table. Never executed.
; The stack (SP=$FEFF) grows down into its last bytes (observed $FEE5-$FEFE in
; use).
c$FE9F XOR A         ;
 $FEA0 SCF           ;
 $FEA1 INC D         ;
 $FEA2 EX AF,AF'     ;
 $FEA3 DEC D         ;
 $FEA4 DI            ;
 $FEA5 LD A,$08      ;
 $FEA7 OUT ($FE),A   ;
 $FEA9 LD HL,$FF49   ;
 $FEAC PUSH HL       ;
 $FEAD IN A,($FE)    ;
 $FEAF RRA           ;
 $FEB0 AND $20       ;
 $FEB2 OR $00        ;
 $FEB4 LD C,A        ;
 $FEB5 CP A          ;
*$FEB6 RET NZ        ;
*$FEB7 CALL $FF2B    ;
 $FEBA JR NC,$FEB6   ;
 $FEBC LD HL,$0415   ;
*$FEBF DJNZ $FEBF    ;
 $FEC1 DEC HL        ;
 $FEC2 LD A,H        ;
 $FEC3 OR L          ;
 $FEC4 JR NZ,$FEBF   ;
 $FEC6 CALL $FF27    ;
 $FEC9 JR NC,$FEB6   ;
*$FECB LD B,$9C      ;
 $FECD CALL $FF27    ;
 $FED0 JR NC,$FEB6   ;
 $FED2 LD A,$C6      ;
 $FED4 CP B          ;
 $FED5 JR NC,$FEB7   ;
 $FED7 INC H         ;
 $FED8 JR NZ,$FECB   ;
*$FEDA LD B,$C9      ;
 $FEDC CALL $FF2B    ;
 $FEDF JR NC,$FEB6   ;
 $FEE1 LD A,B        ;
 $FEE2 CP $D4        ;
 $FEE4 JR NC,$FEDA   ;
 $FEE6 CALL $FF2B    ;
 $FEE9 RET NC        ;
 $FEEA LD A,C        ;
 $FEEB XOR $00       ;
 $FEED LD C,A        ;
 $FEEE LD H,$00      ;
 $FEF0 LD B,$75      ;
 $FEF2 JR $FF0C      ;
 $FEF4 EX AF,AF'     ;
 $FEF5 JR NZ,$FEFC   ;
 $FEF7 LD (IX+$00),L ;
 $FEFA JR $FF06      ;
*$FEFC RL C          ;
 $FEFE XOR L         ;
 $FEFF RET NZ        ;

; IM2 vector table
;
; 256 bytes of $F3 (written by #R$F74E). With I=$FF the CPU reads the vector
; from $FFxx/$FFxx+1, always $F3F3 (for bus value $FF the second byte is $0000
; in ROM, also $F3), which holds JP $83C2 (#R$F3F3).
b$FF00 DEFB $F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3,$F3
