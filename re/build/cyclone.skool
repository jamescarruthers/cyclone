; Initialisation
;
; Jumped to from the loader entry #R$FE98 after the tape has loaded. Copies the
; main-loop code to the printer buffer (#R$F78A -> #R$5B00, 255 bytes) and the
; crate shuffle to #R$5EEC (#R$F88A, 232 bytes), writes JP $5EEC at #R$FE92,
; fills the IM2 vector table $FF00-$FFFF with $F3 (vector $F3F3 for any data
; bus value, incl. $FFFF/$0000 = $F3 $F3 from the ROM), sets I=$FF and IM 2 and
; enters the main menu. After this runs, the area from here to $F9FF is reused
; as the view buffer, so this code and the two source copies are overwritten
; during play.
@label=Init
c$F74E DI            ;
 $F74F LD HL,$F78A   ;
 $F752 LD DE,$5B00   ;
 $F755 LD BC,$00FF   ;
 $F758 LDIR          ;
 $F75A LD HL,$F88A   ;
 $F75D LD DE,$5EEC   ;
 $F760 LD BC,$00E8   ;
 $F763 LDIR          ;
 $F765 LD HL,$FE92   ; {FE92: JP $5EEC
 $F768 LD (HL),$C3   ;
 $F76A INC HL        ;
 $F76B LD (HL),$EC   ;
 $F76D INC HL        ;
 $F76E LD (HL),$5E   ; }
 $F770 LD HL,$FF00   ; {256 bytes of $F3 (B=0)
 $F773 LD BC,$00F3   ;
*$F776 LD (HL),C     ;
 $F777 INC HL        ;
 $F778 DJNZ $F776    ;
 $F77A LD A,$FF      ;
 $F77C LD I,A        ;
 $F77E IM 2          ;
 $F780 EI            ;
 $F781 JP $E280      ; }

