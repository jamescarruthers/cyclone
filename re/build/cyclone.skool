; Build the helicopter sprite (with rotor) in 6950
;
; Called every main-loop iteration (5B48) and for the first 3 steps of the
; death sequence. Copies the 72-byte (9 character, 3x3) helicopter graphic for
; sprite frame 7507 from E930+72*frame to the sprite buffer 6950-6997, then
; XORs one of the rotor overlays onto it. 86AF later draws 6950 into the view.
;
; I:(7507) displayed sprite heading frame 0-15 (moves one step at a time
; .        towards 7508)
; I:(7504) view 0 north / 1 south
; I:(7515) landed flag; (7516) fuel-empty flag
; I:(753A) rotor animation frame
;
; Frame used = 7507 (view north) or (7507+8) mod 16 (view south). For frames
; 10-15 the instruction at 8D02 becomes ADD A,A so the rotor overlay is shifted
; one pixel left (mirror-side frames). Rotor overlays (72 bytes each, XORed):
; flying: $7000+256*f, f = 753A cycling 0,1 (2-frame fast rotor); landed or out
; of fuel: $6700+256*f, f cycling 0,1,2,3 (4-frame slow rotor). (OBSERVED: 753A
; cycles 1,2,3,0 while landed, 0,1 in flight.)
c$8CA0 LD A,($7507)  ; {B = sprite frame
 $8CA3 LD B,A        ; }
 $8CA4 LD A,($7504)  ; {South view: frame = (frame+8) AND 15 (RES 4)
 $8CA7 CP $00        ;
 $8CA9 JR Z,$8CB1    ;
 $8CAB LD A,$08      ;
 $8CAD ADD A,B       ;
 $8CAE RES 4,A       ;
 $8CB0 LD B,A        ; }
*$8CB1 LD HL,$8D02   ; {Frames 0-9: NOP at 8D02; frames 10-15: ADD A,A ($87) at
 $8CB4 LD (HL),$00   ; 8D02
 $8CB6 LD A,$09      ;
 $8CB8 CP B          ;
 $8CB9 JR NC,$8CBD   ;
 $8CBB LD (HL),$87   ; }
*$8CBD LD HL,$E8E8   ; {HL = E8E8 + 72*(frame+1) = E930 + 72*frame
 $8CC0 INC B         ;
 $8CC1 LD DE,$0048   ;
*$8CC4 ADD HL,DE     ;
 $8CC5 DJNZ $8CC4    ; }
 $8CC7 LD DE,$6950   ; {Copy the 72-byte graphic to 6950
 $8CCA LD BC,$0048   ;
 $8CCD LDIR          ; }
 $8CCF LD DE,$7000   ; Rotor overlay page: $70 (flying)...
 $8CD2 LD A,($7515)  ; {...or $67 if landed or out of fuel, with a 4-frame
 $8CD5 CP $01        ; cycle
 $8CD7 JR Z,$8CE0    ;
 $8CD9 LD A,($7516)  ;
 $8CDC CP $00        ;
 $8CDE JR Z,$8CEE    ;
*$8CE0 LD DE,$6700   ;
 $8CE3 LD A,($753A)  ;
 $8CE6 INC A         ;
 $8CE7 CP $04        ;
 $8CE9 JR C,$8CF7    ;
 $8CEB XOR A         ;
 $8CEC JR $8CF7      ; }
*$8CEE LD A,($753A)  ; {Flying: 2-frame cycle
 $8CF1 INC A         ;
 $8CF2 CP $02        ;
 $8CF4 JR C,$8CF7    ;
 $8CF6 XOR A         ;
*$8CF7 LD ($753A),A  ; }
 $8CFA ADD A,D       ; {DE = (page+frame)*256
 $8CFB LD D,A        ;
 $8CFC LD HL,$6950   ;
 $8CFF LD B,$48      ; }
*$8D01 LD A,(DE)     ; XOR 72 overlay bytes onto the sprite buffer
 $8D02 NOP           ; {Self-modified: NOP, or ADD A,A (shift overlay left) for
 $8D03 XOR (HL)      ; frames 10-15
 $8D04 LD (HL),A     ;
 $8D05 INC HL        ;
 $8D06 INC DE        ;
 $8D07 DJNZ $8D01    ;
 $8D09 RET           ; }

; Unused
u$8D0A DEFB $00,$00,$00,$00

; Clear the view window
;
; Used at game start (5B03) and when the map screen is entered (5B78). Sets the
; 23x22-cell view window (columns 0-22, rows 0-21) to attribute $3F (white on
; white), clears its bitmap, then sets the inner 21x20 cells (columns 1-21,
; rows 1-20) to $7C (bright white paper, green ink: map land colour).
c$8D0E LD HL,$5800   ; {22 rows x 23 attributes = $3F
 $8D11 LD C,$16      ;
 $8D13 LD DE,$0009   ;
*$8D16 LD B,$17      ;
*$8D18 LD (HL),$3F   ;
 $8D1A INC HL        ;
 $8D1B DJNZ $8D18    ;
 $8D1D ADD HL,DE     ;
 $8D1E DEC C         ;
 $8D1F JR NZ,$8D16   ; }
 $8D21 LD HL,$4000   ; {Clear 22 rows x 23 columns x 8 pixel lines of bitmap
 $8D24 LD C,$16      ;
*$8D26 LD B,$17      ;
*$8D28 PUSH BC       ;
 $8D29 PUSH HL       ;
 $8D2A LD B,$08      ;
*$8D2C LD (HL),$00   ;
 $8D2E INC H         ;
 $8D2F DJNZ $8D2C    ;
 $8D31 POP HL        ;
 $8D32 POP BC        ;
 $8D33 INC HL        ;
 $8D34 DJNZ $8D28    ; }
 $8D36 RR H          ; {Next character row (screen address arithmetic via
 $8D38 RR H          ; rotation of H)
 $8D3A RR H          ;
 $8D3C LD DE,$0009   ;
 $8D3F ADD HL,DE     ;
 $8D40 RL H          ;
 $8D42 RL H          ;
 $8D44 RL H          ;
 $8D46 DEC C         ;
 $8D47 JR NZ,$8D26   ; }
 $8D49 LD HL,$5821   ; {Inner 20 rows x 21 columns = $7C
 $8D4C LD C,$14      ;
 $8D4E LD DE,$000B   ;
*$8D51 LD B,$15      ;
*$8D53 LD (HL),$7C   ;
 $8D55 INC HL        ;
 $8D56 DJNZ $8D53    ;
 $8D58 ADD HL,DE     ;
 $8D59 DEC C         ;
 $8D5A JR NZ,$8D51   ;
 $8D5C RET           ; }

; Map screen: draw the island shapes
;
; Used when the map screen is entered (5B7B), after 8D0E. For each of the 14
; island records at F230 (20 bytes each, list ends with $FF) it renders the
; island's heightmap at 1/4 scale: one map pixel per 4x4 world units, pixel set
; if the sampled height byte is >= $0F. Falls through into 8DE2 to print the
; names.
;
; I:F230 island table: +0A/+0B heightmap base, +0C/+0D map bitmap address
; .      (top-left), +0E width in pixels, +0F height in pixel rows
;
; Heightmap format expected (same as the view builder 775E/7789): one byte per
; world unit, 128 bytes per world row, i.e. byte for (x,y) = base + 128*(y-y0)
; + (x-x0). The map samples pixel (px,py) at base + $102 + 4*px + $200*py, i.e.
; world offset (2+4*px, 2+4*py). Only the low byte is stepped (INC L x4), so a
; row must not cross a 256-byte page. Pixels are packed MSB first, 8 per screen
; byte; a final partial byte is padded with zero bits. 753C = start of current
; pixel row on screen, 753E = write pointer.
c$8D5D LD IX,$F230   ; IX = first island record
*$8D61 LD L,(IX+$0C) ; {753C = 753E = bitmap address of the island's top-left
 $8D64 LD H,(IX+$0D) ; pixel
 $8D67 LD ($753C),HL ;
 $8D6A LD ($753E),HL ; }
 $8D6D LD L,(IX+$0A) ; {HL = heightmap base + $102 (2 world units in from the
 $8D70 LD H,(IX+$0B) ; top-left corner)
 $8D73 INC H         ;
 $8D74 INC HL        ;
 $8D75 INC HL        ; }
 $8D76 LD D,(IX+$0F) ; {D = pixel rows, E = pixels per row
*$8D79 LD E,(IX+$0E) ;
 $8D7C PUSH HL       ; }
*$8D7D LD B,$08      ; {Build one screen byte from up to 8 samples
 $8D7F LD C,$00      ;
*$8D81 SLA C         ; }
 $8D83 LD A,(HL)     ; {Height >= $0F: land pixel
 $8D84 CP $0F        ;
 $8D86 JR C,$8D8A    ;
 $8D88 SET 0,C       ; }
*$8D8A INC L         ; {Next sample 4 bytes (4 world units) to the right
 $8D8B INC L         ;
 $8D8C INC L         ;
 $8D8D INC L         ; }
 $8D8E XOR A         ; {Row finished? Then pad the byte with zero bits
 $8D8F CP E          ;
 $8D90 JR Z,$8D99    ;
 $8D92 DEC E         ;
 $8D93 DJNZ $8D81    ;
 $8D95 JR $8D9B      ;
*$8D97 SLA C         ;
*$8D99 DJNZ $8D97    ; }
*$8D9B PUSH HL       ; {Store the byte and advance the screen pointer
 $8D9C LD HL,($753E) ;
 $8D9F LD (HL),C     ;
 $8DA0 INC HL        ;
 $8DA1 LD ($753E),HL ;
 $8DA4 POP HL        ; }
 $8DA5 XOR A         ; {Loop until the row is complete
 $8DA6 CP E          ;
 $8DA7 JR NZ,$8D7D   ; }
 $8DA9 LD HL,($753C) ; {Move 753C down one pixel line (handling character-row
 $8DAC LD A,H        ; boundaries)
 $8DAD AND $07       ;
 $8DAF CP $07        ;
 $8DB1 JR NZ,$8DC8   ;
 $8DB3 LD A,H        ;
 $8DB4 AND $F8       ;
 $8DB6 LD H,A        ;
 $8DB7 RR H          ;
 $8DB9 RR H          ;
 $8DBB RR H          ;
 $8DBD LD BC,$0020   ;
 $8DC0 ADD HL,BC     ;
 $8DC1 RL H          ;
 $8DC3 RL H          ;
 $8DC5 RL H          ;
 $8DC7 DEC H         ;
*$8DC8 INC H         ;
 $8DC9 LD ($753C),HL ;
 $8DCC LD ($753E),HL ; }
 $8DCF POP HL        ; {Next sample row: 4 world rows down (2 pages)
 $8DD0 INC H         ;
 $8DD1 INC H         ;
 $8DD2 DEC D         ;
 $8DD3 JR NZ,$8D79   ; }
 $8DD5 LD BC,$0014   ; {Next island record
 $8DD8 ADD IX,BC     ;
 $8DDA LD A,(IX+$00) ;
 $8DDD CP $FF        ;
 $8DDF JR NZ,$8D61   ; }
 $8DE1 NOP           ; Fall through to print the names

; Print island names (4-pixel-wide font)
;
; Prints the island names on the map in a half-width font, two characters per
; screen cell, black on bright white. Entry 8DE2 sets IX=F230, record stride 20
; and the text pointer 6A4F; entry 8DEE is also used by the info screen (E446)
; with its own IX table (E68C), stride 3 (written to 8E0A) and text (E517).
;
; I:(IX+$10/$11) screen address one cell left of where the text starts;
; .              (IX+$12) attribute-file high byte ($58/$59/$5A) for that row
;
; Text format (6A50-6AC9 for the map): ASCII bytes, with '?' ($3F) used as the
; space character. $FE = end of this name, move to the next record; $FD =
; append the shared suffix at 6AC2 ("?ISLAND", i.e. " ISLAND") which itself
; ends with $FC = return from suffix and move to the next record; $FF = end of
; all text. Glyphs: 8 bytes per character at 6908+8*code (only the left 4
; pixels are used); even-numbered characters are copied into the next cell (and
; its attribute set to $78), odd-numbered characters are shifted right 4 pixels
; and ORed into the same cell. Map name order follows F230: BANANA, ORTE ROCKS,
; KOKOLA, LAGOON, PEAK, BASE, GILLIGANS, RED, SKEG, BONE, GIANTS GATEWAY, CLAW,
; LUKELAND ISLES, ENTERPRISE (ISLAND appended except for ORTE ROCKS, GIANTS
; GATEWAY, LUKELAND ISLES).
c$8DE2 LD IX,$F230   ; {Map: island records at F230, stride 20 (operand at
 $8DE6 LD A,$14      ; 8E0A), text at 6A50
 $8DE8 LD ($8E0A),A  ;
 $8DEB LD HL,$6A4F   ; }
; This entry point is used by the routine at #R$E43A.
*$8DEE LD E,(IX+$10) ; {DE = name position (one cell to the left), C =
 $8DF1 LD D,(IX+$11) ; character counter
 $8DF4 DEC E         ;
 $8DF5 LD C,$00      ; }
*$8DF7 INC HL        ; {Next text byte
 $8DF8 LD A,(HL)     ;
 $8DF9 CP $FC        ;
 $8DFB JR C,$8E15    ; }
 $8DFD CP $FF        ; {$FF: finished
 $8DFF RET Z         ; }
 $8E00 CP $FE        ; {$FE: next record
 $8E02 JR Z,$8E09    ; }
 $8E04 CP $FD        ; {$FD: switch to the suffix text at 6AC2
 $8E06 JR Z,$8E10    ; }
 $8E08 POP HL        ; $FC: end of suffix: restore the main text pointer and go
                     ; to the next record
*$8E09 LD BC,$0014   ; {IX += stride (operand at 8E0A is self-modified: 20 for
 $8E0C ADD IX,BC     ; the map, 3 for the info screen)
 $8E0E JR $8DEE      ; }
*$8E10 PUSH HL       ; {Push the main text pointer and read the suffix from
 $8E11 LD HL,$6AC2   ; 6AC2 onwards
 $8E14 LD A,(HL)     ; }
*$8E15 PUSH HL       ; {HL = 6908 + 8*code (glyph)
 $8E16 PUSH BC       ;
 $8E17 LD BC,$6908   ;
 $8E1A LD L,A        ;
 $8E1B LD H,$00      ;
 $8E1D ADD HL,HL     ;
 $8E1E ADD HL,HL     ;
 $8E1F ADD HL,HL     ;
 $8E20 ADD HL,BC     ;
 $8E21 POP BC        ;
 $8E22 PUSH BC       ; }
 $8E23 BIT 0,C       ; {Odd character: OR the glyph shifted right 4 pixels into
 $8E25 JR Z,$8E3D    ; the current cell
 $8E27 PUSH DE       ;
 $8E28 LD B,$08      ;
 $8E2A EX DE,HL      ;
*$8E2B LD A,(DE)     ;
 $8E2C SRL A         ;
 $8E2E SRL A         ;
 $8E30 SRL A         ;
 $8E32 SRL A         ;
 $8E34 OR (HL)       ;
 $8E35 LD (HL),A     ;
 $8E36 INC DE        ;
 $8E37 INC H         ;
 $8E38 DJNZ $8E2B    ;
 $8E3A EX DE,HL      ;
 $8E3B JR $8E4D      ; }
*$8E3D INC DE        ; {Even character: move to the next cell and copy the
 $8E3E PUSH DE       ; glyph
 $8E3F LD B,$08      ;
*$8E41 LD A,(HL)     ;
 $8E42 LD (DE),A     ;
 $8E43 INC HL        ;
 $8E44 INC D         ;
 $8E45 DJNZ $8E41    ; }
 $8E47 LD D,(IX+$12) ; {Set the cell's attribute to $78
 $8E4A LD A,$78      ;
 $8E4C LD (DE),A     ;
*$8E4D POP DE        ;
 $8E4E POP BC        ;
 $8E4F POP HL        ; }
 $8E50 INC C         ; {Next character
 $8E51 JR $8DF7      ; }

; Unused
u$8E53 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00

; Map screen: draw frame and north indicator
;
; Used when the map screen is entered (5B7E). Draws the frame around the 23x22
; map using 8-byte characters from the HUD graphics at 7438-7497, then a
; 3-character north arrow at column 20, rows 17-19 (codes $4E 'N', $29, $2A
; from 8F0C in the main font at 6028) with attributes $78.
;
; .
;
; Frame pieces: 7438 top-left (row 0,col 0), 7440 x21 top edge, 7448 top-right
; (col 22); 7480 bottom-left (row 21), 7488 x21 bottom edge, 7490 bottom-right;
; 7460 x20 left edge (rows 1-20, col 0); 7470 x20 right edge (col 22).
c$8E5C LD IX,$7438   ;
 $8E60 LD DE,$4000   ;
 $8E63 LD HL,$0001   ;
 $8E66 LD C,$01      ;
 $8E68 CALL $8EE8    ;
 $8E6B LD IX,$7440   ;
 $8E6F LD C,$15      ;
 $8E71 CALL $8EE8    ;
 $8E74 LD IX,$7448   ;
 $8E78 LD C,$01      ;
 $8E7A CALL $8EE8    ;
 $8E7D LD IX,$7480   ;
 $8E81 LD DE,$50A0   ;
 $8E84 LD C,$01      ;
 $8E86 CALL $8EE8    ;
 $8E89 LD IX,$7488   ;
 $8E8D LD C,$15      ;
 $8E8F CALL $8EE8    ;
 $8E92 LD IX,$7490   ;
 $8E96 LD C,$01      ;
 $8E98 CALL $8EE8    ;
 $8E9B LD IX,$7460   ;
 $8E9F LD DE,$4020   ;
 $8EA2 LD HL,$0020   ;
 $8EA5 LD C,$14      ;
 $8EA7 CALL $8EE8    ;
 $8EAA LD IX,$7470   ;
 $8EAE LD DE,$4036   ;
 $8EB1 LD HL,$0020   ;
 $8EB4 LD C,$14      ;
 $8EB6 CALL $8EE8    ;
 $8EB9 LD DE,$5034   ;
 $8EBC LD HL,$8F0C   ;
 $8EBF LD C,$01      ;
 $8EC1 CALL $859A    ;
 $8EC4 LD DE,$5054   ;
 $8EC7 LD HL,$8F0D   ;
 $8ECA LD C,$01      ;
 $8ECC CALL $859A    ;
 $8ECF LD DE,$5074   ;
 $8ED2 LD HL,$8F0E   ;
 $8ED5 LD C,$01      ;
 $8ED7 CALL $859A    ;
 $8EDA LD HL,$5A34   ;
 $8EDD LD A,$78      ;
 $8EDF LD BC,$0020   ;
 $8EE2 LD (HL),A     ;
 $8EE3 ADD HL,BC     ;
 $8EE4 LD (HL),A     ;
 $8EE5 ADD HL,BC     ;
 $8EE6 LD (HL),A     ;
 $8EE7 RET           ;

; Draw a character C times
;
; Copies the 8-byte character at IX to screen address DE, C times, advancing DE
; by HL each time (HL=1: next column, HL=$20: next character row; also $40 from
; the info screen). Used by 8E5C and the info screen (E4C2-E4D2).
;
; I:IX 8-byte character
; I:DE screen address
; I:HL step (in character cells; 32 = one row down)
; I:C repeat count
; O:DE address after the last character
c$8EE8 PUSH IX       ;
 $8EEA PUSH DE       ;
 $8EEB LD B,$08      ;
*$8EED LD A,(IX+$00) ;
 $8EF0 LD (DE),A     ;
 $8EF1 INC D         ;
 $8EF2 INC IX        ;
 $8EF4 DJNZ $8EED    ;
 $8EF6 POP DE        ;
 $8EF7 EX DE,HL      ; {DE += HL using the 'linear' form of the screen address
 $8EF8 RR H          ; (H rotated right 3 times) so that +32 crosses character
 $8EFA RR H          ; rows and thirds correctly
 $8EFC RR H          ;
 $8EFE ADD HL,DE     ;
 $8EFF RL H          ;
 $8F01 RL H          ;
 $8F03 RL H          ;
 $8F05 EX DE,HL      ;
 $8F06 POP IX        ;
 $8F08 DEC C         ;
 $8F09 JR NZ,$8EE8   ;
 $8F0B RET           ; }

; Map north-indicator characters
;
; Font codes printed by 8E5C at rows 17, 18 and 19 of column 20: 'N', arrow
; shaft/head ($29), arrow tail ($2A). 8F0F-8F11 unused.
b$8F0C DEFB $4E,$29,$2A
 $8F0F DEFB $00,$00,$00

; Map screen: per-iteration update (blinking markers)
;
; Called by the main loop instead of 762C/9034 while the map screen is shown
; (7526 bit 1). Wastes about 132,000 T-states (about 1.9 frames), then blinks
; the helicopter and cyclone markers with a 7-call cycle using counter 7542:
; calls 1-3 just update positions (9034), calls 4-6 remove the markers, call 7
; resets the counter, updates positions and redraws the markers at their new
; cells (8F6A). OBSERVED: one map-mode iteration takes about 5.7 frames, so a
; blink cycle lasts about 40 frames.
c$8F12 LD C,$28      ; {Delay loop: 40 x 255 DJNZ
*$8F14 LD B,$FF      ;
*$8F16 DJNZ $8F16    ;
 $8F18 DEC C         ;
 $8F19 JR NZ,$8F14   ; }
 $8F1B LD HL,$7542   ; {7542 = 7542+1; 1..3: positions only
 $8F1E INC (HL)      ;
 $8F1F LD A,$03      ;
 $8F21 CP (HL)       ;
 $8F22 JP NC,$9034   ; }
 $8F25 LD A,($9027)  ; {Remove the helicopter marker: restore its attribute (a
 $8F28 LD HL,($7543) ; saved $3F frame attribute is restored as $3A instead;
 $8F2B CP $3F        ; never seen)
 $8F2D JR NZ,$8F31   ;
 $8F2F LD A,$3A      ;
*$8F31 LD (HL),A     ; }
 $8F32 LD A,($9030)  ; {Restore the cyclone marker's attribute
 $8F35 LD HL,($7547) ;
 $8F38 LD (HL),A     ; }
 $8F39 LD DE,$901F   ; {Restore the 8 bitmap bytes under the helicopter marker
 $8F3C LD HL,($7545) ;
 $8F3F LD B,$08      ;
*$8F41 LD A,(DE)     ;
 $8F42 LD (HL),A     ;
 $8F43 INC DE        ;
 $8F44 INC H         ;
 $8F45 DJNZ $8F41    ; }
 $8F47 LD DE,$9028   ; {Restore the 8 bitmap bytes under the cyclone marker
 $8F4A LD HL,($7549) ;
 $8F4D LD B,$08      ;
*$8F4F LD A,(DE)     ;
 $8F50 LD (HL),A     ;
 $8F51 INC DE        ;
 $8F52 INC H         ;
 $8F53 DJNZ $8F4F    ; }
 $8F55 LD HL,$7542   ; {Counter 4..6: done
 $8F58 LD A,$06      ;
 $8F5A CP (HL)       ;
 $8F5B JP NC,$9034   ; }
 $8F5E LD (HL),$00   ; {Counter 7: reset to 0, restore helicopter attribute
 $8F60 LD A,($9027)  ;
 $8F63 LD HL,($7543) ;
 $8F66 LD (HL),A     ; }
 $8F67 CALL $9034    ; Update positions, then fall through to redraw the
                     ; markers

; Map screen: draw helicopter and cyclone markers
;
; Saves the attribute and the 8 bitmap bytes of the character cell (column
; 7540, row 7541) and prints the helicopter marker there (main-font code $28
; 'H'-like glyph) with attribute $7A (bright, white paper, red ink); then does
; the same for the cyclone at (754B, 754C) with code $27 (swirl). Called on map
; entry (5B81) and by 8F12.
;
; I:(7540),(7541) helicopter map cell (column 0-22, row 0-21), from 9034
; I:(754B),(754C) cyclone map cell
; O:(7543) helicopter cell attribute address, (7545) its bitmap address, (9027)
; .        saved attribute, 901F-9026 saved bitmap
; O:(7547) cyclone cell attribute address, (7549) its bitmap address, (9030)
; .        saved attribute, 9028-902F saved bitmap
c$8F6A LD HL,$5800   ; {Attribute address = 5800 + 32*row + column
 $8F6D LD A,($7541)  ;
 $8F70 LD B,A        ;
 $8F71 LD DE,$0020   ;
 $8F74 INC B         ;
 $8F75 JR $8F78      ;
*$8F77 ADD HL,DE     ;
*$8F78 DJNZ $8F77    ;
 $8F7A LD A,($7540)  ;
 $8F7D ADD A,L       ;
 $8F7E LD L,A        ;
 $8F7F LD ($7543),HL ; }
 $8F82 LD A,(HL)     ; {Save it and set $7A
 $8F83 LD ($9027),A  ;
 $8F86 LD (HL),$7A   ; }
 $8F88 LD HL,$4000   ; {Bitmap address of the cell
 $8F8B LD A,($7541)  ;
 $8F8E LD B,A        ;
 $8F8F LD DE,$0020   ;
 $8F92 INC B         ;
 $8F93 JR $8FA2      ;
*$8F95 RR H          ;
 $8F97 RR H          ;
 $8F99 RR H          ;
 $8F9B ADD HL,DE     ;
 $8F9C RL H          ;
 $8F9E RL H          ;
 $8FA0 RL H          ;
*$8FA2 DJNZ $8F95    ;
 $8FA4 LD A,($7540)  ;
 $8FA7 ADD A,L       ;
 $8FA8 LD L,A        ;
 $8FA9 LD ($7545),HL ; }
 $8FAC LD DE,$901F   ; {Save the 8 pixel bytes
 $8FAF LD B,$08      ;
*$8FB1 LD A,(HL)     ;
 $8FB2 LD (DE),A     ;
 $8FB3 INC H         ;
 $8FB4 INC DE        ;
 $8FB5 DJNZ $8FB1    ; }
 $8FB7 LD DE,($7545) ; {Print the helicopter marker (code at 901D)
 $8FBB LD HL,$901D   ;
 $8FBE LD C,$01      ;
 $8FC0 CALL $859A    ; }
 $8FC3 LD HL,$5800   ; {Same for the cyclone
 $8FC6 LD A,($754C)  ;
 $8FC9 LD B,A        ;
 $8FCA LD DE,$0020   ;
 $8FCD INC B         ;
 $8FCE JR $8FD1      ;
*$8FD0 ADD HL,DE     ;
*$8FD1 DJNZ $8FD0    ;
 $8FD3 LD A,($754B)  ;
 $8FD6 ADD A,L       ;
 $8FD7 LD L,A        ;
 $8FD8 LD ($7547),HL ;
 $8FDB LD A,(HL)     ;
 $8FDC LD ($9030),A  ;
 $8FDF LD (HL),$7A   ;
 $8FE1 LD HL,$4000   ;
 $8FE4 LD A,($754C)  ;
 $8FE7 LD B,A        ;
 $8FE8 LD DE,$0020   ;
 $8FEB INC B         ;
 $8FEC JR $8FFB      ;
*$8FEE RR H          ;
 $8FF0 RR H          ;
 $8FF2 RR H          ;
 $8FF4 ADD HL,DE     ;
 $8FF5 RL H          ;
 $8FF7 RL H          ;
 $8FF9 RL H          ;
*$8FFB DJNZ $8FEE    ;
 $8FFD LD A,($754B)  ;
 $9000 ADD A,L       ;
 $9001 LD L,A        ;
 $9002 LD ($7549),HL ;
 $9005 LD DE,$9028   ;
 $9008 LD B,$08      ;
*$900A LD A,(HL)     ;
 $900B LD (DE),A     ;
 $900C INC H         ;
 $900D INC DE        ;
 $900E DJNZ $900A    ;
 $9010 LD DE,($7549) ; }
 $9014 LD HL,$901E   ; {Print the cyclone marker (code at 901E)
 $9017 LD C,$01      ;
 $9019 CALL $859A    ;
 $901C RET           ; }

