 $8830 INC HL        ;
 $8831 LD D,H        ;
 $8832 LD E,L        ;
 $8833 ADD HL,BC     ;
 $8834 LD BC,$0004   ;
 $8837 LDIR          ;
 $8839 EX DE,HL      ;
 $883A POP BC        ;
