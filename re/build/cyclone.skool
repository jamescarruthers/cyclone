; Copy the view buffer to the screen
;
; Draws the 23x22-cell landscape view (screen columns 0-22, character rows
; 0-21) from the first 22 rows of the 23x29 tile buffer at $F74E. For each
; cell: attribute = byte $FE00+code; if code < $80 the 8 pixel bytes are copied
; from the tile set at $FA00+8*code, codes >= $80 are solid-colour tiles whose
; pixels are not touched.
;
; .
;
; Called from the main loop (5B86) when the map is not shown, and twice per
; step of the death sequence (9246/9284).
c$762C LD E,$00      ; E = screen column/row offset (low byte of screen and
                     ; attribute address)
 $762E LD IX,$F74E   ; IX walks the view buffer row by row (23 bytes per row)
 $7632 LD C,$08      ; Top third: 8 character rows
*$7634 LD B,$17      ; {23 columns
*$7636 PUSH BC       ; }
 $7637 LD L,(IX+$00) ; L = tile code
 $763A LD H,$FE      ; Attribute of the tile = byte at $FE00+code
 $763C LD D,$58      ; {Attribute row in the top third ($58xx)
 $763E LD A,(HL)     ;
 $763F LD (DE),A     ; }
 $7640 BIT 7,L       ; {Codes $80-$FF: attribute only
 $7642 JR NZ,$7657   ; }
 $7644 LD D,$40      ; {Pixel row in the top third ($40xx)
 $7646 LD H,$00      ; }
 $7648 ADD HL,HL     ; {HL = 8*code...
 $7649 ADD HL,HL     ;
 $764A ADD HL,HL     ; }
 $764B LD A,$FA      ; {...+$FA00 = tile graphic
 $764D ADD A,H       ;
 $764E LD H,A        ; }
 $764F LD B,$08      ; {Copy 8 pixel lines
*$7651 LD A,(HL)     ;
 $7652 LD (DE),A     ;
 $7653 INC HL        ;
 $7654 INC D         ;
 $7655 DJNZ $7651    ;
*$7657 POP BC        ;
 $7658 INC IX        ;
 $765A INC E         ;
 $765B DJNZ $7636    ; }
 $765D LD A,$09      ; {Skip the 9 columns right of the view (row stride 32)
 $765F ADD A,E       ;
 $7660 LD E,A        ;
 $7661 DEC C         ;
 $7662 JR NZ,$7634   ; }
 $7664 LD C,$08      ; {Middle third: 8 rows ($59xx / $48xx)
*$7666 LD B,$17      ;
*$7668 PUSH BC       ;
 $7669 LD L,(IX+$00) ;
 $766C LD H,$FE      ;
 $766E LD D,$59      ;
 $7670 LD A,(HL)     ;
 $7671 LD (DE),A     ;
 $7672 BIT 7,L       ;
 $7674 JR NZ,$7689   ;
 $7676 LD D,$48      ;
 $7678 LD H,$00      ;
 $767A ADD HL,HL     ;
 $767B ADD HL,HL     ;
 $767C ADD HL,HL     ;
 $767D LD A,$FA      ;
 $767F ADD A,H       ;
 $7680 LD H,A        ;
 $7681 LD B,$08      ;
*$7683 LD A,(HL)     ;
 $7684 LD (DE),A     ;
 $7685 INC HL        ;
 $7686 INC D         ;
 $7687 DJNZ $7683    ;
*$7689 POP BC        ;
 $768A INC IX        ;
 $768C INC E         ;
 $768D DJNZ $7668    ;
 $768F LD A,$09      ;
 $7691 ADD A,E       ;
 $7692 LD E,A        ;
 $7693 DEC C         ;
 $7694 JR NZ,$7666   ; }
 $7696 LD C,$06      ; {Bottom third: 6 rows ($5Axx / $50xx)
*$7698 LD B,$17      ;
*$769A PUSH BC       ;
 $769B LD L,(IX+$00) ;
 $769E LD H,$FE      ;
 $76A0 LD D,$5A      ;
 $76A2 LD A,(HL)     ;
 $76A3 LD (DE),A     ;
 $76A4 BIT 7,L       ;
 $76A6 JR NZ,$76BB   ;
 $76A8 LD D,$50      ;
 $76AA LD H,$00      ;
 $76AC ADD HL,HL     ;
 $76AD ADD HL,HL     ;
 $76AE ADD HL,HL     ;
 $76AF LD A,$FA      ;
 $76B1 ADD A,H       ;
 $76B2 LD H,A        ;
 $76B3 LD B,$08      ;
*$76B5 LD A,(HL)     ;
 $76B6 LD (DE),A     ;
 $76B7 INC HL        ;
 $76B8 INC D         ;
 $76B9 DJNZ $76B5    ;
*$76BB POP BC        ;
 $76BC INC IX        ;
 $76BE INC E         ;
 $76BF DJNZ $769A    ;
 $76C1 LD A,$09      ;
 $76C3 ADD A,E       ;
 $76C4 LD E,A        ;
 $76C5 DEC C         ;
 $76C6 JR NZ,$7698   ;
 $76C8 RET           ; }

; Unused
u$76C9 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Zero bytes
 $76D1 DEFB $00                             ; }

; Build the view window from the island maps
;
; Fills the 23x29 tile buffer at $F74E (row stride 23) with the part of the
; world map whose top-left world tile is (X,Y) = (#R$7500, #R$7502). Everything
; outside an island is sea (code 0). The island table at $F230 has 20-byte
; records ($FF-terminated, 14 islands). Record bytes used here: +0 X high byte
; (sector), +1 Y high byte, +2/+3 X-low range in which the island is visible (=
; +6-22 .. +7+22), +4/+5 Y-low range (= +8-28 .. +9+28), +6/+7 X-low range of a
; fully visible window (map column 0 is world X = +6), +8/+9 the same for Y
; (map row 0 is world Y = +8), +10/+11 address of the island tile map (row
; stride 128 bytes).
; .
; The island found is stored in #R$7552. The clip flags in C are: bit 2 X < +6
; (window overhangs the island's west edge), bit 3 X >= +7 (east edge), bit 4 Y
; < +8 (north edge), bit 5 Y >= +9 (south edge); C (0..40) indexes a table of
; 4-byte JP slots: #R$78CF for the north view (#R$7504=0) or #R$7A37 for the
; south view, whose routines copy the visible rectangle (rotated 180 degrees
; for the south view).
;
; .
;
; Called every main-loop pass (5B3C) and by the death sequence (9257). World
; tile under the helicopter = (X+11, Y+14) = buffer cell (11,14) in both views.
c$76D2 LD HL,$F74E   ; {Clear 256+256+155 = 667 = 23*29 bytes of the view
 $76D5 XOR A         ; buffer
 $76D6 LD B,A        ;
*$76D7 LD (HL),A     ;
 $76D8 INC HL        ;
 $76D9 DJNZ $76D7    ;
*$76DB LD (HL),A     ;
 $76DC INC HL        ;
 $76DD DJNZ $76DB    ;
 $76DF LD B,$9B      ;
*$76E1 LD (HL),A     ;
 $76E2 INC HL        ;
 $76E3 DJNZ $76E1    ; }
 $76E5 LD IX,$F230   ; IX = first island record
*$76E9 LD A,($7501)  ; {X high byte must match +0
 $76EC CP (IX+$00)   ;
 $76EF JR NZ,$7717   ; }
 $76F1 LD A,($7503)  ; {Y high byte must match +1
 $76F4 CP (IX+$01)   ;
 $76F7 JR NZ,$7717   ; }
 $76F9 LD A,($7500)  ; {X low byte must be in [+2, +3]
 $76FC CP (IX+$02)   ;
 $76FF JR C,$7717    ;
 $7701 DEC A         ;
 $7702 CP (IX+$03)   ;
 $7705 JR NC,$7717   ; }
 $7707 LD A,($7502)  ; {Y low byte must be in [+4, +5]
 $770A CP (IX+$04)   ;
 $770D JR C,$7717    ;
 $770F DEC A         ;
 $7710 CP (IX+$05)   ;
 $7713 JR NC,$7717   ;
 $7715 JR $7724      ; }
*$7717 LD BC,$0014   ; {Next record (20 bytes)
 $771A ADD IX,BC     ;
 $771C LD A,$FF      ; }
 $771E CP (IX+$00)   ; {Stop at the $FF terminator: open sea, buffer stays all
 $7721 JR NZ,$76E9   ; sea
 $7723 RET           ; }
*$7724 LD ($7552),IX ; Remember the current island
 $7728 LD BC,$0000   ; C = clip flags
 $772B LD A,($7500)  ; {X < +6: bit 2 (west edge in view)
 $772E CP (IX+$06)   ;
 $7731 JR NC,$7737   ;
 $7733 SET 2,C       ;
 $7735 JR $773E      ; }
*$7737 CP (IX+$07)   ; {X >= +7: bit 3 (east edge in view)
 $773A JR C,$773E    ;
 $773C SET 3,C       ; }
*$773E LD A,($7502)  ; {Y < +8: bit 4 (north edge in view)
 $7741 CP (IX+$08)   ;
 $7744 JR NC,$774A   ;
 $7746 SET 4,C       ;
 $7748 JR $7751      ; }
*$774A CP (IX+$09)   ; {Y >= +9: bit 5 (south edge in view)
 $774D JR C,$7751    ;
 $774F SET 5,C       ; }
*$7751 LD A,($7504)  ; {South view?
 $7754 CP $00        ; }
 $7756 JP NZ,$7918   ; Yes: use the south-view jump table
 $7759 LD HL,$78CF   ; {North view: jump to slot 78CF+C
 $775C ADD HL,BC     ;
 $775D JP (HL)       ; }

; Map address of the window's first row (west edge clipped)
;
; Returns HL = map base (+10/+11) + 128*(Y - (+8)): map address of column 0 of
; the window's first row.
;
; IX Island record
c$775E LD B,(IX+$0B) ;
 $7761 LD C,(IX+$0A) ;
 $7764 LD A,($7502)  ;
 $7767 LD L,(IX+$08) ;
 $776A SUB L         ;
 $776B LD L,A        ;
 $776C LD H,$00      ;
 $776E ADD HL,HL     ;
 $776F ADD HL,HL     ;
 $7770 ADD HL,HL     ;
 $7771 ADD HL,HL     ;
 $7772 ADD HL,HL     ;
 $7773 ADD HL,HL     ;
 $7774 ADD HL,HL     ;
 $7775 ADD HL,BC     ;
 $7776 RET           ;

; Map address of the window's first column (north edge clipped)
;
; Returns HL = map base + (X - (+6)): map row 0, window's first column.
;
; IX Island record
c$7777 LD H,(IX+$0B) ;
 $777A LD L,(IX+$0A) ;
 $777D LD B,$00      ;
 $777F LD A,($7500)  ;
 $7782 LD C,(IX+$06) ;
 $7785 SUB C         ;
 $7786 LD C,A        ;
 $7787 ADD HL,BC     ;
 $7788 RET           ;

; Map address of the window origin
;
; Returns HL = map base + 128*(Y - (+8)) + (X - (+6)).
;
; IX Island record
c$7789 LD B,(IX+$0B) ;
 $778C LD C,(IX+$0A) ;
 $778F LD A,($7502)  ;
 $7792 LD L,(IX+$08) ;
 $7795 SUB L         ;
 $7796 LD L,A        ;
 $7797 LD H,$00      ;
 $7799 ADD HL,HL     ;
 $779A ADD HL,HL     ;
 $779B ADD HL,HL     ;
 $779C ADD HL,HL     ;
 $779D ADD HL,HL     ;
 $779E ADD HL,HL     ;
 $779F ADD HL,HL     ;
 $77A0 ADD HL,BC     ;
 $77A1 LD B,$00      ;
 $77A3 LD A,($7500)  ;
 $77A6 LD C,(IX+$06) ;
 $77A9 SUB C         ;
 $77AA LD C,A        ;
 $77AB ADD HL,BC     ;
 $77AC RET           ;

; North view, island fills the window (slot 0)
;
; Copies 29 rows of 23 tiles from the map (window origin) to the buffer.
c$77AD CALL $7789    ;
 $77B0 LD DE,$F74E   ;
 $77B3 LD A,$1D      ;
 $77B5 JR $7803      ; Full-width copy loop (A rows)

; North view, west edge visible (slot 4)
;
; Visible width w = X - (+2) + 1 columns, copied into the rightmost w buffer
; columns, 29 rows, from map column 0.
c$77B7 LD A,($7500)  ;
 $77BA LD C,(IX+$02) ;
 $77BD SUB C         ;
 $77BE INC A         ;
 $77BF LD ($783E),A  ; {Width for the clipped copy loop (operand at 783E)
 $77C2 LD B,A        ; }
 $77C3 LD A,$18      ; {DE = $F74E + 23 - w
 $77C5 SUB B         ;
 $77C6 LD DE,$F74D   ;
 $77C9 ADD A,E       ;
 $77CA LD E,A        ;
 $77CB CALL $775E    ;
 $77CE LD A,$1D      ; }
 $77D0 JR $783D      ; Clipped copy loop

; North view, east edge visible (slot 8)
;
; Width w = (+3) - X + 1, copied into the leftmost w columns, 29 rows.
c$77D2 LD A,($7500)  ;
 $77D5 LD C,A        ;
 $77D6 LD A,(IX+$03) ;
 $77D9 SUB C         ;
 $77DA INC A         ;
 $77DB LD ($783E),A  ;
 $77DE CALL $7789    ;
 $77E1 LD DE,$F74E   ;
 $77E4 LD A,$1D      ;
 $77E6 JR $783D      ;

; North view, north edge visible (slot 16)
;
; n = Y - (+4) + 1 visible rows go to the bottom n buffer rows, 23 columns
; wide, starting at map row 0.
c$77E8 CALL $7777    ;
 $77EB PUSH HL       ;
 $77EC LD A,($7502)  ; {n = visible rows
 $77EF LD C,(IX+$04) ;
 $77F2 SUB C         ;
 $77F3 INC A         ;
 $77F4 LD B,A        ;
 $77F5 LD DE,$0017   ; }
 $77F8 LD HL,$F9E9   ; {DE = $F9E9 - 23*n (start of buffer row 29-n)
*$77FB ADD A,$00     ;
 $77FD SBC HL,DE     ;
 $77FF DJNZ $77FB    ;
 $7801 EX DE,HL      ;
 $7802 POP HL        ; }
; Full-width copy loop: A rows of 23 bytes, map stride 128.
*$7803 LD BC,$0017   ; {Copy one row of 23 tiles
 $7806 LDIR          ; }
 $7808 LD BC,$0069   ; {Map row stride 128
 $780B ADD HL,BC     ;
 $780C DEC A         ;
 $780D JR NZ,$7803   ;
 $780F RET           ; }

; North view, north-west corner visible (slot 20)
;
; w = X - (+2) + 1 columns, n = Y - (+4) + 1 rows, copied from map (0,0) to the
; bottom-right corner of the buffer.
c$7810 LD A,($7500)  ;
 $7813 LD C,(IX+$02) ;
 $7816 SUB C         ;
 $7817 INC A         ;
 $7818 LD ($783E),A  ; {Width (operand of LD BC at 783D)
 $781B LD B,A        ;
 $781C LD A,$18      ;
 $781E SUB B         ;
 $781F LD HL,$F9E8   ;
 $7822 ADD A,L       ;
 $7823 LD L,A        ;
 $7824 LD A,($7502)  ;
 $7827 LD C,(IX+$04) ;
 $782A SUB C         ;
 $782B INC A         ;
 $782C LD B,A        ;
 $782D LD DE,$0017   ;
*$7830 ADD A,$00     ;
 $7832 SBC HL,DE     ;
 $7834 DJNZ $7830    ;
 $7836 EX DE,HL      ;
 $7837 LD H,(IX+$0B) ;
 $783A LD L,(IX+$0A) ; }
; Clipped copy loop: A rows of w bytes (w in the self-modified operand at
; $783E), map stride 128, buffer stride 23.
*$783D LD BC,$0017   ; {w (self-modified operand)
 $7840 PUSH HL       ;
 $7841 PUSH DE       ;
