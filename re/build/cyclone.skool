; Landing / terrain-collision check
;
; Called once per main-loop iteration (5B54). Does nothing while landed
; (7515=1). Otherwise (a) every other group of 4 calls updates 7533, the target
; height level (0-7) of the helicopter's own tile column, from the altitude;
; (b) compares altitude/4 with the height class of each of the 9 footprint
; cells (7A8B, filled by 7ADC) and decides between "still flying", "touch-down"
; and "crash". Touch-down then requires every footprint cell's top tile to be
; landable; landing on 9 helipad tiles sets 752E=1. A crash is signalled by
; 7505=1 (main loop then jumps to the death sequence at 9246).
;
; I:(7515) 1 = landed (routine returns at once)
; I:(750D) altitude in pixels (0..60)
; I:(7514) 1 = helicopter tried to descend below altitude 0 (set by 8269)
; I:(751B) descent speed 0..3 (pixels per iteration while 'down' held)
; I:(7A81) 9 raw terrain codes under the helicopter (3x3, filled by 7E10)
; I:(7A8B) 9 height classes of those cells, in units of 4 altitude pixels
; .        (filled by 7ADC)
;
; Footprint order in 7A81/7A8B: view-buffer cells
; (row15,col10),(14,10),(13,10),(15,11),(14,11),(13,11),(15,12),(14,12),(13,12).
c$8A7A LD A,($7515)  ; {Landed? Then nothing to do.
 $8A7D CP $01        ;
 $8A7F RET Z         ; }
 $8A80 LD A,($750D)  ; {B = altitude/4 (arithmetic shifts)
 $8A83 SRA A         ;
 $8A85 SRA A         ;
 $8A87 LD B,A        ; }
 $8A88 LD HL,$7534   ; {7534 = free-running call counter
 $8A8B INC (HL)      ; }
 $8A8C BIT 2,(HL)    ; {Only when bit 2 of the counter is set (4 calls in every
 $8A8E JR Z,$8A9B    ; 8)...}
 $8A90 SRA A         ; {...7533 = min((altitude>>3)+1, 7): helicopter
 $8A92 INC A         ; tile-column level that 89CA steps 87EF towards
 $8A93 CP $08        ;
 $8A95 JR NZ,$8A98   ;
 $8A97 DEC A         ;
*$8A98 LD ($7533),A  ; }
*$8A9B LD HL,$7A8B   ; {Count in C the footprint cells whose height class is <=
 $8A9E LD A,B        ; altitude/4 (clear cells)
 $8A9F LD BC,$0900   ; }
*$8AA2 CP (HL)       ; {altitude/4 < height class? Then this cell is
 $8AA3 JP C,$8B30    ; touching/above the helicopter: go to 8B30
 $8AA6 INC C         ;
*$8AA7 INC HL        ;
 $8AA8 DJNZ $8AA2    ; }
 $8AAA LD A,($7514)  ; {Flag 7514 set (pressing down at altitude 0)?
 $8AAD CP $00        ;
 $8AAF JR Z,$8AC1    ; }
 $8AB1 LD A,C        ; {With 7514 set: anything less than 9 clear cells is a
 $8AB2 CP $09        ; crash...
 $8AB4 JP NZ,$8B5D   ; }
 $8AB7 LD A,($751B)  ; {...and so is a descent speed of 3; otherwise try to
 $8ABA CP $03        ; touch down
 $8ABC JP NC,$8B5D   ;
 $8ABF JR $8ACA      ; }
*$8AC1 LD A,C        ; {7514 clear: 9 clear cells = still flying, return
 $8AC2 CP $09        ;
 $8AC4 RET Z         ; }
 $8AC5 CP $00        ; {0 clear cells = all 9 cells reached: try to touch down;
 $8AC7 JP NZ,$8B5D   ; 1..8 = partly over an obstacle/edge: crash}
*$8ACA LD DE,$7A81   ; {Touch-down: examine the top tile of each footprint
 $8ACD LD BC,$0900   ; cell's tile stack. C counts helipad tiles.}
*$8AD0 LD A,(DE)     ; {L = raw terrain code; the stack for code L is the bytes
 $8AD1 LD L,A        ; at $6300+L, $6400+L, ... terminated by $FF
 $8AD2 LD H,$63      ; }
 $8AD4 LD A,$FF      ; {Find the first page (from $64) holding $FF for this
*$8AD6 INC H         ; code...
 $8AD7 CP (HL)       ;
 $8AD8 JR NZ,$8AD6   ; }
 $8ADA DEC H         ; {...and step back to the topmost tile of the stack
 $8ADB LD A,(HL)     ; }
 $8ADC BIT 7,A       ; {Tiles $80-$FF are special (8B1D)
 $8ADE JR NZ,$8B1D   ; }
 $8AE0 CP $2D        ; {Ordinary tiles $2D-$7F cannot be landed on: crash
 $8AE2 JR NC,$8B5D   ; }
 $8AE4 CP $03        ; {Tiles $00-$02 (sea) cannot be landed on: crash
 $8AE6 JR C,$8B5D    ; }
*$8AE8 INC DE        ; {Next footprint cell
 $8AE9 DJNZ $8AD0    ; }
 $8AEB LD A,$09      ; {All 9 cells were helipad tiles ($83/$89)?
 $8AED CP C          ;
 $8AEE JR NZ,$8AF5   ; }
 $8AF0 LD A,$01      ; {Then 752E=1: landed on the base helipad (refuelling
 $8AF2 LD ($752E),A  ; allowed; required to finish a round)}
*$8AF5 LD A,$01      ; {7515=1: landed
 $8AF7 LD ($7515),A  ; }
 $8AFA XOR A         ; {Clear 7514
 $8AFB LD ($7514),A  ; }
 $8AFE LD A,($750D)  ; {Round the altitude UP to a multiple of 8: new =
 $8B01 LD D,A        ; ((alt+7)>>3)*8
 $8B02 ADD A,$07     ;
 $8B04 SRA A         ;
 $8B06 SRA A         ;
 $8B08 SRA A         ;
 $8B0A ADD A,A       ;
 $8B0B ADD A,A       ;
 $8B0C ADD A,A       ;
 $8B0D LD ($750D),A  ; }
 $8B10 SUB D         ; {B = (new-old)+1
 $8B11 LD B,A        ;
 $8B12 INC B         ; }
 $8B13 JR $8B1A      ; {Raise the altimeter bar by new-old pixels (82D4 once
*$8B15 PUSH BC       ; per pixel)
 $8B16 CALL $82D4    ;
 $8B19 POP BC        ;
*$8B1A DJNZ $8B15    ;
 $8B1C RET           ; }
*$8B1D CP $80        ; {Special top tile: $80 or $86 = crash
 $8B1F JR Z,$8B5D    ;
 $8B21 CP $86        ;
 $8B23 JR Z,$8B5D    ; }
 $8B25 CP $83        ; {$83 or $89 = helipad tile: count it (C=C+1); any other
 $8B27 JR Z,$8B2D    ; $80-$FF tile is landable
 $8B29 CP $89        ;
 $8B2B JR NZ,$8AE8   ;
*$8B2D INC C         ;
 $8B2E JR $8AE8      ; }
*$8B30 LD E,A        ; {Cell height class (HL) is above altitude/4. E =
 $8B31 LD A,(HL)     ; altitude/4}
 $8B32 CP $0F        ; {Height class < 15: low obstacle (ground). Go to 8B4E
 $8B34 JR C,$8B4E    ; }
 $8B36 LD A,($87EF)  ; {Height class >= 15 (very tall object). Not seen
 $8B39 SRA E         ; executed. A = 87EF (current helicopter tile level), E =
                     ; altitude/8}
 $8B3B DEC A         ; {87EF-1 = altitude/8: crash
 $8B3C CP E          ;
 $8B3D JR Z,$8B5D    ;
 $8B3F INC A         ; }
 $8B40 CP $07        ; {87EF=7: crash only if altitude/8 = 7 (8B49)
 $8B42 JR Z,$8B49    ; }
*$8B44 LD A,E        ; {Otherwise count the cell as clear and continue the loop
 $8B45 INC C         ;
 $8B46 JP $8AA7      ;
*$8B49 CP E          ;
 $8B4A JR NZ,$8B44   ;
 $8B4C JR $8B5D      ; }
*$8B4E LD A,($751B)  ; {Low obstacle reached: a descent speed of 3 is a hard
 $8B51 CP $03        ; landing = crash
 $8B53 JR NC,$8B5D   ; }
 $8B55 XOR A         ; {Otherwise kill the descent speed (soft contact) and
 $8B56 LD ($751B),A  ; continue the loop WITHOUT counting the cell as clear
 $8B59 LD A,E        ;
 $8B5A JP $8AA7      ; }
*$8B5D LD A,$01      ; {7505=1: helicopter destroyed
 $8B5F LD ($7505),A  ;
 $8B62 RET           ; }

; Unused code fragment (never called)
;
; Disassembles as LD A,$F3 / LD A,$3E / LD I,A / IM 1 / EI / RET: a leftover
; interrupt-mode-1 restore. Followed by 7 zero bytes.
u$8B63 DEFB $3E,$F3,$3E,$3E,$ED,$47,$ED,$56,$FB,$C9
 $8B6D DEFB $00,$00,$00,$00,$00,$00,$00

; Random number generator
;
; Advances the 16-bit seed held in the ROM system variable SEED (5C76) and
; returns it in HL. The arithmetic is the classic Spectrum Lehmer step done
; without multiplication: new = ((254*(seed+1)) mod 65537) - 1 (verified for
; 3,206 seeds by emulation, including 0 and 65535). The sequence visits all
; 65,536 values (period 65536). Callers use L or H of the result.
;
; I:(5C76) seed
; O:HL new seed (also stored at 5C76)
; O:A,D,E corrupted
c$8B74 LD DE,($5C76) ; DE = seed
 $8B78 LD H,E        ; {Form the 24-bit number A:H:L = seed*256 + $FD
 $8B79 LD L,$FD      ;
 $8B7B LD A,D        ; }
 $8B7C OR A          ; {Subtract the seed twice (with borrow into A): A:HL =
 $8B7D SBC HL,DE     ; 254*seed + 253 = 254*(seed+1) - 1
 $8B7F SBC A,$00     ;
 $8B81 SBC HL,DE     ;
 $8B83 SBC A,$00     ; }
 $8B85 LD E,A        ; {Reduce modulo 65537 (65536 = -1): HL = HL - A
 $8B86 LD D,$00      ;
 $8B88 SBC HL,DE     ; }
 $8B8A JR NC,$8B8D   ; {On borrow add 65537 back (i.e. +1 in 16 bits)
 $8B8C INC HL        ; }
*$8B8D LD ($5C76),HL ; {Store new seed
 $8B90 RET           ; }

; Animate sea waves in the view buffer
;
; Called every main-loop iteration (5B45) and every step of the death sequence
; (925A), after 76D2 has rebuilt the view buffer (F74E, 23 columns x 22 rows of
; terrain codes) and before 7E10 converts codes to tile stacks. Puts random
; wave codes 0-3 into the empty (code 0 = open sea) cells of a sparse sheared
; lattice (7 rows x 4-5 columns, lattice vectors +5 cells across and +4 rows/+3
; columns down). The lattice phase (7535 column 0..8, 7536 row 0..6) is shifted
; against the heading whenever the helicopter is moving, so the waves scroll
; with the motion; the random bytes are taken from ROM $0100+n, n re-randomised
; every 3rd call, so the wave pattern changes every 3 iterations.
;
; I:(7527) speed (0 = hovering: phase unchanged)
; I:(7506) heading 0,2,..14 (0=N, clockwise)
; I:(7504) view: 0 = north, 1 = south (180 degree rotated)
;
; Cell written = F705 + 7535 + 23*B + 5*i + 95*j (j=0..6 rows, i=0..3 or 4),
; where B = 7536 (view north) or, view south, B = 7536+2 if that is < 7 else
; 7536-2; F705 = F74E - 73 (3 rows and 4 columns before the buffer start). If
; 7535 < 4 the first lattice column is skipped (+5). Columns per row: 5 if 7535
; in 0,1,4,5,6; 4 if 7535 in 2,3,7,8 (the row stride is always 95). Only cells
; containing 0 are changed, to (ROM byte AND 3).
c$8B91 LD A,($7537)  ; {7537 counts 0,1,2
 $8B94 INC A         ;
 $8B95 CP $03        ;
 $8B97 JR Z,$8BA2    ;
 $8B99 LD ($7537),A  ; }
 $8B9C LD DE,($7538) ; {Not the 3rd call: reuse the ROM pointer in 7538
 $8BA0 JR $8BB0      ; }
*$8BA2 XOR A         ; {Every 3rd call: DE = $0100 + (L of a new random number)
 $8BA3 LD ($7537),A  ; = pointer to "random" ROM bytes
 $8BA6 CALL $8B74    ;
 $8BA9 LD D,$01      ;
 $8BAB LD E,L        ;
 $8BAC LD ($7538),DE ; }
*$8BB0 PUSH DE       ; Keep the ROM pointer on the stack
 $8BB1 LD A,($7527)  ; {Speed 0: lattice phase unchanged
 $8BB4 CP $00        ;
 $8BB6 JR NZ,$8BC6   ;
 $8BB8 LD HL,$F705   ;
 $8BBB LD A,($7535)  ;
 $8BBE LD C,A        ;
 $8BBF ADD A,L       ;
 $8BC0 LD L,A        ;
 $8BC1 LD A,($7536)  ;
 $8BC4 JR $8C00      ; }
*$8BC6 LD A,($7504)  ; {Moving: choose the phase-step table for the current
 $8BC9 CP $00        ; view
 $8BCB JR Z,$8BD2    ;
 $8BCD LD HL,$8C77   ;
 $8BD0 JR $8BD5      ;
*$8BD2 LD HL,$8C66   ; }
*$8BD5 LD A,($7506)  ; {Index it by heading (2 bytes per heading)
 $8BD8 LD D,$00      ;
 $8BDA LD E,A        ;
 $8BDB ADD HL,DE     ;
 $8BDC LD DE,$F705   ; }
 $8BDF LD B,(HL)     ; {7535 += dx; values outside 0..8 reset to 4
 $8BE0 LD A,($7535)  ;
 $8BE3 ADD A,B       ;
 $8BE4 CP $09        ;
 $8BE6 JR C,$8BEA    ;
 $8BE8 LD A,$04      ; }
*$8BEA LD ($7535),A  ; {C = new column phase; E = $05+7535 (DE = F705+column
 $8BED INC HL        ; phase)
 $8BEE LD C,A        ;
 $8BEF ADD A,E       ;
 $8BF0 LD E,A        ; }
 $8BF1 LD B,(HL)     ; {7536 += dy; values outside 0..6 reset to 3
 $8BF2 LD A,($7536)  ;
 $8BF5 ADD A,B       ;
 $8BF6 CP $07        ;
 $8BF8 JR C,$8BFC    ;
 $8BFA LD A,$03      ;
*$8BFC LD ($7536),A  ;
 $8BFF EX DE,HL      ; }
*$8C00 LD B,A        ; {B = row phase; adjusted by 2 rows for the south view
 $8C01 LD A,($7504)  ;
 $8C04 CP $00        ;
 $8C06 JR Z,$8C13    ;
 $8C08 INC B         ;
 $8C09 INC B         ;
 $8C0A LD A,B        ;
 $8C0B CP $07        ;
 $8C0D JR C,$8C13    ;
 $8C0F LD B,$04      ;
 $8C11 SUB B         ;
 $8C12 LD B,A        ; }
*$8C13 LD DE,$0017   ; {HL = F705 + column phase + 23*row phase
 $8C16 INC B         ;
 $8C17 JR $8C1A      ;
*$8C19 ADD HL,DE     ;
*$8C1A DJNZ $8C19    ; }
 $8C1C LD A,$04      ; {Default: 4 lattice columns per row, row skip 75
 $8C1E LD ($8C47),A  ; (self-modified operands at 8C47 and 8C5E)
 $8C21 LD A,$4B      ;
 $8C23 LD ($8C5E),A  ; }
 $8C26 LD A,C        ; {Column phase < 4: start one lattice column (5 cells)
 $8C27 CP $04        ; further on
 $8C29 JR NC,$8C35   ;
 $8C2B LD DE,$0005   ;
 $8C2E ADD HL,DE     ;
 $8C2F CP $02        ;
 $8C31 JR C,$8C39    ;
 $8C33 JR $8C43      ;
*$8C35 CP $07        ;
 $8C37 JR NC,$8C43   ; }
*$8C39 LD A,$05      ; {5 lattice columns per row, row skip 70
 $8C3B LD ($8C47),A  ;
 $8C3E LD A,$46      ;
 $8C40 LD ($8C5E),A  ; }
*$8C43 LD C,$07      ; {7 lattice rows
 $8C45 XOR A         ; }
*$8C46 LD B,$05      ; {B = lattice columns (operand at 8C47 modified above)
 $8C48 LD DE,$0005   ; }
*$8C4B CP (HL)       ; {Cell empty (open sea)?
 $8C4C JR NZ,$8C5A   ; }
 $8C4E EX AF,AF'     ; {Then set it to the next ROM byte AND 3 (wave code 0-3)
 $8C4F POP DE        ;
 $8C50 LD A,(DE)     ;
 $8C51 AND $03       ;
 $8C53 LD (HL),A     ;
 $8C54 INC E         ;
 $8C55 PUSH DE       ;
 $8C56 EX AF,AF'     ; }
 $8C57 LD DE,$0005   ; {Next lattice column (+5 cells)
*$8C5A ADD HL,DE     ;
 $8C5B DJNZ $8C4B    ; }
 $8C5D LD DE,$0046   ; {Next lattice row (operand at 8C5E modified above: 95
 $8C60 ADD HL,DE     ; bytes per row in total)
 $8C61 DEC C         ;
 $8C62 JR NZ,$8C46   ; }
 $8C64 POP DE        ; {Drop the ROM pointer
 $8C65 RET           ; }

; Wave phase steps, view north
;
; (dx,dy) added to 7535/7536 per moving iteration, indexed by heading 7506
; (0=N,2=NE,4=E,...,14=NW). The step is opposite to the direction of travel.
; Byte 8C76 is padding.
b$8C66 DEFB $00,$01
