; Shuffle the five crates
;
; Copied here from #R$F88A by #R$F74E; always called via the JP at #R$FE92.
; Called once per level start (#R$5B2C) and continuously (hundreds of times per
; second) from the main menu loop at #R$E29E, so the final crate layout depends
; on how long the player waits in the menu. Pass 1 removes the crates placed
; last time: for every one of the 38 candidate cells in #R$5F61 whose flag is
; $FF, the flag is cleared and the crate tile ($8B/$57/$2F/$0F, #R$5F59) is
; turned back into the plain tile ($58/$30/$10/$04, #R$5F5D); a cell whose
; crate was already winched up already holds the plain tile and is left alone.
; Pass 2 picks 5 different cells: random L from #R$8B74 until L<$4C, index=L/2
; (0-37, uniform), retry if already flagged; flag it $FF and turn the plain
; tile into the matching crate tile ($58->$8B, $30->$57, $10->$2F, anything
; else->$0F).
@label=ShuffleCrates
c$5EEC LD HL,$5F61   ; {38 candidate cells
 $5EEF LD B,$26      ;
*$5EF1 PUSH BC       ; }
 $5EF2 LD A,(HL)     ; {Crate placed here last time?
 $5EF3 CP $FF        ;
 $5EF5 JR NZ,$5F17   ; }
 $5EF7 LD (HL),$00   ; {Clear the flag
 $5EF9 PUSH HL       ;
 $5EFA INC HL        ; }
 $5EFB LD E,(HL)     ; {DE = map cell address
 $5EFC INC HL        ;
 $5EFD LD D,(HL)     ; }
 $5EFE LD A,(DE)     ; {A = tile code in the map
 $5EFF PUSH DE       ; }
 $5F00 LD DE,$5F5D   ; {Look it up in the 4 crate tiles
 $5F03 LD HL,$5F59   ;
 $5F06 LD B,$04      ;
*$5F08 CP (HL)       ;
 $5F09 JR Z,$5F13    ;
 $5F0B INC HL        ;
 $5F0C INC DE        ;
 $5F0D DJNZ $5F08    ;
 $5F0F POP DE        ;
 $5F10 POP HL        ;
 $5F11 JR $5F17      ; }
*$5F13 LD A,(DE)     ; {Found: replace it with the plain tile
 $5F14 POP DE        ;
 $5F15 POP HL        ;
 $5F16 LD (DE),A     ;
*$5F17 INC HL        ;
 $5F18 INC HL        ;
 $5F19 INC HL        ;
 $5F1A POP BC        ;
 $5F1B DJNZ $5EF1    ; }
 $5F1D LD B,$05      ; {Now place 5 crates
*$5F1F PUSH BC       ; }
*$5F20 CALL $8B74    ; {Random number (HL)
 $5F23 LD A,L        ; }
 $5F24 CP $4C        ; {Retry until L < 76
 $5F26 JR NC,$5F20   ;
 $5F28 NOP           ;
 $5F29 NOP           ; }
 $5F2A SRA A         ; {A = L/2 = 0..37
 $5F2C LD B,A        ; }
 $5F2D ADD A,A       ; {A = index*3
 $5F2E ADD A,B       ;
 $5F2F LD HL,$5F61   ;
 $5F32 LD E,A        ;
 $5F33 LD D,$00      ;
 $5F35 ADD HL,DE     ;
 $5F36 LD A,(HL)     ; }
 $5F37 CP $FF        ; {Cell already chosen? Try again
 $5F39 JR Z,$5F20    ; }
 $5F3B LD (HL),$FF   ; {Flag it
 $5F3D INC HL        ;
 $5F3E LD E,(HL)     ;
 $5F3F INC HL        ;
 $5F40 LD D,(HL)     ; }
 $5F41 LD A,(DE)     ; {A = current (plain) tile
 $5F42 PUSH DE       ;
 $5F43 LD DE,$5F59   ;
 $5F46 LD HL,$5F5D   ; }
 $5F49 LD B,$03      ; {Look it up in the first 3 plain tiles; DE stops on
*$5F4B CP (HL)       ; $5F5C ($0F) if not found
 $5F4C JR Z,$5F52    ;
 $5F4E INC HL        ;
 $5F4F INC DE        ;
 $5F50 DJNZ $5F4B    ; }
*$5F52 LD A,(DE)     ; {Store the crate tile
 $5F53 POP DE        ;
 $5F54 LD (DE),A     ;
 $5F55 POP BC        ;
 $5F56 DJNZ $5F1F    ;
 $5F58 RET           ; }

; Crate tile codes and the plain tiles they replace
b$5F59 DEFB $8B,$57,$2F,$0F ; Crate tiles: $8B, $57, $2F, $0F (also #R$F511)
 $5F5D DEFB $58,$30,$10,$04 ; Matching plain tiles: $58, $30, $10, $04 (also
                            ; #R$F51B)

; Crate candidate cells (38 entries)
;
; 38 three-byte entries: flag ($FF = a crate was put here by the last shuffle,
; $00 = not) and the address of the cell in the 128-byte-wide world map at
; $9300. Initially all flags are 0.
b$5F61 DEFB $00,$05,$99
 $5F64 DEFB $00,$A5,$96
 $5F67 DEFB $00,$2F,$9A
 $5F6A DEFB $00,$18,$A5
 $5F6D DEFB $00,$89,$A4
 $5F70 DEFB $00,$86,$B0
 $5F73 DEFB $00,$91,$AE
 $5F76 DEFB $00,$9B,$AF
 $5F79 DEFB $00,$14,$B1
 $5F7C DEFB $00,$A6,$BA
 $5F7F DEFB $00,$09,$BD
 $5F82 DEFB $00,$BA,$BE
 $5F85 DEFB $00,$23,$C6
 $5F88 DEFB $00,$97,$C6
 $5F8B DEFB $00,$87,$CE
 $5F8E DEFB $00,$1D,$D4
 $5F91 DEFB $00,$F3,$95
 $5F94 DEFB $00,$6B,$9C
 $5F97 DEFB $00,$E9,$A5
 $5F9A DEFB $00,$F7,$A8
 $5F9D DEFB $00,$60,$AF
 $5FA0 DEFB $00,$6C,$AF
 $5FA3 DEFB $00,$6C,$B6
 $5FA6 DEFB $00,$4B,$BF
 $5FA9 DEFB $00,$FB,$BD
 $5FAC DEFB $00,$D3,$C2
 $5FAF DEFB $00,$C0,$95
 $5FB2 DEFB $00,$CA,$9D
 $5FB5 DEFB $00,$39,$9E
 $5FB8 DEFB $00,$3C,$A0
 $5FBB DEFB $00,$49,$A8
 $5FBE DEFB $00,$43,$AE
 $5FC1 DEFB $00,$D4,$B6
 $5FC4 DEFB $00,$31,$CA
 $5FC7 DEFB $00,$43,$C9
 $5FCA DEFB $00,$5E,$C9
 $5FCD DEFB $00,$EC,$CD
 $5FD0 DEFB $00,$E9,$DB
 $5FD3 DEFB $00         ; Last byte of the copied block

; Leftover bytes below the main code block
b$5FD4 DEFB $52,$1B,$76,$1B,$03,$13,$00,$3E

; Interrupt: crash noise
;
; Jumped to from the interrupt handler $83C2 while the crash flag $7505 is 1
; (crash sequence). Once per frame: random HL (#R$8B74); if L < $46 there is no
; sound this frame (70/256), otherwise 3 square-wave cycles are played, with
; the high phase lasting (H AND $F0) loop passes and the low phase (L AND $F0)
; loop passes (~43 T-states per pass), which gives a random-pitch rasping
; noise. Border stays black. Exits through the interrupt handler's register
; restore at $842D.
@label=CrashNoise
c$5FDC CALL $8B74    ;
 $5FDF LD A,L        ; {No sound on 70 of 256 frames
 $5FE0 CP $46        ;
 $5FE2 JP C,$842D    ; }
 $5FE5 LD B,$03      ; {3 cycles
*$5FE7 PUSH BC       ; }
 $5FE8 LD A,H        ; {High phase length = H AND $F0
 $5FE9 AND $F0       ;
 $5FEB CP $00        ;
 $5FED JR Z,$6009    ;
 $5FEF LD B,A        ; }
*$5FF0 LD A,$10      ; {Speaker on (bit 4), border black
 $5FF2 OUT ($FE),A   ;
 $5FF4 NOP           ;
 $5FF5 NOP           ;
 $5FF6 NOP           ;
 $5FF7 DJNZ $5FF0    ; }
 $5FF9 LD A,L        ; {Low phase length = L AND $F0
 $5FFA AND $F0       ;
 $5FFC CP $00        ;
 $5FFE JR Z,$6009    ;
 $6000 LD B,A        ; }
*$6001 XOR A         ; {Speaker off
 $6002 OUT ($FE),A   ;
 $6004 NOP           ;
 $6005 NOP           ;
 $6006 NOP           ;
 $6007 DJNZ $6001    ;
*$6009 POP BC        ;
 $600A DJNZ $5FE7    ; }
 $600C JP $842D      ; Restore registers, EI, RET

; Unused
s$600F DEFS $09

