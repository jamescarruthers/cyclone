 $F4F4 LD HL,$7AAC     ;
 $F4F7 ADD HL,BC       ;
 $F4F8 LD ($7529),HL   ;
 $F4FB LD A,($750D)    ;
 $F4FE LD C,A          ;
 $F4FF LD B,$00        ;
