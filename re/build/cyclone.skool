u$85D1 DEFB $00,$00,$00

; Let foreground slope tiles cover the helicopter
;
; Called once per main-loop iteration (5B57), after the view has been built
; (7E10) and the helicopter drawn (86AF), before the view is copied to the
; screen (762C). Looks at the lower part of the helicopter's 3x11-cell window:
; view-buffer cells F86C + 23*i + j (i = 0-3 = window cells 7-10, j = 0-2 =
; window columns). Where such a cell holds a slope tile in front of the
; helicopter (codes $19-$1C) and the window cell's attribute has ink 0
; (helicopter pixels were drawn there by 86AF), the window cell's bitmap is
; ANDed with a triangular mask (tile $23 for odd codes, $25 for even) and ORed
; with the slope edge (tile $17 blank for $19/$1A, $1B or $1C), its attribute
; set to $60 (bright green paper), and the cell's code replaced by the window
; tile code so the merged picture is displayed. Aircraft tiles $3C-$44 in those
; cells (8689, never seen executed) are ORed in instead.
;
; I:(F86C) view buffer (23 cells per row)
; I:(FCF8) window tile bitmaps (tiles $5F-$7F: 3 columns x 11 cells,
; .        column-major, 8 bytes each)
; I:(FE5F) window tile attributes (FE00+code)
c$85D4 LD HL,$FD30   ; {7509 = bitmap of window tile $66 (column 0, cell 7)
 $85D7 LD ($7509),HL ; }
 $85DA LD HL,$FE66   ; {750B = its attribute
 $85DD LD ($750B),HL ; }
 $85E0 LD HL,$F86C   ; {First view-buffer cell to test; 3 columns...
 $85E3 LD C,$03      ; }
 $85E5 LD A,$66      ; A' = window tile code $66
*$85E7 LD B,$04      ; {...of 4 cells
*$85E9 EX AF,AF'     ; }
 $85EA LD A,(HL)     ; {A = view-buffer code
 $85EB PUSH HL       ;
 $85EC LD HL,($750B) ;
 $85EF LD DE,($7509) ; }
 $85F3 CP $1D        ; {Codes $1D and up: only aircraft tiles $3C-$44 are
 $85F5 JP NC,$8681   ; handled}
 $85F8 CP $19        ; {Codes below $19: nothing to do
 $85FA JR C,$864C    ;
 $85FC PUSH BC       ;
 $85FD LD B,A        ; }
 $85FE LD A,(HL)     ; {Slope tile: only where the helicopter has been drawn
 $85FF AND $07       ; (ink 0)
 $8601 CP $00        ;
 $8603 JR NZ,$864B   ; }
 $8605 LD (HL),$60   ; {Attribute $60
 $8607 INC HL        ;
 $8608 LD ($750B),HL ; }
 $860B LD HL,$FB18   ; {Mask: tile $23 (codes $19/$1B) or tile $25 (codes
 $860E LD A,B        ; $1A/$1C)
 $860F BIT 0,A       ;
 $8611 JR NZ,$8617   ;
 $8613 LD BC,$0010   ;
 $8616 ADD HL,BC     ; }
*$8617 LD IX,$FAB8   ; {Edge: tile $17 (blank) for $19/$1A...
 $861B CP $1B        ;
 $861D JR C,$862B    ; }
 $861F LD IX,$FAD8   ; {...tile $1B for $1B...
 $8623 CP $1B        ;
 $8625 JR Z,$862B    ; }
 $8627 LD IX,$FAE0   ; ...tile $1C for $1C
*$862B LD BC,$0800   ; {8 lines: window = (window AND mask) OR edge; C = OR of
*$862E LD A,(DE)     ; the results
 $862F AND (HL)      ;
 $8630 OR (IX+$00)   ;
 $8633 LD (DE),A     ;
