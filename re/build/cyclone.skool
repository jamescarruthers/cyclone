 $880B CP $E8        ;
 $880D JR NZ,$8817   ;
 $880F LD A,L        ;
 $8810 CP $5A        ;
 $8812 JR C,$8817    ;
 $8814 LD HL,$E740   ;
*$8817 LD ($8A69),HL ; }
