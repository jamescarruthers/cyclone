                                                        ; cell hidden
                                                        ; (#R$7B33).}
 $7A9E DEFB $00                                         ; Unused
 $7A9F DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Projected
 $7AAA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; (displayed) tile
 $7AB5 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; codes of buffer
                                                        ; columns 10, 11, 12,
                                                        ; rows 15 up to 5 (11
                                                        ; per column, bottom
