                                    ; SURV_ANIM1 ($755B) = $00
 $7624 DEFB $00                     ; Per-life reset value ($FF = keep) of
                                    ; SURV_ANIM2 ($755C) = $00
 $7625 DEFB $00                     ; Per-life reset value ($FF = keep) of
