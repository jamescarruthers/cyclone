 $7E92 LD D,$67      ;
 $7E94 LD BC,$FFA4   ;
 $7E97 ADD HL,BC     ;
 $7E98 LD BC,$FFE9   ;
 $7E9B JR $7EA0      ;
*$7E9D LD (HL),A     ;
*$7E9E INC D         ;
 $7E9F ADD HL,BC     ;
*$7EA0 LD A,(DE)     ;
 $7EA1 CP $FE        ;
 $7EA3 JR C,$7E9D    ;
 $7EA5 CP $FE        ;
 $7EA7 JR Z,$7E9E    ;
 $7EA9 POP HL        ;
 $7EAA POP BC        ;
*$7EAB INC HL        ;
 $7EAC DJNZ $7E8A    ; }
 $7EAE LD B,$17      ; {Row 26: codes >= $B2, page P+5 (operand 7EB9)
*$7EB0 LD A,(HL)     ;
 $7EB1 CP $B2        ;
 $7EB3 JR C,$7ED1    ;
 $7EB5 PUSH BC       ;
 $7EB6 PUSH HL       ;
 $7EB7 LD E,A        ;
 $7EB8 LD D,$68      ;
 $7EBA LD BC,$FF8D   ;
 $7EBD ADD HL,BC     ;
 $7EBE LD BC,$FFE9   ;
 $7EC1 JR $7EC6      ;
*$7EC3 LD (HL),A     ;
*$7EC4 INC D         ;
 $7EC5 ADD HL,BC     ;
*$7EC6 LD A,(DE)     ;
 $7EC7 CP $FE        ;
 $7EC9 JR C,$7EC3    ;
 $7ECB CP $FE        ;
 $7ECD JR Z,$7EC4    ;
 $7ECF POP HL        ;
 $7ED0 POP BC        ;
*$7ED1 INC HL        ;
 $7ED2 DJNZ $7EB0    ; }
 $7ED4 LD B,$17      ; {Row 27: codes >= $D0, page P+6 (operand 7EDF)
*$7ED6 LD A,(HL)     ;
 $7ED7 CP $D0        ;
 $7ED9 JR C,$7EF7    ;
 $7EDB PUSH BC       ;
 $7EDC PUSH HL       ;
 $7EDD LD E,A        ;
 $7EDE LD D,$69      ;
 $7EE0 LD BC,$FF76   ;
 $7EE3 ADD HL,BC     ;
 $7EE4 LD BC,$FFE9   ;
 $7EE7 JR $7EEC      ;
*$7EE9 LD (HL),A     ;
*$7EEA INC D         ;
 $7EEB ADD HL,BC     ;
*$7EEC LD A,(DE)     ;
 $7EED CP $FE        ;
 $7EEF JR C,$7EE9    ;
 $7EF1 CP $FE        ;
 $7EF3 JR Z,$7EEA    ;
 $7EF5 POP HL        ;
 $7EF6 POP BC        ;
*$7EF7 INC HL        ;
 $7EF8 DJNZ $7ED6    ; }
 $7EFA LD B,$17      ; {Row 28: codes >= $E4, page P+7 (operand 7F05)
*$7EFC LD A,(HL)     ;
 $7EFD CP $E4        ;
 $7EFF JR C,$7F1D    ;
 $7F01 PUSH BC       ;
 $7F02 PUSH HL       ;
 $7F03 LD E,A        ;
 $7F04 LD D,$6A      ;
 $7F06 LD BC,$FF5F   ;
 $7F09 ADD HL,BC     ;
 $7F0A LD BC,$FFE9   ;
 $7F0D JR $7F12      ;
*$7F0F LD (HL),A     ;
*$7F10 INC D         ;
 $7F11 ADD HL,BC     ;
*$7F12 LD A,(DE)     ;
 $7F13 CP $FE        ;
 $7F15 JR C,$7F0F    ;
 $7F17 CP $FE        ;
 $7F19 JR Z,$7F10    ;
 $7F1B POP HL        ;
 $7F1C POP BC        ;
*$7F1D INC HL        ;
 $7F1E DJNZ $7EFC    ;
 $7F20 RET           ; }
*$7F21 DEC C         ; {Insert sprite tiles: account for this row
 $7F22 PUSH BC       ;
 $7F23 PUSH HL       ; }
 $7F24 LD HL,$FCF8   ; {Destination: graphic of tile $5F ($FA00+8*$5F)
 $7F27 LD ($7509),HL ; }
 $7F2A LD HL,$FE5F   ; {Destination: attribute of tile $5F
 $7F2D LD ($750B),HL ; }
 $7F30 LD HL,$F7CB   ; Buffer column 10, row 5
 $7F33 LD C,$03      ; {3 columns x 11 rows (rows 5-15), top to bottom
*$7F35 LD B,$0B      ;
*$7F37 PUSH BC       ;
 $7F38 PUSH HL       ;
 $7F39 LD DE,($750B) ; }
 $7F3D LD C,(HL)     ; {Copy the cell's attribute
 $7F3E LD B,$FE      ;
 $7F40 LD A,(BC)     ;
 $7F41 LD (DE),A     ;
 $7F42 INC DE        ;
 $7F43 LD ($750B),DE ; }
 $7F47 LD HL,$FA00   ; {Copy the cell's graphic (tile 0's for solid tiles >=
 $7F4A BIT 7,C       ; $80)
 $7F4C JR NZ,$7F56   ;
 $7F4E LD E,C        ;
 $7F4F LD D,$00      ;
 $7F51 EX DE,HL      ;
 $7F52 ADD HL,HL     ;
 $7F53 ADD HL,HL     ;
 $7F54 ADD HL,HL     ;
 $7F55 ADD HL,DE     ;
*$7F56 LD DE,($7509) ;
 $7F5A LD BC,$0008   ;
 $7F5D LDIR          ;
 $7F5F LD ($7509),DE ;
 $7F63 POP HL        ; }
 $7F64 LD BC,$0017   ; {Next row (+23)
 $7F67 ADD HL,BC     ;
 $7F68 POP BC        ;
 $7F69 DJNZ $7F37    ; }
 $7F6B LD DE,$FF04   ; {Next column, back to row 5
 $7F6E ADD HL,DE     ;
 $7F6F DEC C         ;
 $7F70 JR NZ,$7F35   ; }
 $7F72 LD A,($7505)  ; {Draw the shadow unless crashed
 $7F75 CP $01        ;
 $7F77 CALL NZ,$7ADC ; }
 $7F7A NOP           ; {Three NOPs (patched-out code)
 $7F7B NOP           ;
 $7F7C NOP           ; }
 $7F7D LD DE,$F7CB   ; {Replace the 33 cells by the sprite tile codes #R$7F98
 $7F80 LD HL,$7F98   ;
 $7F83 LD A,$0B      ;
*$7F85 LD BC,$0003   ;
 $7F88 LDIR          ;
 $7F8A EX DE,HL      ;
 $7F8B LD BC,$0014   ;
