 $E130 DEFB $00,$00,$00,$00,$00,$00,$C0,$E0,$E0,$71,$7F,$7F,$FF,$FB,$EF,$FF,$CF,$07,$03,$00,$00,$00,$00,$00 ; (247.5
 $E148 DEFB $00,$00,$00,$00,$04,$0C,$1C,$1C,$7C,$FC,$F8,$FC,$CC,$80,$00,$00,$80,$C0,$C0,$80,$00,$00,$00,$00 ; degrees)}
 $E160 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$07,$17,$7F,$7F,$3F,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Frame 12
 $E178 DEFB $00,$00,$00,$00,$00,$06,$0E,$0E,$0E,$FF,$FF,$FF,$57,$FF,$1E,$1E,$0E,$0E,$0E,$06,$00,$00,$00,$00 ; (270
 $E190 DEFB $00,$00,$00,$00,$00,$00,$06,$0E,$1E,$FE,$FE,$FE,$FE,$8C,$0C,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; degrees)}
 $E1A8 DEFB $00,$00,$00,$00,$00,$00,$1E,$2F,$1F,$1F,$07,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Frame 13
 $E1C0 DEFB $00,$00,$00,$00,$00,$03,$07,$CF,$FF,$FF,$7F,$DF,$7F,$7F,$78,$F0,$F0,$E0,$60,$00,$00,$00,$00,$00 ; (292.5
 $E1D8 DEFB $00,$00,$00,$00,$00,$80,$80,$00,$00,$74,$FE,$FC,$F8,$F8,$F0,$E0,$E0,$00,$00,$00,$00,$00,$00,$00 ; degrees)}
 $E1F0 DEFB $00,$00,$00,$03,$0F,$0F,$0F,$07,$03,$01,$00,$00,$00,$01,$03,$03,$07,$07,$02,$00,$00,$00,$00,$00 ; {Frame 14
 $E208 DEFB $00,$00,$00,$00,$80,$C0,$E0,$F7,$FF,$7F,$BF,$DF,$FF,$FF,$EF,$C1,$83,$03,$00,$00,$00,$00,$00,$00 ; (315
 $E220 DEFB $00,$00,$00,$00,$00,$00,$E0,$E0,$C0,$80,$00,$90,$F8,$F8,$F0,$F0,$C0,$00,$00,$00,$00,$00,$00,$00 ; degrees)}
 $E238 DEFB $00,$00,$00,$01,$01,$01,$00,$00,$00,$00,$00,$00,$03,$0F,$0F,$04,$00,$00,$00,$00,$00,$00,$00,$00 ; {Frame 15
 $E250 DEFB $00,$00,$C0,$F0,$F8,$F8,$FC,$FC,$7E,$5F,$3F,$EF,$FF,$FF,$8F,$07,$03,$07,$07,$00,$00,$00,$00,$00 ; (337.5
 $E268 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$78,$F8,$F0,$C0,$A0,$E0,$E0,$F8,$F0,$E0,$60,$00,$00,$00,$00,$00 ; degrees)}

; Main menu
;
; Entered after initialisation (#R$F74E), at game over ($92A6), from the info
; screen and when A+G abandons a game (#R$5BE9). Silences the engine sound,
; beeps, waits for all keys to be released, draws the menu and highlights the
; selected controller. While waiting for a key it calls the crate shuffle
; (#R$FE92) continuously. Keys: 1 = information screen (#R$E3B4); 2 = keyboard,
; 3 = Interface 2, 4 = Kempston, 5 = Protek/AGF (cursor) joystick: stored as
; 0-3 in the control method $7FD5 (initially 0); 6 = start the game (#R$5B00).
; Other keys are ignored.
@label=MainMenu
c$E280 LD A,$01      ; {$752D=1: interrupt handler makes no engine sound
 $E282 LD ($752D),A  ; }
 $E285 LD HL,$0666   ; {Beep (pitch $0666, $55 cycles)
 $E288 LD DE,$0055   ;
 $E28B CALL $03B5    ; }
*$E28E CALL $E3F8    ; {Wait until no key is pressed
 $E291 JR NC,$E28E   ; }
 $E293 CALL $84D6    ; Clear the screen
 $E296 CALL $E2E8    ; Draw the menu
 $E299 LD A,($7FD5)  ; {Current control method (0-3)
 $E29C JR $E2BD      ; }
@label=MenuLoop
*$E29E CALL $FE92    ; Shuffle the crates again (randomises the layout while
                     ; waiting)
 $E2A1 CALL $E3F8    ; {Read a key (carry set: none)
 $E2A4 JR C,$E29E    ; }
 $E2A6 CP $31        ; {Ignore anything but "1".."6"
 $E2A8 JR C,$E29E    ;
 $E2AA CP $37        ;
 $E2AC JR NC,$E29E   ;
 $E2AE CP $31        ; }
 $E2B0 JP Z,$E3B4    ; {"1": information screen
 $E2B3 CP $36        ; }
 $E2B5 JP Z,$5B00    ; "6": start the game
 $E2B8 SUB $32       ; {"2".."5": control method 0..3
 $E2BA LD ($7FD5),A  ; }
*$E2BD LD HL,$5960   ; {Rows 11-14, all columns: bright cyan on black...
 $E2C0 LD B,$80      ;
*$E2C2 LD (HL),$45   ;
 $E2C4 INC HL        ;
 $E2C5 DJNZ $E2C2    ; }
 $E2C7 LD HL,$5969   ; {...except the selected row (11+method), columns 9-21:
 $E2CA ADD A,A       ; flashing bright cyan
 $E2CB ADD A,A       ;
 $E2CC ADD A,A       ;
 $E2CD ADD A,A       ;
 $E2CE ADD A,A       ;
 $E2CF ADD A,L       ;
 $E2D0 LD L,A        ;
 $E2D1 LD B,$0D      ;
*$E2D3 LD (HL),$C5   ;
 $E2D5 INC HL        ;
 $E2D6 DJNZ $E2D3    ; }
 $E2D8 LD HL,$0300   ; {Click
 $E2DB LD DE,$0060   ;
 $E2DE CALL $03B5    ; }
*$E2E1 CALL $E3F8    ; {Wait for the key to be released
 $E2E4 JR NC,$E2E1   ;
 $E2E6 JR $E29E      ; }

; Draw the main menu
;
; Colours rows 5-17, columns 9-21 from the list at #R$E3A6 (one attribute per
; row), draws a horizontal line (pixel line 3) across the same 13 columns of
; each of those rows (visible only on the red rows that carry no text: rows 8,
; 10, 15, 17), then prints the strings at #R$E325.
@label=DrawMenu
c$E2E8 LD DE,$E3A6   ; {One attribute per row
 $E2EB LD HL,$58A9   ;
*$E2EE LD B,$0D      ;
 $E2F0 LD A,(DE)     ;
*$E2F1 LD (HL),A     ;
 $E2F2 INC HL        ;
 $E2F3 DJNZ $E2F1    ;
 $E2F5 INC DE        ;
 $E2F6 LD BC,$0013   ;
 $E2F9 ADD HL,BC     ;
 $E2FA LD A,(DE)     ;
 $E2FB CP $FF        ;
 $E2FD JR NZ,$E2EE   ; }
 $E2FF LD HL,$43A9   ; {Pixel line 3 of row 5, column 9
 $E302 LD A,$FF      ;
 $E304 LD C,$0D      ;
*$E306 LD B,$0D      ;
*$E308 LD (HL),A     ;
 $E309 INC HL        ;
 $E30A DJNZ $E308    ; }
 $E30C RR H          ; {Move to the same pixel line of the next character row
 $E30E RR H          ; (bit-rotation trick)
 $E310 RR H          ;
 $E312 LD DE,$0013   ;
 $E315 ADD HL,DE     ;
 $E316 RL H          ;
 $E318 RL H          ;
 $E31A RL H          ;
 $E31C DEC C         ;
 $E31D JR NZ,$E306   ; }
 $E31F LD HL,$E325   ; {Print the menu strings
 $E322 JP $E40F      ; }

; Main menu strings
;
; Format for #R$E40F: screen address (2 bytes), character codes (font #R$6028),
; $FF; the list ends with another $FF.
b$E325 DEFW $40A9                           ; Screen address $40A9 (row 5,
                                            ; column 9)
 $E327 DEFB $20,$20,$17,$18,$19,$1A,$1B,$1C ; {Character codes (font at $6028;
 $E32F DEFB $1D,$1E,$1F,$20,$20             ; $17-$1F = CYCLONE logo glyphs)}
 $E334 DEFB $FF                             ; End of string
 $E335 DEFW $40E9                           ; Screen address $40E9 (row 7,
                                            ; column 9)
 $E337 DEFM "SELECT OPTION"
 $E344 DEFB $FF                             ; End of string
 $E345 DEFW $4829                           ; Screen address $4829 (row 9,
                                            ; column 9)
 $E347 DEFM "1 INFORMATION"
 $E354 DEFB $FF                             ; End of string
 $E355 DEFW $4869                           ; Screen address $4869 (row 11,
                                            ; column 9)
 $E357 DEFM "2 KEYBOARD   "
 $E364 DEFB $FF                             ; End of string
 $E365 DEFW $4889                           ; Screen address $4889 (row 12,
                                            ; column 9)
 $E367 DEFM "3 INTERFACE 2"
 $E374 DEFB $FF                             ; End of string
 $E375 DEFW $48A9                           ; Screen address $48A9 (row 13,
                                            ; column 9)
 $E377 DEFM "4 KEMPSTON   "
 $E384 DEFB $FF                             ; End of string
 $E385 DEFW $48C9                           ; Screen address $48C9 (row 14,
                                            ; column 9)
 $E387 DEFM "5 PROTEK/AGF "
 $E394 DEFB $FF                             ; End of string
 $E395 DEFW $5009                           ; Screen address $5009 (row 16,
                                            ; column 9)
 $E397 DEFM "6 START GAME "
 $E3A4 DEFB $FF                             ; End of string
 $E3A5 DEFB $FF                             ; End of list

; Main menu row attributes
;
; One attribute for 13 cells (columns 9-21) of each of rows 5-17 (#R$E2E8):
; logo row bright white; SELECT OPTION white; red rule rows; options white
; (rows 11-14 are recoloured by the highlight code).
b$E3A6 DEFB $47,$00,$07,$42,$47,$42,$07,$07,$07,$07,$42,$47,$42
 $E3B3 DEFB $FF                                                 ; End of list

; Information screen
;
; Menu option 1. Draws the HUD panel and labels every HUD element, the key
; controls and the map symbols, then waits for any key and returns to the menu.
; Also updates the high score (#R$87BC).
@label=InfoScreen
c$E3B4 CALL $84D6    ; Clear the screen
 $E3B7 LD HL,$0400   ; {Beep (pitch $0400, $70 cycles)
 $E3BA LD DE,$0070   ;
 $E3BD CALL $03B5    ; }
*$E3C0 CALL $E3F8    ; {Wait until no key is pressed
 $E3C3 JR NC,$E3C0   ; }
 $E3C5 CALL $84F4    ; Draw the HUD panel
 $E3C8 LD DE,$0009   ; {Play area (23 x 22 cells): bright red ink on white
 $E3CB LD HL,$5800   ; paper
 $E3CE LD C,$16      ;
*$E3D0 LD B,$17      ;
*$E3D2 LD (HL),$7A   ;
 $E3D4 INC HL        ;
 $E3D5 DJNZ $E3D2    ;
 $E3D7 ADD HL,DE     ;
 $E3D8 DEC C         ;
 $E3D9 JR NZ,$E3D0   ; }
 $E3DB LD A,$03      ; {$7530=3: aircraft collision warning lit
 $E3DD LD ($7530),A  ; }
 $E3E0 XOR A         ; {Speed $7527=0
 $E3E1 LD ($7527),A  ; }
 $E3E4 CALL $91B4    ; Draw compass/speedometer/warning
 $E3E7 CALL $6F00    ; Print the score
 $E3EA CALL $87BC    ; Update and print the high score
 $E3ED CALL $E43A    ; Print all the information texts
*$E3F0 CALL $E3F8    ; {Wait for a key
 $E3F3 JR C,$E3F0    ;
 $E3F5 JP $E280      ; }

; Read the keyboard (ROM)
;
; Uses ROM KEY-SCAN ($028E), K-TEST ($031E) and K-DECODE ($0333, L mode).
;
; O:A ASCII code of the key pressed (0 if none)
; O:F Carry clear if a single valid key is pressed, set if none
@label=GetKey
c$E3F8 CALL $028E    ;
 $E3FB JR NZ,$E40C   ;
 $E3FD CALL $031E    ;
 $E400 JR NC,$E40C   ;
 $E402 LD E,A        ;
 $E403 LD C,$00      ;
 $E405 LD D,$08      ;
 $E407 CALL $0333    ;
 $E40A AND A         ;
 $E40B RET           ;
*$E40C XOR A         ;
 $E40D SCF           ;
 $E40E RET           ;

; Print a list of strings (8x8 font)
;
; Each string: screen address (2 bytes), character codes, $FF; a second $FF
; ends the list. Characters are copied from the font at #R$6028 (8 pixel lines
; each).
;
; HL String list
@label=PrintStrings
c$E40F LD A,(HL)     ;
 $E410 CP $FF        ;
 $E412 RET Z         ;
 $E413 LD E,A        ;
 $E414 INC HL        ;
 $E415 LD D,(HL)     ;
 $E416 INC HL        ;
*$E417 LD A,(HL)     ;
 $E418 INC HL        ;
 $E419 CP $FF        ;
 $E41B JR Z,$E40F    ;
 $E41D PUSH DE       ;
 $E41E PUSH HL       ;
 $E41F LD L,A        ;
 $E420 LD H,$00      ;
 $E422 LD BC,$6028   ;
 $E425 ADD HL,HL     ;
 $E426 ADD HL,HL     ;
 $E427 ADD HL,HL     ;
 $E428 ADD HL,BC     ;
 $E429 LD B,$08      ;
*$E42B LD A,(HL)     ;
 $E42C LD (DE),A     ;
 $E42D INC D         ;
 $E42E INC HL        ;
 $E42F DJNZ $E42B    ;
 $E431 POP HL        ;
 $E432 POP DE        ;
 $E433 INC DE        ;
 $E434 JR $E417      ;

; Unused
b$E436 DEFB $E1,$00,$0A,$15

; Print the information screen texts
;
; Prints the 29 lines of 4x8-font text at #R$E517 (positions from #R$E69C; the
; stride operand at $8E0A is set to 3 here, the map labels use 20), the two
; headings and the highlighted key letters/map symbols in the 8x8 font,
; horizontal rules (#R$E504), the leaving-map arrow (HUD glyph at $7460), crate
; glyph ($FB80, char $30) and survivor glyph ($FB90, char $32), and makes
; "PRESS ANY KEY" flash.
@label=DrawInfoTexts
c$E43A LD IX,$E68C   ; Line position table base (IX+$10 = #R$E69C)
 $E43E LD A,$03      ; {Line-record stride 3 for $8DEE
 $E440 LD ($8E0A),A  ; }
 $E443 LD HL,$E517   ; {Print the small-font texts
 $E446 CALL $8DEE    ; }
 $E449 LD HL,$E4E0   ; {"KEY CONTROLS" at row 1, column 1
 $E44C LD DE,$4021   ;
 $E44F LD C,$0C      ;
 $E451 CALL $859A    ; }
 $E454 LD HL,$E4EC   ; {"MAP INDICATORS" at row 8, column 1
 $E457 LD DE,$4801   ;
 $E45A LD C,$0E      ;
 $E45C CALL $859A    ; }
 $E45F LD HL,$E504   ; {Draw horizontal rules (list at #R$E504)
*$E462 LD A,$FF      ;
 $E464 LD B,(HL)     ;
 $E465 CP B          ;
 $E466 JR Z,$E473    ;
 $E468 INC HL        ;
 $E469 LD E,(HL)     ;
 $E46A INC HL        ;
 $E46B LD D,(HL)     ;
 $E46C INC HL        ;
*$E46D LD (DE),A     ;
 $E46E INC DE        ;
 $E46F DJNZ $E46D    ;
 $E471 JR $E462      ; }
*$E473 LD HL,$E4FA   ; {Single characters: "1" row 3 col 1, "O" row 3 col 7,
 $E476 LD C,$01      ; "Q" row 4 col 1, "P" row 4 col 7, "X" row 5 col 1, "N"
 $E478 LD DE,$4061   ; row 5 col 7, "M" row 6 col 1, "N" row 14 col 21,
 $E47B CALL $859A    ; helicopter symbol row 10 col 1, cyclone symbol row 11
 $E47E INC C         ; col 1
 $E47F LD E,$67      ;
 $E481 CALL $859A    ;
 $E484 INC C         ;
 $E485 LD E,$81      ;
 $E487 CALL $859A    ;
 $E48A INC C         ;
 $E48B LD E,$87      ;
 $E48D CALL $859A    ;
 $E490 INC C         ;
 $E491 LD E,$A1      ;
 $E493 CALL $859A    ;
 $E496 INC C         ;
 $E497 LD E,$A7      ;
 $E499 CALL $859A    ;
 $E49C INC C         ;
 $E49D LD E,$C1      ;
 $E49F CALL $859A    ;
 $E4A2 INC C         ;
 $E4A3 LD DE,$48D5   ;
 $E4A6 CALL $859A    ;
 $E4A9 INC C         ;
 $E4AA LD E,$41      ;
 $E4AC CALL $859A    ;
 $E4AF INC C         ;
 $E4B0 LD E,$61      ;
 $E4B2 CALL $859A    ;
 $E4B5 INC C         ; }
 $E4B6 LD IX,$7460   ; {Leaving-map arrow at row 12, column 1
 $E4BA LD DE,$4881   ;
 $E4BD LD C,$01      ;
 $E4BF LD HL,$0040   ;
 $E4C2 CALL $8EE8    ; }
 $E4C5 LD IX,$FB80   ; {Crate glyph at row 14, column 1
 $E4C9 INC C         ;
 $E4CA CALL $8EE8    ; }
 $E4CD LD IX,$FB90   ; {Survivor glyph at row 16, column 1
 $E4D1 INC C         ;
 $E4D2 CALL $8EE8    ; }
 $E4D5 LD HL,$5A41   ; {"PRESS ANY KEY" (row 18, columns 1-7) flashing
 $E4D8 LD B,$07      ;
*$E4DA LD (HL),$FA   ;
 $E4DC INC HL        ;
 $E4DD DJNZ $E4DA    ;
 $E4DF RET           ; }

; Information screen headings and key letters
t$E4E0 DEFM "KEY CONTROLS"   ; "KEY CONTROLS"
 $E4EC DEFM "MAP INDICATORS" ; "MAP INDICATORS"
 $E4FA DEFM "1OQPXNMN"       ; Key letters 1 O Q P X N M N
 $E502 DEFB $28,$27          ; Map symbols: $28 helicopter position, $27
                             ; cyclone location

; Information screen horizontal rules
;
; Entries: length, screen address (2 bytes); all bytes are set to $FF. List
; ends with $FF.
b$E504 DEFB $0E,$01,$44
 $E507 DEFB $0E,$41,$44
 $E50A DEFB $0E,$E1,$44
 $E50D DEFB $0E,$21,$4C
 $E510 DEFB $0E,$A1,$4C
 $E513 DEFB $07,$48,$54
 $E516 DEFB $FF         ; End of list

; Information screen texts (4x8 font)
;
; Printed by #R$8DEE from E518 (first byte skipped): lines separated by $FE,
; '?' = space, $FF = end. Line n is printed at the screen position in entry n
; of #R$E69C.
t$E517 DEFB $3F                        ; Skipped
 $E518 DEFM "?UP"
 $E51B DEFB $FE                        ; next line
 $E51C DEFM "?LEFT"
 $E521 DEFB $FE                        ; next line
 $E522 DEFM "?DOWN"
 $E527 DEFB $FE                        ; next line
 $E528 DEFM "?RIGHT"
 $E52E DEFB $FE                        ; next line
 $E52F DEFM "?FORWARD"
 $E537 DEFB $FE                        ; next line
 $E538 DEFM "?VIEW?CHANGE"
 $E544 DEFB $FE                        ; next line
 $E545 DEFM "?MAP?OR?MAIN?SCREEN"
 $E558 DEFB $FE                        ; next line
 $E559 DEFM "?HELICOPTER?POSITION"
 $E56D DEFB $FE                        ; next line
 $E56E DEFM "?CYCLONE?LOCATION"
 $E57F DEFB $FE                        ; next line
 $E580 DEFM "?LEAVING?MAP?AREA"
 $E591 DEFB $FE                        ; next line
 $E592 DEFM "?COLLECT?FIVE?CRATES"
 $E5A6 DEFB $FE                        ; next line
 $E5A7 DEFM "?AND?RETURN?TO?BASE"
 $E5BA DEFB $FE                        ; next line
 $E5BB DEFM "?RESCUE?SURVIVORS?FOR"
 $E5D0 DEFB $FE                        ; next line
 $E5D1 DEFM "?EXTRA?POINTS"
 $E5DE DEFB $FE                        ; next line
 $E5DF DEFM "PRESS?ANY?KEY"
 $E5EC DEFB $FE                        ; next line
 $E5ED DEFM "CRATES?LEFT"
 $E5F8 DEFB $FE                        ; next line
 $E5F9 DEFM "?ALTIMETER"
 $E603 DEFB $FE                        ; next line
 $E604 DEFM "?SPEEDOMETER"
 $E610 DEFB $FE                        ; next line
 $E611 DEFM "FUEL?GAUGE"
 $E61B DEFB $FE                        ; next line
 $E61C DEFM "?TIME?LEFT"
 $E626 DEFB $FE                        ; next line
 $E627 DEFM "?COMPASS"
 $E62F DEFB $FE                        ; next line
 $E630 DEFM "?HEADING"
 $E638 DEFB $FE                        ; next line
 $E639 DEFM "?LIVES"
 $E63F DEFB $FE                        ; next line
 $E640 DEFM "?VIEW?SELECTED"
 $E64E DEFB $FE                        ; next line
 $E64F DEFM "?WITH?KEY"
 $E658 DEFB $FE                        ; next line
 $E659 DEFM "?COLLISION"
 $E663 DEFB $FE                        ; next line
 $E664 DEFM "?WARNING"
 $E66C DEFB $FE                        ; next line
 $E66D DEFM "WIND?SPEED?INCREASES"
 $E681 DEFB $FE                        ; next line
 $E682 DEFM "WHEN?APPROACHING?CYCLONE"
 $E69A DEFB $FF                        ; end of text
 $E69B DEFB $FF                        ; end of text

; Information screen text line positions
;
; 29 entries: screen address (2 bytes), attribute page ($58/$59/$5A; the
; attribute of each cell written gets $78). Accessed as IX+$10..IX+$12 with
; IX=$E68C+3n.
b$E69C DEFB $62,$40,$58
 $E69F DEFB $68,$40,$58
 $E6A2 DEFB $82,$40,$58
 $E6A5 DEFB $88,$40,$58
 $E6A8 DEFB $A2,$40,$58
 $E6AB DEFB $A8,$40,$58
 $E6AE DEFB $C2,$40,$58
 $E6B1 DEFB $42,$48,$59
 $E6B4 DEFB $62,$48,$59
 $E6B7 DEFB $82,$48,$59
 $E6BA DEFB $C2,$48,$59
 $E6BD DEFB $E2,$48,$59
 $E6C0 DEFB $02,$50,$5A
 $E6C3 DEFB $22,$50,$5A
 $E6C6 DEFB $41,$50,$5A
 $E6C9 DEFB $81,$50,$5A
 $E6CC DEFB $31,$40,$58
 $E6CF DEFB $50,$40,$58
 $E6D2 DEFB $71,$40,$58
 $E6D5 DEFB $91,$40,$58
 $E6D8 DEFB $F2,$40,$58
 $E6DB DEFB $12,$48,$59
 $E6DE DEFB $53,$48,$59
 $E6E1 DEFB $AF,$48,$59
 $E6E4 DEFB $D0,$48,$59
 $E6E7 DEFB $11,$50,$5A
 $E6EA DEFB $32,$50,$5A
 $E6ED DEFB $6C,$50,$5A
 $E6F0 DEFB $8A,$50,$5A

; Unused
b$E6F3 DEFB $00,$00,$00,$80,$00,$A8,$50,$A0
 $E6FB DEFB $40,$00,$00,$00,$00

; Aircraft movement opcodes
;
; 16 directions x 4 bytes, patched into the aircraft mover at $8867/$8868 (X)
; and $8871/$8872 (Y) by $87F0: $03 = INC BC, $0B = DEC BC, $00 = NOP, so each
; axis moves -2..+2 per iteration.
b$E700 DEFB $00,$00,$0B,$0B
 $E704 DEFB $03,$00,$0B,$0B
 $E708 DEFB $03,$03,$0B,$0B
 $E70C DEFB $03,$03,$0B,$00
 $E710 DEFB $03,$03,$00,$00
 $E714 DEFB $03,$03,$03,$00
 $E718 DEFB $03,$03,$03,$03
 $E71C DEFB $00,$03,$03,$03
 $E720 DEFB $00,$00,$03,$03
 $E724 DEFB $0B,$00,$03,$03
 $E728 DEFB $0B,$0B,$03,$03
 $E72C DEFB $0B,$0B,$03,$00
 $E730 DEFB $0B,$0B,$00,$00
 $E734 DEFB $0B,$0B,$0B,$00
 $E738 DEFB $0B,$0B,$0B,$0B
 $E73C DEFB $0B,$00,$0B,$0B

; Aircraft course script
;
; 15 records of 20 bytes; $87F0 advances to the next record every 28 iterations
; (wrapping at $E85A to $E740). Each record is a list of new directions for the
; aircraft table (#R$E86C); a byte with bit 7 set also resets that aircraft's
; position from #R$E8CC; $FF ends a record.
