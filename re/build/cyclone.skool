 $7A94 DEFB $00                                         ; Unused
 $7A95 DEFB $00,$00,$00                                 ; {Shadow row offset of
 $7A98 DEFB $00,$00,$00                                 ; each cell = level/2
 $7A9B DEFB $00,$00,$00                                 ; (rows); bit 7 =
