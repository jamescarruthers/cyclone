 $F4B2 LD B,A          ;
*$F4B3 SUB B           ;
 $F4B4 LD ($7555),A    ; }
 $F4B7 CP $00          ; {Still on the rope?
 $F4B9 JR NZ,$F4CC     ; }
 $F4BB LD A,($7557)    ; {Arrived: 50 points for a survivor...
 $F4BE LD HL,$F548     ;
 $F4C1 LD B,$32        ;
 $F4C3 CP L            ;
 $F4C4 JR Z,$F4C8      ; }
 $F4C6 LD B,$FA        ; {...250 for a crate
*$F4C8 CALL $6602      ;
 $F4CB RET             ; }
