; Print the score
;
; Prints the string ending at $6624 right-to-left from row 19 column 31 (screen
; address $507F) until a $FF byte, using the 8x8 font (#R$6028), 7 pixel lines
; per character. Entry #R$6F06 (from #R$87BC) prints the high score with
; DE=$509F, BC=$662D.
@label=PrintScore
c$6F00 LD DE,$507F   ;
 $6F03 LD BC,$6624   ;
; This entry point is used by the routine at #R$87BC.
@label=PrintBackwards
*$6F06 LD A,(BC)     ; {Next character (BC moves backwards)
 $6F07 CP $FF        ;
 $6F09 RET Z         ;
 $6F0A PUSH BC       ;
 $6F0B LD L,A        ;
 $6F0C LD H,$00      ;
 $6F0E ADD HL,HL     ;
 $6F0F ADD HL,HL     ;
 $6F10 ADD HL,HL     ;
 $6F11 LD BC,$6028   ;
 $6F14 ADD HL,BC     ; }
 $6F15 LD B,$07      ; {Copy 7 pixel lines
*$6F17 LD A,(HL)     ;
 $6F18 LD (DE),A     ;
 $6F19 INC D         ;
 $6F1A INC HL        ;
 $6F1B DJNZ $6F17    ;
 $6F1D POP BC        ; }
 $6F1E LD D,$50      ; {Back to the top line, one column left
 $6F20 DEC E         ;
 $6F21 DEC BC        ;
 $6F22 JR $6F06      ; }

