; Draw the helicopter sprite into its view window
;
; Called once per main-loop iteration (5B4E; also 9281 during the crash
; sequence). Draws the 24x24 sprite at 6950 (3 columns x 24 lines,
; column-major) into the helicopter window tiles $5F-$7F (3 columns of 11 cells
; = 88 pixel lines each, bitmaps at FCF8). The sprite's top line is at line
; 62-altitude of each 88-line column, so the helicopter rises one pixel per
; altitude unit above its shadow. Each cell-sized piece is drawn either solid
; (copied, rest of the cell cleared) when the cell's background code is below
; $1B and its attribute ink is non-zero (e.g. white wave dots on the sea), or
; ORed with a one-pixel 'cut' under every sprite pixel; the cell's ink is then
; set to 0 (black). Empty pieces leave the cell untouched.
;
; I:(750D) altitude
; I:(6950) helicopter sprite (built by 8CA0)
; I:(7AA2) per-cell background codes of the window (from the renderer)
;
; Variables: 7509/7529 = pointer into the background-code table (7AA2+C,
; stepping down per piece, +11 per column), 750B/752B = window attribute
; pointer (FE66-C, +11 per column), 7512 = column counter 0-2, where C =
; (altitude+1)>>3.
c$86AF XOR A         ; {Column counter = 0
 $86B0 LD ($7512),A  ; }
 $86B3 LD A,($750D)  ; {C = (altitude+1)>>3: number of cells the sprite is
 $86B6 INC A         ; lifted}
 $86B7 LD HL,$FE66   ; {Attribute pointer = FE66 - C (window cell 7 - C of
 $86BA SRA A         ; column 0)
 $86BC SRA A         ;
 $86BE SRA A         ;
 $86C0 LD C,A        ;
 $86C1 LD B,$00      ;
 $86C3 ADD A,$00     ;
 $86C5 SBC HL,BC     ;
 $86C7 LD ($750B),HL ;
 $86CA LD ($752B),HL ; }
 $86CD LD HL,$7AA2   ; {Background-code pointer = 7AA2 + C
 $86D0 ADD HL,BC     ;
 $86D1 LD ($7509),HL ;
 $86D4 LD ($7529),HL ; }
 $86D7 LD A,($750D)  ; {DE = window bitmap FD36 - altitude (column 0, line
 $86DA LD C,A        ; 62-altitude)
 $86DB LD B,$00      ;
 $86DD LD HL,$FD36   ;
 $86E0 ADD A,$00     ;
 $86E2 SBC HL,BC     ;
 $86E4 EX DE,HL      ; }
 $86E5 LD HL,$6950   ; {HL = sprite; C = 24 lines per column
*$86E8 LD C,$18      ; }
; This entry point is used by the routine at #R$F39A.
*$86EA PUSH HL       ; {Count in B the lines up to the next cell boundary,
 $86EB PUSH DE       ; ORing the sprite bytes to see whether the piece is empty
 $86EC XOR A         ;
 $86ED PUSH AF       ;
 $86EE LD B,$00      ;
*$86F0 INC B         ;
 $86F1 POP AF        ;
 $86F2 OR (HL)       ;
 $86F3 PUSH AF       ;
 $86F4 INC HL        ;
 $86F5 INC DE        ;
 $86F6 DEC C         ;
 $86F7 JR Z,$8700    ;
 $86F9 LD A,E        ;
 $86FA AND $07       ;
 $86FC CP $00        ;
 $86FE JR NZ,$86F0   ; }
*$8700 LD HL,($7529) ; {Empty piece: skip it (8741)
 $8703 POP AF        ;
 $8704 CP $00        ;
 $8706 JP Z,$8741    ; }
 $8709 LD A,(HL)     ; {Background code (bit 7 ignored)
 $870A RES 7,A       ;
 $870C DEC HL        ;
 $870D LD ($7529),HL ; }
 $8710 CP $1B        ; {Code $1B or more: OR-draw
 $8712 JR NC,$8770   ; }
 $8714 LD HL,($752B) ; {Attribute ink 0: OR-draw
 $8717 LD A,(HL)     ;
 $8718 AND $07       ;
 $871A CP $00        ;
 $871C JR Z,$8770    ; }
 $871E POP DE        ; {Solid draw: whole cell?
 $871F POP HL        ;
 $8720 LD A,B        ;
 $8721 CP $08        ;
 $8723 JR Z,$8739    ; }
 $8725 LD A,C        ; {Last piece (C=0): copy, then clear the rest of the cell
 $8726 CP $00        ; (875A)
 $8728 JR Z,$875A    ; }
 $872A LD A,E        ; {First piece: clear the cell from its first line, then
 $872B AND $F8       ; copy
 $872D LD E,A        ;
 $872E LD A,$08      ;
 $8730 SUB B         ;
 $8731 PUSH BC       ;
 $8732 LD B,A        ;
 $8733 XOR A         ;
*$8734 LD (DE),A     ;
 $8735 INC DE        ;
 $8736 DJNZ $8734    ;
 $8738 POP BC        ;
*$8739 LD A,(HL)     ;
 $873A LD (DE),A     ;
 $873B INC HL        ;
 $873C INC DE        ;
 $873D DJNZ $8739    ;
 $873F JR $877E      ; }
*$8741 DEC HL        ; {Empty piece: advance all pointers
 $8742 LD ($7529),HL ;
 $8745 LD HL,($752B) ;
 $8748 INC HL        ;
 $8749 LD ($752B),HL ;
 $874C POP DE        ;
 $874D POP HL        ;
*$874E INC DE        ;
 $874F INC HL        ;
 $8750 DJNZ $874E    ; }
*$8752 LD A,C        ; {More lines in this column?
 $8753 CP $00        ;
 $8755 JP NZ,$86EA   ;
 $8758 JR $878D      ; }
*$875A LD A,$08      ; {Copy B lines then clear the remaining 8-B lines
 $875C SUB B         ;
 $875D LD C,A        ;
*$875E LD A,(HL)     ;
 $875F LD (DE),A     ;
 $8760 INC HL        ;
 $8761 INC DE        ;
 $8762 DJNZ $875E    ;
 $8764 LD B,C        ;
 $8765 XOR A         ;
 $8766 PUSH DE       ;
*$8767 LD (DE),A     ;
 $8768 INC DE        ;
 $8769 DJNZ $8767    ;
 $876B POP DE        ;
 $876C LD C,$00      ;
 $876E JR $877E      ; }
*$8770 POP HL        ; {OR-draw: line |= sprite, next line &= NOT sprite
 $8771 POP DE        ;
*$8772 LD A,(DE)     ;
 $8773 OR (HL)       ;
 $8774 LD (HL),A     ;
 $8775 INC HL        ;
 $8776 LD A,(DE)     ;
 $8777 CPL           ;
 $8778 AND (HL)      ;
 $8779 LD (HL),A     ;
 $877A INC DE        ;
 $877B DJNZ $8772    ;
 $877D EX DE,HL      ; }
*$877E PUSH HL       ; {Ink of this window cell := 0 (black)
 $877F LD HL,($752B) ;
 $8782 LD A,(HL)     ;
 $8783 AND $F8       ;
 $8785 LD (HL),A     ;
 $8786 INC HL        ;
 $8787 LD ($752B),HL ;
 $878A POP HL        ;
 $878B JR $8752      ; }
*$878D PUSH HL       ; {Next column: pointers + 11, DE + 64 (88 lines per
 $878E LD HL,($750B) ; column)
 $8791 LD BC,$000B   ;
 $8794 ADD HL,BC     ;
 $8795 LD ($750B),HL ;
 $8798 LD ($752B),HL ;
 $879B LD HL,($7509) ;
 $879E ADD HL,BC     ;
 $879F LD ($7509),HL ;
 $87A2 LD ($7529),HL ;
 $87A5 EX DE,HL      ;
 $87A6 LD BC,$0040   ;
 $87A9 ADD HL,BC     ;
 $87AA EX DE,HL      ;
 $87AB POP HL        ;
 $87AC LD A,($7512)  ;
 $87AF INC A         ;
 $87B0 LD ($7512),A  ;
 $87B3 CP $03        ;
 $87B5 JP NZ,$86E8   ;
 $87B8 RET           ; }

