                                    ; OFF_MAP ($754D) = $00
 $7616 DEFB $FF                     ; Per-life reset value ($FF = keep) of
                                    ; CYC_TICK ($754E) = $FF
 $7617 DEFB $FF                     ; Per-life reset value ($FF = keep) of
                                    ; CYC_LEG ($754F) = $FF
 $7618 DEFB $00                     ; Per-life reset value ($FF = keep) of
                                    ; CYC_DIST ($7550) = $00
