; Project the terrain and insert the sprite tiles
;
; Turns the flat map window built by #R$76D2 into the pseudo-3D view, in place
; in the 23x29 buffer at $F74E. Rows are processed from the top (far) to the
; bottom (near) - a painter's algorithm: each cell of code c becomes a
; 'pillar': pillar tile k (k=0,1,2...) is byte (P+k)*256+c and is written k
; rows above the cell; $FE = transparent (leave what is there), $FF = end of
; pillar. P = $63 in north view and $6C in south view (operands 7E35/7E41
; patched by 80F9). Nearer pillars overwrite farther ones.
; .
; Row 0 only gets its base tile. Rows 1-23 get full pillars. After row 15 the
; helicopter sprite tiles are inserted (7F21). Rows 24-28 (below the screen)
; only contribute the parts of tall pillars that reach the visible area: row
; 24+j draws only for codes >= $54, $80, $B2, $D0, $E4 (j=0..4), starting with
; pillar tile 3+j at row 21.
;
; .
;
; First the 9 raw codes of the 3x3 block under the helicopter are saved in
; #R$7A81.
c$7E10 LD HL,$F8B1   ; {Buffer column 10, row 15
 $7E13 LD DE,$7A81   ;
 $7E16 PUSH DE       ;
 $7E17 LD C,$03      ;
*$7E19 LD B,$03      ;
*$7E1B POP DE        ;
 $7E1C LD A,(HL)     ;
 $7E1D LD (DE),A     ;
 $7E1E INC DE        ;
 $7E1F PUSH DE       ; }
 $7E20 LD DE,$FFE9   ; {Up one row
 $7E23 ADD HL,DE     ;
 $7E24 DJNZ $7E1B    ; }
 $7E26 LD DE,$0046   ; {Next column, back to row 15
 $7E29 ADD HL,DE     ;
 $7E2A DEC C         ;
 $7E2B JR NZ,$7E19   ;
 $7E2D POP DE        ; }
 $7E2E LD HL,$F74E   ; {Row 0: base tile only
 $7E31 LD B,$17      ;
*$7E33 LD E,(HL)     ; }
 $7E34 LD D,$63      ; {Pillar page (operand patched: $63 north / $6C south)
 $7E36 LD A,(DE)     ;
 $7E37 LD (HL),A     ;
 $7E38 INC HL        ;
 $7E39 DJNZ $7E33    ; }
 $7E3B LD C,$17      ; {Rows 1..23
*$7E3D LD B,$17      ;
*$7E3F LD E,(HL)     ; }
 $7E40 LD D,$63      ; {Pillar page (operand patched)
 $7E42 PUSH BC       ;
 $7E43 PUSH HL       ;
 $7E44 LD BC,$FFE9   ; }
 $7E47 LD A,(DE)     ; Base tile
*$7E48 LD (HL),A     ; Write pillar tile
*$7E49 ADD HL,BC     ; {Up one row, next pillar level
 $7E4A INC D         ;
 $7E4B LD A,(DE)     ; }
 $7E4C CP $FE        ; {$FE: transparent; $FF: end
 $7E4E JR C,$7E48    ;
 $7E50 CP $FE        ;
 $7E52 JR Z,$7E49    ;
 $7E54 POP HL        ;
 $7E55 POP BC        ;
 $7E56 INC HL        ;
 $7E57 DJNZ $7E3F    ; }
 $7E59 LD A,C        ; {Row 15 finished: insert the sprite tiles
 $7E5A CP $09        ;
 $7E5C JP Z,$7F21    ;
 $7E5F DEC C         ;
 $7E60 JR NZ,$7E3D   ; }
 $7E62 LD B,$17      ; {Row 24: codes >= $54, pillar page P+3 (operand at
*$7E64 LD A,(HL)     ; 7E6D), from row 21
 $7E65 CP $54        ;
 $7E67 JR C,$7E85    ;
 $7E69 PUSH BC       ;
 $7E6A PUSH HL       ;
 $7E6B LD E,A        ;
 $7E6C LD D,$66      ;
 $7E6E LD BC,$FFBB   ;
 $7E71 ADD HL,BC     ;
 $7E72 LD BC,$FFE9   ;
 $7E75 JR $7E7A      ;
*$7E77 LD (HL),A     ;
*$7E78 INC D         ;
 $7E79 ADD HL,BC     ;
*$7E7A LD A,(DE)     ;
 $7E7B CP $FE        ;
 $7E7D JR C,$7E77    ;
 $7E7F CP $FE        ;
 $7E81 JR Z,$7E78    ;
 $7E83 POP HL        ;
 $7E84 POP BC        ;
*$7E85 INC HL        ;
 $7E86 DJNZ $7E64    ; }
 $7E88 LD B,$17      ; {Row 25: codes >= $80, page P+4 (operand 7E93)
*$7E8A LD A,(HL)     ;
