@start
@org
; Game start, per-level setup and main game loop
;
; Copied here from #R$F78A by #R$F74E (it lives in the printer buffer). Entered
; from the main menu (#R$E280) when "6" is pressed. Clears the screen, draws
; the HUD, updates the high score with the last game's score, zeroes the score
; and loads the 100 live game variables at $7500-$7563 from their initial
; values at $7564. #R$5B26 starts a level (also re-entered when a level is
; completed), #R$5B36 starts a life (also re-entered after a life is lost, from
; $92C5), and #R$5B3C is the free-running per-iteration loop (no HALT /
; interrupt sync: one iteration takes ~270000-390000 T-states, i.e. ~3.9-5.6 TV
; frames, ~9-13 iterations per second; all game timers count iterations).
@label=GameStart
c$5B00 CALL $84D6    ; Clear the screen (pixels 0, attributes 7)
 $5B03 CALL $8D0E    ; Clear/colour the 23x22 play area
 $5B06 CALL $84F4    ; Draw the HUD panel (right-hand 8 columns and bottom two
                     ; rows)
 $5B09 CALL $87BC    ; Hi-score := score if score > hi-score; print "H" line
 $5B0C LD B,$06      ; {Score digits 1-6 := '.' (displayed as blank leading
 $5B0E LD HL,$661E   ; digits)...
*$5B11 LD (HL),$2E   ;
 $5B13 INC HL        ;
 $5B14 DJNZ $5B11    ; }
 $5B16 LD (HL),$30   ; ...and the last digit := '0'
 $5B18 CALL $6F00    ; Print the score
 $5B1B LD HL,$7564   ; {Copy 100 initial values (#R$7564) to the live variables
 $5B1E LD DE,$7500   ; at $7500
 $5B21 LD BC,$0064   ;
 $5B24 LDIR          ; }
; Start of a level (first level, or after a level is completed).
@label=LevelStart
*$5B26 CALL $8321    ; Draw the 5 crate boxes; first level: randomise cyclone
                     ; start corner; next level: award crate bonus, speed up
                     ; the time bar; lives restored
 $5B29 CALL $843A    ; Fill the time bar (40 lines); 40 points for every line
                     ; still filled
 $5B2C CALL $FE92    ; Shuffle the 5 crates over 38 candidate map cells (FE92:
                     ; JP #R$5EEC)
 $5B2F CALL $6072    ; {Put a survivor (random variant) on each of 45 candidate
 $5B32 NOP           ; map cells
 $5B33 NOP           ;
 $5B34 NOP           ;
 $5B35 NOP           ; }
; Start of a life (also entered from $92C5 after a life has been lost).
@label=LifeStart
*$5B36 CALL $80F9    ; View := NORTH (tile set A), print "NORTH"
 $5B39 CALL $84AE    ; Clear the altimeter bar; altitude ($750D) := 8
; Main loop: one iteration per game "tick".
@label=MainLoop
*$5B3C CALL $76D2    ; Clear the view buffer at $F74E, fill it with map tile
                     ; codes, find the island under the helicopter ($7552)
 $5B3F CALL $87F0    ; Move the aircraft; set collision-warning bits in $7530
 $5B42 CALL $91B4    ; HUD: compass needle, speedometer, BEWARE AIRCRAFT
                     ; warning
 $5B45 CALL $8B91    ; Helicopter screen offset/drift ($7535/$7536; random
                     ; every 3rd call)
 $5B48 CALL $8CA0    ; Build the helicopter sprite (heading frame + rotor
                     ; frame) in #R$6950
 $5B4B CALL $7E10    ; Render terrain: tile codes -> character codes using the
                     ; tile column tables; save the 3x3 tiles under the
                     ; helicopter at $7A81
 $5B4E CALL $86AF    ; Overlay helicopter and shadow (dynamic glyphs)
 $5B51 CALL $F39A    ; Winch: pick up a crate or survivor under the helicopter
 $5B54 CALL $8A7A    ; Landing/collision test (sets $7505 crash, $7515 landed,
                     ; $752E on landing pad)
 $5B57 CALL $85D4    ; Further sprite/overlay compositing (dynamic glyphs from
                     ; $FD30)
 $5B5A LD A,($7505)  ; {Crashed ($7505=1)?
 $5B5D CP $01        ; }
 $5B5F JP Z,$9246    ; Yes: crash sequence, lose a life ($9246)
 $5B62 LD A,($7526)  ; {Map mode ($7526 bit 1)?
 $5B65 BIT 1,A       ;
 $5B67 JR Z,$5B86    ; }
 $5B69 CALL $8F12    ; Map shown: delay, blink map markers, move cyclone
                     ; ($8F12, falls into $9034)
 $5B6C LD A,($7526)  ; {Map just opened ($7526 bit 4)?
 $5B6F BIT 4,A       ;
 $5B71 JR Z,$5B8C    ; }
 $5B73 RES 4,A       ; {Yes: clear the flag...
 $5B75 LD ($7526),A  ; }
 $5B78 CALL $8D0E    ; ...clear the play area...
 $5B7B CALL $8D5D    ; ...draw the islands...
 $5B7E CALL $8E5C    ; ...draw the map frame and compass...
 $5B81 CALL $8F6A    ; {...draw markers/labels
 $5B84 JR $5B8C      ; }
*$5B86 CALL $762C    ; No map: copy the view buffer to the screen
 $5B89 CALL $9034    ; Move the cyclone; set the cyclone proximity $7550 and
                     ; WIND FORCE bar
*$5B8C CALL $7FD6    ; Read the selected controller into the control word $7522
 $5B8F LD A,($7550)  ; Cyclone proximity ($7550, 0=on top of it ... 15=far)
 $5B92 CP $05        ; The operand of this CP (address $5B93) is modified: 5 on
                     ; level 1 (#R$836D), 6 on later levels (#R$83AA)
 $5B94 CALL C,$7378  ; Close to the cyclone: randomly perturb the control word
                     ; (turbulence)
 $5B97 LD A,($7515)  ; {Landed ($7515=1)...
 $5B9A CP $01        ;
 $5B9C JR NZ,$5BAC   ; }
 $5B9E LD A,($7516)  ; {...and out of fuel ($7516=1)...
 $5BA1 CP $01        ;
 $5BA3 JR NZ,$5BAC   ; }
 $5BA5 LD A,($752E)  ; {...and not on a landing pad ($752E=0)?
 $5BA8 CP $00        ; }
 $5BAA JR Z,$5BEC    ; Yes: "NO FUEL" - lose a life
*$5BAC CALL $80AA    ; Handle the M (map) and N (view) keys, then apply the
                     ; control word: heading, speed, altitude
 $5BAF LD A,($7554)  ; {5 crates collected ($7554)...
 $5BB2 CP $05        ;
 $5BB4 JR NZ,$5BCC   ; }
 $5BB6 LD A,($752E)  ; {...and on a landing pad ($752E=1)...
 $5BB9 CP $01        ;
 $5BBB JR NZ,$5BCC   ; }
 $5BBD LD A,($7552)  ; {...on the island record at $F294 (BASE)?
 $5BC0 CP $94        ;
 $5BC2 JR NZ,$5BCC   ;
 $5BC4 LD A,($7553)  ;
 $5BC7 CP $F2        ; }
 $5BC9 JP Z,$5B26    ; Yes: level complete, start the next level
*$5BCC LD A,($751C)  ; {Time bar pointer ($751C) moved past the last line?
 $5BCF CP $DE        ; }
 $5BD1 JP Z,$92C8    ; Yes: "NO TIME" - game over
 $5BD4 CALL $8470    ; On a landing pad: refuel 1 line per iteration; else burn
                     ; fuel (1 line per 49 iterations)
 $5BD7 CALL $8284    ; Time bar: lose 1 line every N iterations (N = operand at
                     ; $828C: 255, then -15 per level)
 $5BDA CALL $F34A    ; Animate the two survivor glyphs (chars $31 and $32)
 $5BDD LD A,$FD      ; {Read keyboard half-row A-S-D-F-G
 $5BDF IN A,($FE)    ; }
 $5BE1 AND $11       ; Unless A and G are both held...
 $5BE3 JP NZ,$5B3C   ; {...loop
 $5BE6 NOP           ;
 $5BE7 NOP           ;
 $5BE8 NOP           ; }
 $5BE9 JP $E280      ; A+G held: abandon the game, back to the main menu
*$5BEC LD HL,$5BF2   ; "NO FUEL" message...
 $5BEF JP $92D0      ; ...print it at row 3, lose a life ($92D0, shared with
                     ; "NO TIME")

; Message: " NO FUEL "
t$5BF2 DEFM " NO FUEL "         ; Printed by $92D0 (9 characters at row 3,
                                ; column 7)
 $5BFB DEFB $00,$00,$00,$00,$00 ; Unused (copied with the routine)

