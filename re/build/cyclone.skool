 $5CB0 DEFB $00,$00,$DB,$5F,$FF,$FF,$F4,$09,$A8,$10,$4B,$F4,$09,$C4,$15,$53
 $5CC0 DEFB $81,$0F,$C4,$15,$52,$F4,$09,$C4,$15,$50,$80,$00,$0A,$48,$00,$E7
 $5CD0 DEFB $C3,$A7,$3A,$D9,$C3,$A7,$3A,$DA,$C3,$A7,$3A,$FD,$B0,$22,$32,$34
 $5CE0 DEFB $35,$33,$39,$22,$3A,$EF,$22,$43,$79,$63,$6C,$6F,$6E,$65,$32,$22
 $5CF0 DEFB $AA,$3A,$EF,$22,$43,$79,$63,$6C,$6F,$6E,$65,$34,$22,$AF,$3A,$EF
 $5D00 DEFB $22,$43,$79,$63,$6C,$6F,$6E,$65,$33,$22,$AF,$3A,$F9,$C0,$B0,$22
 $5D10 DEFB $36,$35,$31,$37,$36,$22,$0D,$80,$EF,$22,$22,$0D,$80,$36,$35,$31
