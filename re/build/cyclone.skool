; Update and print the high score
;
; Compares the 7-character score at 661E with the high score at 6627 (ASCII
; digits, leading '.' which sorts below '0'). If the score is higher it is
; copied over the high score. Then prints the high score right-to-left on the H
; line (row 20, ending at column 31) via 6F06. Called at the start of each game
; (5B09, before the score is cleared) and from E3EA.
c$87BC LD HL,$661E   ; {Compare digit by digit from the left
 $87BF LD DE,$6627   ;
 $87C2 LD B,$07      ;
*$87C4 PUSH BC       ;
 $87C5 LD A,(DE)     ;
 $87C6 LD B,A        ;
 $87C7 INC DE        ;
 $87C8 LD A,(HL)     ;
 $87C9 INC HL        ;
 $87CA CP B          ;
 $87CB JR NZ,$87D2   ;
 $87CD POP BC        ;
 $87CE DJNZ $87C4    ;
 $87D0 JR $87E4      ; }
*$87D2 CP B          ; {First different digit: score lower? Then keep the old
 $87D3 JR NC,$87D8   ; high score
 $87D5 POP BC        ;
 $87D6 JR $87E4      ;
*$87D8 POP BC        ; }
 $87D9 LD HL,$661E   ; {Score higher: high score = score
 $87DC LD DE,$6627   ;
 $87DF LD BC,$0007   ;
 $87E2 LDIR          ; }
*$87E4 LD DE,$509F   ; {Print the high score at $509F (row 20, column 31)
 $87E7 LD BC,$662D   ; leftwards from 662D
 $87EA JP $6F06      ; }

