; Add 40 points to the score
;
; Used by #R$843A (time bonus).
@label=AddScore40
c$6600 LD B,$28      ;

; Add B points to the score
;
; The score is the 7-character string at #R$661E ('.' = blank leading digit).
; Adds 1 to the last digit B times with decimal carry (B=0 adds 256), then
; prints it via #R$6F00. On exit B=$66 (left over from #R$6F00), which #R$83A5
; relies on by accident.
;
; B Number of points to add
@label=AddScore
c$6602 LD HL,$6624   ; {Last digit
*$6605 LD A,(HL)     ; }
 $6606 CP $2E        ; {A blank leading digit counts as '0'
 $6608 JR NZ,$660C   ;
 $660A LD A,$30      ;
*$660C INC A         ; }
 $660D CP $3A        ; {Carry?
 $660F JR NZ,$6616   ; }
 $6611 LD (HL),$30   ; {Yes: digit := '0', move one digit left
 $6613 DEC HL        ;
 $6614 JR $6605      ;
*$6616 LD (HL),A     ;
 $6617 DJNZ $6602    ; }
 $6619 JP $6F00      ; Print the score

; Score and high-score strings
;
; Printed right-to-left (#R$6F00, #R$87BC) at row 19 (score) and row 20 (high
; score), column 31 backwards. Leading blank digits are '.'. The high score
; starts at 0 and is only updated by #R$87BC (at the next game start or on the
; info screen).
t$661C DEFB $FF       ; Terminator for the right-to-left print
 $661D DEFM "S"       ; "S" label
 $661E DEFM "......0" ; Score (7 digits)
 $6625 DEFB $FF       ; Terminator
 $6626 DEFM "H"       ; "H" label
 $6627 DEFM "......0" ; High score (7 digits)
 $662E DEFB $FF

